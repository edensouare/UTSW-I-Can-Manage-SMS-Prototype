@@ -0,0 +1 @@
+[{"id": "01-01-01", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 1, "text": "Introduction to Head and Neck Cancer", "image": "/media/01-01-01.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-02", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 2, "text": "Content\n\nWhat is What is Locations Types of\ncancer? head and of head head and\n neck and neck neck\n cancer? cancer cancer", "image": "/media/01-01-02.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-03", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 3, "text": "What is cancer?", "image": "/media/01-01-03.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-04", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 4, "text": "I Can Manage Cancer\n\n\n\nWhat is cancer?\nCancer happens when certain cells in the body grow out of control.", "image": "/media/01-01-04.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-05", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 5, "text": "What is cancer?\nNormally, our bodies have signals that tell\ncells when to stop growing, but cancer\ncells ignore these signals.\n\nThey keep multiplying and can form\nlumps called tumors in different parts of\nthe body or they replace the healthy cells\nin bone marrow and blood.\n\nThese cells can directly spread into, or\ninvade, surrounding tissues, spread to\nlymph nodes, or spread to other organs in\nthe body, like the lung.", "image": "/media/01-01-05.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-06", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 6, "text": "What is head and neck\n cancer?", "image": "/media/01-01-06.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-07", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 7, "text": "What is head and neck\ncancer?\nMost head and neck cancer start in the\nlining of the mouth or throat, which is\ncalled the “mucosa.”\n\nCancers that start in the saliva glands\nare also considered head and neck\ncancers.", "image": "/media/01-01-07.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-08", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 8, "text": "Locations of Head and Neck\nCancer\nThey are classiﬁed based on their location.\n\n 1 Oral cavity (mouth)\n\n 2 Pharynx (throat)\n\n 3 Larynx (voice box)\n\n 4 Paranasal sinuses and nasal cavity\n\n 5 Salivary glands (not shown in the\n image)", "image": "/media/01-01-08.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-09", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 9, "text": "Other types of cancers\nlocated in the head and neck\nSome cancers that start in the head and\nneck and are not labeled as head and neck\ncancers. These include:\n ● Sarcomas\n ● Thyroid cancer\n ● Melanoma\n ● Non-melanoma skin cancers\n\nHowever, the primary focus will be on\naerodigestive head and neck cancers,\nwhich arise from the lining of the upper\ndigestive tract.", "image": "/media/01-01-09.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-10", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 10, "text": "Types of Head and Neck\n Cancer", "image": "/media/01-01-10.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-11", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 11, "text": "What is the most common type\nof head and neck cancer?\nThe most common type of head and neck\ncancer is mucosal squamous cell\ncarcinoma.\n\nThis cancer begins in squamous cells,\nwhich are tiny ﬂat cells that cover and\nprotect your mouth, throat, and voicebox.\n\nIt is important to know that squamous\ncells also cover many other parts of you\nbody, like your skin and lungs. If cancer\nstarts from these cells, this is not\nconsidered head and neck cancer.", "image": "/media/01-01-11.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-12", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 12, "text": "What are the other types of\nhead and neck cancer?\nSalivary gland carcinomas are the other\nmajor type of head and neck cancer.\nThese can start in any of the 3 major pairs\nsalivary glands, which make saliva and\nrelease it into the mouth.\n\nSalivary gland cancers can also start from\nminor salivary glands, which line your\nmouth, throat, and voicebox.", "image": "/media/01-01-12.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-13", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 13, "text": "There are 3 major salivary glands that\nrelease saliva into the mouth.\n\n 1 Parotid glands\n\n 2 Submandibular glands\n\n 3 Sublingual glands", "image": "/media/01-01-13.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-01-14", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 14, "text": "References:\nTo learn more about head and neck cancer and head and neck cancer types,\nplease visit the following webpages, which are hosted by the National Cancer\nInstitute and the American Cancer Society.\n\nhttps://www.cancer.gov/types/head-and-neck/head-neck-fact-sheet\n\nhttps://www.cancer.org/cancer/understanding-cancer/what-is-cancer.html", "image": "/media/01-01-14.jpg", "url": "https://docs.google.com/presentation/d/1XlhUm9gx5JA71mYlZGmdM9M5UyxqlCI78XHO3ETY2Eg/view", "draft": false}, {"id": "01-02-01", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 1, "text": "Head and Neck Cancer Risk Factors", "image": "/media/01-02-01.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-02", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 2, "text": "Head and Neck Cancer Risk Factors\n\n Common Less\nTitle of Section Causes of Common\n Head and Causes of\n Neck Head and\n Cancer Neck\n Cancer", "image": "/media/01-02-02.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-03", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 3, "text": "Common Causes of Head and\nNeck Cancer\n1 Tobacco\n\n2 Alcohol\n\n3 Human Papillomavirus (HPV)", "image": "/media/01-02-03.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-04", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 4, "text": "Common Causes of Head and Neck\nCancer- Chemical Carcinogens\n 1 Tobacco\nThere are many different forms of tobacco.\nCigarettes, cigars, pipes, and smokeless\ntobacco are just a few\n\nTobacco is the single most important risk\nfactor for cancer. It is linked to 70% of head\nand neck cancer diagnosis.", "image": "/media/01-02-04.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-05", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 5, "text": "Common Causes of Head and Neck\nCancer- Chemical Carcinogens\n 2 Alcohol\nThere is no safe dose of alcohol. However,\ndrinking alcohol heavily (more than 14\ndrinks per week) is linked to an increased\nrisk of head and neck cancer, especially\nwhen patients smoke and drink heavily.", "image": "/media/01-02-05.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-06", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 6, "text": "Common Causes of Head and Neck Cancer- Human\n I Can Manage Cancer\n\n\n\n\nPapillomavirus (HPV)\nHPV is a common sexually transmitted disease. Approximately 80-90% of\nadults in the United States will have an HPV infection at some point in\ntheir lifetime.", "image": "/media/01-02-06.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-07", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 7, "text": "Common Causes of Head and Neck Cancer- Human\n I Can Manage Cancer\n\n\n\n\nPapillomavirus (HPV)\nThere are different types of HPV. Some types, such as HPV 6 and HPV 11, cause\nbenign diseases like warts.\nOther types, like HPV 16, cause cancer. There are 14 different types of HPV\nwhich cause cancer. HPV 16 is the most common cause of HPV-related head\nand neck cancer in the United States.", "image": "/media/01-02-07.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-08", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 8, "text": "Less Common Causes of Head\nand Neck Cancer\n\n 1 Chronic Trauma\n\n 2 Chronic Inﬂammatory Disorders\n\n 3 Genetic Predisposition", "image": "/media/01-02-08.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-09", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 9, "text": "Less Common Causes of Head\nand Neck Cancer\n 1 Chronic Trauma\nRepeated irritation or trauma from a sharp or\nbroken tooth, dentures, or constant biting of\nlip/cheek can cause chronic inﬂammation,\nwhich can lead to cancer.", "image": "/media/01-02-09.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-10", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 10, "text": "Less Common/Rare Causes of\nHead and Neck Cancer\n 2 Chronic Inﬂammatory Disorders\nOral lichen planus is a common oral\ninﬂammatory disorder which can lead to\ncancer. Oral lichen planus is a condition\nwhere the body’s own immune system\nattacks lining of the mouth, causing white\npatches, redness, or sores.\n\nCareful monitoring is recommended in those\naffected.", "image": "/media/01-02-10.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-11", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 11, "text": "Less Common/Rare Causes of\nHead and Neck Cancer\n 3 Genetic Predisposition\nThere are several genetic disorders which\nare linked to an increased risk for head and\nneck cancer. Some of the more common\ndisorders include:\n\n● Li-Fraumeni Syndrome\n● Fanconi anemia\n● Dyskeratosis congenita", "image": "/media/01-02-11.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-12", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 12, "text": "Causes of Head and Neck Cancer\n I Can Manage Cancer\n\n\n\n\nIf you do not have any of the common risk factors, genetic work up may be\nhelpful. You may be referred for genetics counseling, if a genetic\npredisposition is found.\n\n\nSpeak to your doctor if you have any conditions discussed in this module.\n\n\nIf a patient does not have any of the discussed conditions, their cancer may\ncome from an unknown source.", "image": "/media/01-02-12.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-02-13", "module": 1, "deck": "Head and Neck Cancer Risk Factors", "page": 13, "text": "References\n\nTo learn more about the biopsy and staging, please visit the following webpages,\nwhich are hosted by the National Cancer Institute and the American Cancer\nSociety.\n\nhttps://www.cancer.gov/\nhttps://www.cdc.gov/\nhttps://rarediseases.info.nih.gov/\nhttps://www.cancer.org/", "image": "/media/01-02-13.jpg", "url": "https://docs.google.com/presentation/d/12xMtyuW79rOazBE5741zfUR7v3e_3kDXVQ6F8SO_bAo/view", "draft": false}, {"id": "01-03-01", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 1, "text": "How is Cancer Diagnosed and Staged", "image": "/media/01-03-01.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-02", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 2, "text": "Title of Section\n\n Biopsies Cancer\nTitle of Section\n Staging\n and\n Prognosis", "image": "/media/01-03-02.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-03", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 3, "text": "I Can Manage Cancer\n\nBiopsy\nA biopsy is the gold standard for diagnosing cancer. It involves\nremoving a small sample of tissue, which is then examined under a\nmicroscope to determine whether cancer cells are present.", "image": "/media/01-03-03.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-04", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 4, "text": "Types of Biopsy Techniques\n 1 Direct tumor biopsy\nTissue is obtained directly from the\nprimary tumor, often using cup forceps or\npunch biopsy.\n\n 2 Needle biopsy of lymph nodes\n\nIf a deeper tumor or a suspicious lymph\nnode in the neck is detected, a ﬁne needle\naspiration or core needle biopsy can be\nperformed. These are often performed\nwith an ultrasound to ensure accuracy.", "image": "/media/01-03-04.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-05", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 5, "text": "Types of Biopsy Techniques\n\nBiopsies are important not only for\nconﬁrming the presence of cancer but\nalso for identifying the type of cancer\nand testing for human papillomavirus\n(HPV), which can affect the treatment\nplan.", "image": "/media/01-03-05.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-06", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 6, "text": "What happens after\n diagnosis?", "image": "/media/01-03-06.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-07", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 7, "text": "Cancer Staging\n\nOnce a diagnosis is made, your doctors\nwill need to determine:\n\n● The size and location of the tumor\n● The extent of local tissue invasion\n● Whether lymph nodes are involved\n● Whether the cancer has spread\n (metastasized) to other sites\n\nThis process is called staging.", "image": "/media/01-03-07.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-08", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 8, "text": "Cancer Staging\nThe following are some commonly used\nimaging tests. Each test has unique\nadvantages over other tests.\n\n● Ultrasound\n● CT scan\n● MRI\n● PET-CT\n\nYour oncology team will choose the best\ntest or tests for you.", "image": "/media/01-03-08.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-09", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 9, "text": "What does the cancer stage\nmean?\nStaging follows the TNM classiﬁcation\nsystem:\n\n● T (Tumor): How big is the tumor?\n Where is it?\n● N (Nodes): Has it spread to lymph\n nodes?\n● M (Metastasis): Has it spread to\n other parts of the body?", "image": "/media/01-03-09.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-10", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 10, "text": "What does the cancer stage\nmean?\nBased on the TNM ﬁndings, the cancer\nis then assigned an overall stage:\n\n● Stage 1-2: Early stage - Usually\n smaller tumors, may not have\n spread.\n● Stage 3-4: Advanced stage -\n Usually larger, there may be nodal\n involvement or distant metastases.", "image": "/media/01-03-10.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-11", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 11, "text": "Staging is Important because\nit Guides Treatment Strategy\nEarly stages (1-2) may only require one\ntype of treatment (e.g., surgery or\nradiation alone).\n\nAdvanced stages (3-4) usually require\nmore than one type of cancer treatment\n(e.g., surgery followed by radiation or\nradiation with chemotherapy).\n\nRefer to module 4 for more information\nabout surgery and module 9 for\nradiation.", "image": "/media/01-03-11.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-12", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 12, "text": "Staging is Important because\nit Helps Predict Prognosis\nEarly-stage cancers tend to have higher\nremission rates.\n\nAdvanced-stage cancers may have a\nless favorable outlook, but prognosis\nvaries based on several factors.\n\nAsk your oncology team about your\nprognosis.", "image": "/media/01-03-12.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-03-13", "module": 1, "deck": "How is Cancer Diagnosed?", "page": 13, "text": "References\nTo learn more about the biopsy and staging, please visit the following webpages,\nwhich are hosted by the National Cancer Institute and the American Cancer\nSociety.\nhttps://www.cancer.gov/types/head-and-neck/patient/oral-screening-pdq\nhttps://www.cancer.gov/about-cancer/diagnosis-staging/staging\nhttps://www.cancer.gov/about-cancer/diagnosis-staging/diagnosis", "image": "/media/01-03-13.jpg", "url": "https://docs.google.com/presentation/d/1RYwwVy1Wn7t2YDuzT1l3fMOBg53lBPUIrNI75lZLjg4/view", "draft": false}, {"id": "01-04-01", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 1, "text": "Introduction to Head and Neck Cancer", "image": "/media/01-04-01.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-02", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 2, "text": "Content\n\nWhat is What is Locations Types of\ncancer? head and of Head Head and\n neck and Neck Neck\n cancer? Cancer Cancer", "image": "/media/01-04-02.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-03", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 3, "text": "What is cancer?", "image": "/media/01-04-03.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-04", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 4, "text": "I Can Manage Cancer\n\n\n\nWhat is cancer?\nCancer happens when certain cells in the body grow out of control.", "image": "/media/01-04-04.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-05", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 5, "text": "What is cancer?\nNormally, our bodies have signals that tell\ncells when to stop growing, but cancer\ncells ignore these signals.\n\nThey keep multiplying and can form\nlumps called tumors in different parts of\nthe body or they replace the healthy cells\nin bone marrow and blood.\n\nThese cells can directly spread into, or\ninvade, surrounding tissues, spread to\nlymph nodes, or spread to other organs in\nthe body, like the lung.", "image": "/media/01-04-05.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-06", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 6, "text": "What is head and neck\n cancer?", "image": "/media/01-04-06.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-07", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 7, "text": "What is head and neck\ncancer?\nMost head and neck cancer start in the\nlining of the mouth or throat, which is\ncalled the “mucosa.”\n\nCancers that start in the saliva glands\nare also considered head and neck\ncancers.", "image": "/media/01-04-07.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-08", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 8, "text": "Locations of Head and Neck\nCancer\nThey are classiﬁed based on their location.\n\n 1 Oral cavity (mouth)\n\n 2 Pharynx (throat)\n\n 3 Larynx (voice box)\n\n 4 Paranasal sinuses and nasal cavity\n\n 5 5 Salivary glands (not shown in the\n image)", "image": "/media/01-04-08.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-09", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 9, "text": "What is not head and neck\ncancer?\nSome cancers that start in the head and\nneck and are not labeled as head and neck\ncancers. These include:\n ● Sarcomas\n ● Thyroid cancer\n ● Melanoma\n ● Non-melanoma skin cancers\n\nTreatments for these cancers may be\nsimilar to those for head and neck cancer,\nbut may also be different.", "image": "/media/01-04-09.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-10", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 10, "text": "Types of Head and Neck\n Cancer", "image": "/media/01-04-10.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-11", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 11, "text": "What is the most common type\nof head and neck cancer?\nThe most common type of head and neck\ncancer is mucosal squamous cell\ncarcinoma.\n\nThis cancer begins in squamous cells,\nwhich are tiny ﬂat cells that cover and\nprotect your mouth, throat, and voicebox.\n\nIt is important to know that squamous\ncells also cover many other parts of you\nbody, like your skin and lungs. If cancer\nstarts from these cells, this is not\nconsidered head and neck cancer.", "image": "/media/01-04-11.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-12", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 12, "text": "What are the other types of\nhead and neck cancer?\nSalivary gland carcinomas are the other\nmajor type of head and neck cancer.\nThese can start in any of the 3 major\nsalivary glands, which make saliva and\nrelease it into the mouth.\n\nSalivary gland cancers can also start from\nminor salivary glands, which line your\nmouth, throat, and voicebox.", "image": "/media/01-04-12.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-13", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 13, "text": "What are the other types of\nhead and neck cancer?\nThere are 3 major salivary glands that\nrelease saliva into the mouth.\n\n 1 Parotid glands\n\n 2 Submandibular glands\n\n 3 Sublingual glands", "image": "/media/01-04-13.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "01-04-14", "module": 1, "deck": "Introduction to Head and Neck Cancer", "page": 14, "text": "References:\nTo learn more about the biopsy and staging, please visit the following webpages,\nwhich are hosted by the National Cancer Institute and the American Cancer\nSociety.\n\nhttps://www.cancer.gov/types/head-and-neck/head-neck-fact-sheet\n\nhttps://www.cancer.org/cancer/understanding-cancer/what-is-cancer.html", "image": "/media/01-04-14.jpg", "url": "https://docs.google.com/presentation/d/1jOwPzQQqIma9ldKRmPvx-t92_76W8KjPVuduB4PRrh4/view", "draft": false}, {"id": "02-01-01", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 1, "text": "Introduction to Curative Treatment\nApproaches", "image": "/media/02-01-01.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-02", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 2, "text": "Curative Head and Neck Cancer Treatments:\nOverview\n\n\n Medication\n Surgery Radiation Followed by\n Surgery or\n Radiation", "image": "/media/02-01-02.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-03", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 3, "text": "I Can Manage Cancer\n\n\nTreatments Aimed at Cure\nThe main goal of curative treatment is to eliminate the cancer and\nprevent it from coming back. Surgery and radiation are the two types of\ntreatment that are known to cure head and neck cancers. Depending on\nthe stage, location, and overall health of the patient, different\ncombinations of treatments may be used.", "image": "/media/02-01-03.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-04", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 4, "text": "Surgery\nSurgery is one of the main treatment\napproaches for head and neck cancers.\n\nIt can treat cancers involving the mouth,\nthroat, voice box, nose or sinonasal\ncavities, and saliva glands. It is rarely used\nto treat cancers of the throat behind the\nnose (nasopharynx).\n\nSurgery is often the preferred treatment\noption for cancers involving the mouth, or\noral cavity, and the saliva glands.", "image": "/media/02-01-04.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-05", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 5, "text": "Surgery\nDepending on the risk of recurrence,\npatients may need radiation and/or\nchemotherapy after surgery.\n\nThe risk of recurrence depends on the\nfeatures and behavior of the tumor.\nOftentimes, these are only fully\nunderstood after the tumor is removed.\n\nWe discuss this topic in depth in Module 9,\nwhich is titled “Postoperative Radiation\nand Chemotherapy.”", "image": "/media/02-01-05.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-06", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 6, "text": "Radiation\nRadiation is the other major\ntreatment for head and neck cancers.\n\nLike surgery, it can treat cancers\ninvolving the front of mouth, throat,\nvoice box, nose or sinonasal cavities,\nand saliva glands. It is not commonly\nused as the ﬁrst step of treatment for\ncancers involving the front of mouth,\nor oral cavity, and saliva glands.", "image": "/media/02-01-06.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-07", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 7, "text": "Radiation\nRadiation is often preferred for\ncancers involving the back of the\nthroat behind the mouth, or\noropharynx, the back of the throat\nbehind the nose, or nasopharynx,\nand voice box, or larynx.\n\nIt is also commonly used for cancers\nthat are very large, difﬁcult to access,\nor where surgery may cause\nmeaningful loss of function, such as\na reduced ability to speak or\nswallow.", "image": "/media/02-01-07.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-08", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 8, "text": "Chemotherapy\nChemotherapy is often added to increase\nthe effectiveness of radiation. Adding\nchemotherapy is a complex decision that\ndepends on many factors including:\n - The tumor size and extent of local\n tumor spread\n - Lymph node involvement, the size of\n the lymph nodes, and whether tumor\n has spilled out of the lymph node into\n the surrounding tissues\n - The overall health of the patient and\n the patient’s ability to handle the side\n effects of chemotherapy", "image": "/media/02-01-08.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-09", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 9, "text": "Chemotherapy\nYour cancer treatment team will discuss\nyour case together and determine\nwhether you would beneﬁt from\ntreatment with chemotherapy.\n\nChemotherapy is usually delivered\nweekly, or every three weeks, during\nradiation.\n\nIt is important to know that chemotherapy\nalone does not cure head and neck\ncancer.", "image": "/media/02-01-09.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-10", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 10, "text": "Medication Followed by Surgery\nor Radiation\nIn some uncommon situations, systemic\ntherapy is given before surgery or\nradiation. Systemic therapies include\nimmunotherapy, chemotherapy, and\ntargeted biologic therapy. This is called a\n“neoadjuvant” approach to treatment.\n\nSystemic therapy is also given after\nsurgery or radiation. This is called\n“adjuvant” treatment.", "image": "/media/02-01-10.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-11", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 11, "text": "Medication Followed by Surgery\nor Radiation\nGenerally speaking, the goal of this\napproach is to shrink the tumor before\nsurgery or radiation. Shrinking the tumor\nmay make it easier to completely remove\nor treat.", "image": "/media/02-01-11.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-12", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 12, "text": "Medication Followed by Surgery\nor Radiation\nMost commonly, these medications are\ngiven intravenously, or into the blood\nthrough needles in the veins, every 1-3\nweeks.\n\nThe length of treatment with medications\nbefore surgery or radiation is commonly\n6-12 weeks, but in some scenarios, may\nlast many months.", "image": "/media/02-01-12.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-01-13", "module": 2, "deck": "Introduction to Curative Treatment Approaches", "page": 13, "text": "References\nTo learn more about head and neck cancer treatment and the types of cancer treatment,\nplease visit the following webpages, which are hosted by the National Cancer Institute\nand the American Cancer Society.\nhttps://www.cancer.gov/types/head-and-neck/patient/adult\nhttps://www.cancer.org/cancer/types/head-neck-cancer.html\nhttps://www.cancer.gov/about-cancer/treatment/types\nhttps://www.cancer.org/cancer/managing-cancer/treatment-types.html", "image": "/media/02-01-13.jpg", "url": "https://docs.google.com/presentation/d/15HdUKlDazNpZeE9e1aMnHcDXoE2cdrpqyQQHvDGP6g0/view", "draft": false}, {"id": "02-02-01", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 1, "text": "Introduction to Different Palliative\nTreatments", "image": "/media/02-02-01.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-02", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 2, "text": "Sections in this Module\n\n Introduction to Forms of\n palliative Overview of\n palliative\n cancer supportive care\n cancer therapy\n treatment\n\n\n Click on the box to jump to each section", "image": "/media/02-02-02.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-03", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 3, "text": "Introduction to palliative cancer\n treatment", "image": "/media/02-02-03.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-04", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 4, "text": "Palliative Cancer Treatment: Why? I Can Manage Cancer\n\n\n\n\nSometimes head and neck cancer spreads too far or a patient’s health\nprevents doctors from offering aggressive cancer treatment.\nWhen head and neck cancer cannot be cured with surgery or\nradiation, doctors may recommend palliative cancer treatment.", "image": "/media/02-02-04.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-05", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 5, "text": "Palliative Cancer Treatment: Why? I Can Manage Cancer\n\n\n\n\nWith palliative cancer treatment, doctors focus on controlling\nsymptoms and improving quality of life.\nIt is important to know that while we don’t expect palliative treatment\nto be curative, in some circumstances, it may prolong survival or\nprovide long-term disease control.", "image": "/media/02-02-05.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-06", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 6, "text": "Palliative Cancer Treatment: What is It? I Can Manage Cancer\n\n\n\n\nThere are several different types of palliative cancer treatment:\n - Medication, or palliative systemic therapy\n - Palliative radiation therapy\n - Palliative surgery\n - Best supportive care\n - Hospice", "image": "/media/02-02-06.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-07", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 7, "text": "Forms of palliative cancer therapy", "image": "/media/02-02-07.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-08", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 8, "text": "Palliative Systemic Therapy\nPalliative systemic therapy is the most\ncommon type of palliative cancer\ntreatment. It involves chemotherapy,\ntargeted therapy, or immunotherapy.\n\nIt is used when cancers are very advanced\nin the head and neck, when the cancer has\nspread to other organs, or when surgery or\nradiation are unlikely to be curative.\n\nThe choice of drugs and intensity depends\non the patient’s symptoms, tumor, and\noverall health.", "image": "/media/02-02-08.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-09", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 9, "text": "Palliative Systemic Therapy\nTreatment with palliative systemic therapy\ntraditionally means the cancer is incurable.\n\nHowever, newer treatments such as\nimmunotherapy can sometimes make the\ncancer disappear completely, for years or\nmore.", "image": "/media/02-02-09.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-10", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 10, "text": "Palliative Radiation Therapy\nPalliative radiation aims to temporarily\nshrink the cancer. It also aims to reduce\nsymptoms from the cancer, such as pain.\n\nThere are a number of different ways\npalliative radiation can be delivered.\n\nIt is often a short course of treatment; most\ncommonly completed in 1-2 weeks of daily\ntreatment.", "image": "/media/02-02-10.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-11", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 11, "text": "Palliative Surgery\nPalliative surgery is a less common\ntreatment option for head and neck\ncancers. It shares the same goals of other\npalliative treatment options: to reduce\nsymptoms from the cancer and improve\nquality of life.", "image": "/media/02-02-11.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-12", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 12, "text": "Overview of supportive care", "image": "/media/02-02-12.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-13", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 13, "text": "Best Supportive Care\nBest supportive care aims to prevent and\naddress the symptoms and side effects of\nhead and neck cancer and improve quality of\nlife. Unlike palliative systemic therapy,\nradiation, and surgery, best supportive care\ndoes not directly treat the cancer.\n\nSupportive care can include pain\nmanagement, mental health support,\nnutrition, respiratory support with oxygen,\nswallow and speech support.\n\nThe palliative care team can help with\nsymptoms.", "image": "/media/02-02-13.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-14", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 14, "text": "Hospice\nHospice care also aims to treat the\nsymptoms and side effects of head and\nneck cancer and improve quality of life.\n\nUsually, your doctors will only recommend\nhospice when you are expected to live for\na short period.\n\nHospice care can be given at home or in a\nfacility.", "image": "/media/02-02-14.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "02-02-15", "module": 2, "deck": "Introduction to Different Palliative Treatments", "page": 15, "text": "References\nTo learn more about palliative cancer treatment, please visit the following\nwebpages, which are hosted by the National Cancer Institute and the American\nCancer Society.\nhttps://www.cancer.gov/about-cancer/treatment/types\nhttps://www.cancer.org/cancer/managing-cancer/treatment-types.html", "image": "/media/02-02-15.jpg", "url": "https://docs.google.com/presentation/d/1bGPtULldsPURzChKYp_BxyMPLr7g5TWSF7i7frgpRKY/view", "draft": false}, {"id": "03-01-01", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 1, "text": "Introduction to your Cancer\nTeam", "image": "/media/03-01-01.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-02", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 2, "text": "Surgical oncologist\nA surgical oncologist is a surgeon who diagnoses and\nsurgically treats your cancer.\n\nSurgical oncologists:\n\n● Take biopsies to help diagnose cancer\n● Discuss potential surgical treatments\n● Explain the beneﬁts and risks of potential\n surgical treatment\n● Explain to you how to prepare for surgery\n● Discuss with you what to expect after surgery\n● Oversee your recovery from surgery", "image": "/media/03-01-02.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-03", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 3, "text": "Medical oncologist\nAn oncologist is a cancer doctor that specializes in\ndiagnosing and treating cancer with medications\nlike chemotherapy, immunotherapy, targeted\ntherapy, or hormone therapy.\n\nMedical oncologists:\n\n● Plan and discuss with you treatment options\n● Help you understand the risks and beneﬁts of\n each treatment option\n● Oversee your cancer treatment\n● Help manage any side effects from and after\n your treatment", "image": "/media/03-01-03.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-04", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 4, "text": "Radiation oncologist\nRadiation oncologists are doctors that treat\ncancer with radiation therapy.\n\nRadiation oncologists:\n\n● Help decide if you would beneﬁt from\n radiation therapy and if so which kind\n● Explain to you your radiation therapy\n options and how it works\n● Design and discuss with you your\n treatment plan\n● Oversee treatment and help you to manage\n radiation therapy side effects", "image": "/media/03-01-04.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-05", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 5, "text": "Speech and language pathologist (SLP)\nSpeech and language pathologists help with cancer and\ntreatment effects on your voice, swallowing, and\ncommunication skills.\n\nSpeech and language pathologists will meet with you\nbefore, during, and after treatment to:\n\n● Evaluate and treat swallowing difﬁculties\n● Support communication after surgeries or treatment\n affecting the mouth and throat\n● Teach you safe eating and drinking strategies\n● Create a personalized plan to meet your\n communication and swallowing goals", "image": "/media/03-01-05.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-06", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 6, "text": "Dentist\nDentists are doctors who specialize in treatment\nof the teeth, gums, and mouth.\n\nDentists:\n\n● Detect early signs of potential oral cancer\n● Manage any oral complications that come\n up during and after cancer treatment\n● If necessary, can help correct any anatomical\n changes or changes in eating and speaking\n with prosthetic dentistry", "image": "/media/03-01-06.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-07", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 7, "text": "Oral maxillofacial surgeon\nOral and maxillofacial surgeons are specialists\nin treating conditions that affect the mouth, jaw,\nand face. They work with your medical and\ndental teams to protect your ability to speak,\nchew, and maintain oral health.\n\nOral and maxillofacial surgeons:\n\n● Treat complications affecting the mouth,\n teeth, or jaw\n● Place dental implants or preparing for\n dentures after surgery\n● Support cosmetic and functional recovery\n to improve quality of life.", "image": "/media/03-01-07.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-08", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 8, "text": "Dietician\nA dietician is a healthcare professional that\nspecializes in food and nutrition. Ask your provider\nto place a referral if you would like to be contacted.\n\nDieticians help:\n\n● Improve and maintain your nutritional status\n before, during, and after your cancer treatment\n● Manage changes in your weight or appetite\n● Help you develop an eating plan that meets\n your needs\n● Answer your questions on diet and nutrition\n throughout your treatment and recovery", "image": "/media/03-01-08.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-09", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 9, "text": "Social worker\nA social worker helps you and your family cope\nwith and manage practical and emotional\nchallenges that come with cancer and its\ntreatment.\n\nSocial workers:\n ● Connect you with support groups and\n community services\n ● Help you navigate and ﬁnd resources for\n transportation, housing and ﬁnancial\n assistance\n ● Assist with paperwork and insurance concerns\n ● Advocate for you and your family's’ needs", "image": "/media/03-01-09.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-10", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 10, "text": "Counselor or Therapist\nA counselor or therapist supports your\nemotional and mental wellbeing and help you\naddress emotional, psychological, and social\nchallenges. This may be your\npsycho-oncologist.\n\nCounselors or therapists:\n\n● Provide a safe space to talk\n● Help you manage stress, anxiety, and\n depression\n● Support you mentally and emotionally\n through your treatment and beyond.", "image": "/media/03-01-10.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-11", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 11, "text": "Chaplain\nA chaplain supports you and your loved ones’\nspiritual and emotional well being--regardless of\nreligious background or beliefs.\n\nChaplains help:\n\n● Provide emotional support during difﬁcult\n moments\n● Explore questions about meaning, purpose, or\n hope\n● Support your spiritual or religious practices\n through treatment and treatment decisions\n● Connect you with religious or spiritual\n resources in your community", "image": "/media/03-01-11.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-12", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 12, "text": "Occupational therapist\nAn occupational therapist helps you stay as\nindependent, active, and safe as possible throughout\nyour treatment.\n\nOccupational therapists:\n\n● Offer strategies to manage physical changes\n (such as weakness, limited movement and\n fatigue)\n● Help to adapt your home environment for\n comfort and safety\n● Recommend tools or equipment to make\n everyday tasks easier and safer\n● Support your return to work, school, or hobbies", "image": "/media/03-01-12.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-13", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 13, "text": "Physical therapist\nA physical therapist helps you regain strength,\nbalance, and mobility during and after cancer\ntreatment.\n\nPhysical therapists:\n\n● Reduce pain or stiffness during and after\n treatment\n● Help with walking or movement challenges\n● Teach exercises to improve strength,\n mobility, and coordination\n● Teach safe ways to stay active and return to\n daily routines", "image": "/media/03-01-13.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "03-01-14", "module": 3, "deck": "Introduction to Your Cancer Treatment Team", "page": 14, "text": "Physical medicine and rehabilitation\nspecialist\nPhysical medicine and rehabilitation specialists are\ndoctors that manage your medical issues throughout the\ntreatment and the rehabilitation process. They work with\nphysical therapists, occupational therapists, and other\nspecialists to optimize recovery.\n\nPhysical medicine and rehabilitation specialists:\n\n ● Develop a rehabilitation plan to improve movement\n and function\n ● Manage and limit pain or discomfort from cancer\n treatment or surgery\n ● Recommend equipment to help mobility challenges", "image": "/media/03-01-14.jpg", "url": "https://docs.google.com/presentation/d/1ga3GObp_WsBNJH5bb_SX2mQvR7jQdF7Vq_anIL6K6x4/view", "draft": false}, {"id": "04-01-01", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 1, "text": "Laryngeal Surgery", "image": "/media/04-01-01.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-02", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 2, "text": "Sections in this Module\n\nProcedure Stoma/ Lary Other\n Nutrition\nOptions Tube Care Considerations\n\n\n\n\n Safety\nSpeech Humidiﬁcation Nutrition\n Concerns\n\n\n\n Click on the box to jump to each section", "image": "/media/04-01-02.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-03", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 3, "text": "Procedure Options", "image": "/media/04-01-03.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-04", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 4, "text": "What does the voice box do?\n\n● Helps you talk\n● Closes off your lungs when you swallow\n● Helps guide food to your stomach\n ○ After the voice box is removed, you can\n still swallow by mouth once your\n stitches heal (usually in 7–10 days)", "image": "/media/04-01-04.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-05", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 5, "text": "Treatment options\n - Surgery\n - Radiation and/or chemotherapy\n - Post-op considerations specific to larynx cancer", "image": "/media/04-01-05.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-06", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 6, "text": "What are my surgical options?\n\n\n\n Total Transoral Laser\n Partial\n Laryngectomy Microsurgery\n Laryngectomy\n (TLM)", "image": "/media/04-01-06.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-07", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 7, "text": "What is the difference between a partial and total\nlaryngectomy?\nA partial laryngectomy is surgery to\nremove part of your voice box (larynx).\nThis may be done to remove cancer\nwhile trying to save your ability to\nspeak and swallow.\n\nA total laryngectomy means the entire\nvoice box (vocal cords) is removed. This\nis done when cancer involves most or\nall of the larynx.", "image": "/media/04-01-07.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-08", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 8, "text": "What changes after a total\nlaryngectomy?\nIn a partial laryngectomy, a temporary stoma\nmay be used to help with breathing while you\nheal.\n\nIn a total laryngectomy, a permanent stoma is\ncreated because the entire voice box is\nremoved, and this becomes your only way to\nbreathe. Moreover, a prosthesis is needed to\nspeak.", "image": "/media/04-01-08.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-09", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 9, "text": "What is transoral laser\nmicrosurgery?\n ● It is a minimally invasive surgery used to\n remove tumors from the throat or voice\n box through the mouth (no open cuts on\n the neck).\n ● A microscope is used for precise vision\n ● A laser is used to cut and remove the\n tumor\n ● Usually done under general anesthesia", "image": "/media/04-01-09.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-10", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 10, "text": "When is TLM used?\nTLM is used most often to treat:\n\n● Early-stage laryngeal cancer (especially\n on the vocal cords – glottic cancer)\n● Supraglottic cancer (above the vocal\n cords)\n● Benign vocal cord growths (like polyps\n or papillomas)\n● Sometimes used for oropharyngeal\n cancers (like base of tongue or tonsils)", "image": "/media/04-01-10.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-11", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 11, "text": "Speech", "image": "/media/04-01-11.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-12", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 12, "text": "Speaking After Surgery\nThere are a few permanent changes\nafter a total laryngectomy surgery.\n ● You will learn to speak a new\n way.\n ● By 3 weeks post-surgery, you\n may begin using your artiﬁcial\n prosthesis placed at the time of\n surgery.\n ● This allows you a more natural\n type of speech.", "image": "/media/04-01-12.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-13", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 13, "text": "Prosthesis Considerations\nand Management\nOccasionally, patients prefer not to have a\nprosthesis placed or the surgeon does not\nconsider it safe to place the prosthesis at the\ntime of our initial surgery.\n\nThis can always be done at a later date with\nsome risk. If you have this prosthesis, be sure\nthe passage remains open by keeping a\ncatheter or special tube in the opening at all\ntimes should the prosthesis become displaced.", "image": "/media/04-01-13.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-14", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 14, "text": "Stoma/ Lary Tube Care", "image": "/media/04-01-14.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-15", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 15, "text": "Post-Laryngectomy\nHospital Stay\nYou will be in the hospital\napproximately 7-10 days.\n\nA soft plastic tube called a Lary tube\nwill be placed in your stoma.\n\nThis device helps to keep the surgical\nsite open and permits the use of a\nHME (heat and moisture exchanger)\nﬁlter.", "image": "/media/04-01-15.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-16", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 16, "text": "Stoma Care\nIt is very important that you learn to care for your\nstoma as part of your daily hygiene. When\nreleased from the hospital you should begin caring\nfor yourself. Your social worker will arrange for the\nsupplies you will need to be delivered to your\nhome\n\nMake sure to:\n● Replace HME if it becomes clogged with\n mucus.\n● Sleep with your head elevated to prevent\n swelling.\n● Wash your hands each time you touch your\n stoma", "image": "/media/04-01-16.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-17", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 17, "text": "Daily Stoma Care\nThe following should be performed at least twice a\nday:\n• Remove soft plastic tube for cleaning so you can see\nonly the stoma\n• Look in the mirror and spray salt water (see recipe\nlater) into your stoma\n• Cough into a tissue held over your stoma\n• Clean your stoma with q-tips, 4x4's and/or a\nwashcloth\n• Use a mixture of 1/2 hydrogen peroxide and 1/2\nwater to cleanse stitches and/or staples twice a day\nuntil they are removed.\n• Place a thin coat of Vaseline or Aquaphor around the\nstoma and neck to protect and moisturize.", "image": "/media/04-01-17.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-18", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 18, "text": "Humidiﬁcation", "image": "/media/04-01-18.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-19", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 19, "text": "Tips to Maintain Humidity\n● Leave your HME ﬁlter in place at all\n times except when you are cleaning your\n stoma or if you need to cough.\n\n● Get in the shower and breathe water\n droplets. Some people are more\n comfortable wearing a baby bib with the\n plastic side facing out or a shower collar\n that can be special ordered.\n\n● Use a bedside humidiﬁer.\n\n● These are very important steps in\n preventing mucous from plugging your\n only breathing passage.", "image": "/media/04-01-19.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-20", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 20, "text": "Humidity Spray\nExtra moisture is very important.\nSpray salt water directly into the stoma\nat least 4 times a day::\n ● (1/4 tsp salt in 1 cup tap water,\n changed daily)\n ● 8am, 12pm, 4pm, 8pm", "image": "/media/04-01-20.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-21", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 21, "text": "Nutrition", "image": "/media/04-01-21.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-22", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 22, "text": "Eating and Drinking After\nSurgery\nIn order for the surgery site to heal you\nwill not be able to eat or drink by\nmouth until you are evaluated by your\ndoctor or speech therapist.\n\nWhen it is safe for you to eat by mouth,\nyou may notice a little tightness when\nyou swallow. Don't panic!", "image": "/media/04-01-22.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-23", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 23, "text": "Post-Surgery Nutrition\n● After surgery, you may experience difﬁculty\n swallowing due to scarring, swelling, or the\n effects of radiation.\n● To make eating easier, try grinding meats,\n using gravy or sauces to moisten foods, and\n experimenting with different textures.\n● It’s also common for taste to change after\n surgery. Using more spices and ﬂavorings can\n help make food more enjoyable.", "image": "/media/04-01-23.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-24", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 24, "text": "Post-Surgery Comfort\n ● Be aware that certain foods, like\n acidic items or carbonated drinks,\n may cause bloating or belching. If\n this happens, over-the-counter\n remedies like Tums may provide\n relief.\n ● If swallowing becomes especially\n difﬁcult, contact your nurse or\n speech therapist to discuss\n treatment options.", "image": "/media/04-01-24.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-25", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 25, "text": "Safety Concerns", "image": "/media/04-01-25.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-26", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 26, "text": "Smelling and Breathing\nPost Surgery\nYour sense of smell is usually affected after this\nsurgery.\n ● Smoke and carbon monoxide detectors are\n recommended.\nYour only breathing passage is through your neck.\n ● Most laryngectomy patients feel more\n comfortable wearing an emergency bracelet or\n having information in their wallet to speak for\n them in case of emergency.\n ● This will also inform emergency personnel that\n artiﬁcial oxygen would have to be delivered\n through the neck.\n ● If you fall into a large body of water you will\n drown; therefore, water sports are off limits.", "image": "/media/04-01-26.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-27", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 27, "text": "Other Considerations", "image": "/media/04-01-27.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-01-28", "module": 4, "deck": "Ablative: Laryngeal Surgery", "page": 28, "text": "Runny Nose Post-Surgery\n\nAfter a laryngectomy your body is\nattempting to adapt to your new way of\nbreathing, this may cause a runny nose.\nYou can use over the counter Claritin to\nhelp with the drainage.", "image": "/media/04-01-28.jpg", "url": "https://docs.google.com/presentation/d/152RQNraCe9iGeIwc2SrguMVZK61Rd9UB9p5YXACt31w/view", "draft": true}, {"id": "04-02-01", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 1, "text": "Mouth Surgery", "image": "/media/04-02-01.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-02", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 2, "text": "Sections in this Module\n\n Mouth Cancer Procedure\n Background Options\n\n\n\n\n Testing for Other\n Mouth Cancer Considerations\n\n\n\n Click on the box to jump to each section", "image": "/media/04-02-02.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-03", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 3, "text": "Mouth Cancer Background", "image": "/media/04-02-03.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-04", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 4, "text": "What is the oral cavity?\n● The mouth, or oral cavity, is made\n up of the lips, cheeks, palate, teeth,\n and tongue.\n● Oral cavity cancer affects the lips,\n front 2/3rds of the tongue, the\n gums, the lining inside the\n cheeks/lips, the ﬂoor of the mouth,\n the bony top of the mouth, and the\n bony ridges that hold the teeth.", "image": "/media/04-02-04.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-05", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 5, "text": "Testing for Mouth Cancer", "image": "/media/04-02-05.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-06", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 6, "text": "How does testing work?\n● Prior to treatment planning, testing\n is needed.\n● Results from imaging and biopsies\n are relied on to develop individual\n treatments.\n● A comprehensive medical history,\n physical exam (speciﬁcally head and\n neck exam), and scans (CT, PET,\n Endoscopy, etc.) are utilized.", "image": "/media/04-02-06.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-07", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 7, "text": "What are my procedure options?\n\n\n\n\n Maxillectomy Oral Composite\n Glossectomy\n Resection\n\n\n Click on the box to jump to each section", "image": "/media/04-02-07.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-08", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 8, "text": "What is a glossectomy?\n● Surgical removal of part or all of the\n tongue.\n ○ Partial: resection of a portion of the\n tongue\n ○ Hemi: removal of one side of the\n tongue\n ○ Total: complete tongue removed\n● Surgeons aim to preserve as much of\n the tongue as possible during the\n procedure.\n● Afterwards, speech and swallowing\n therapy is commonly needed during\n recovery.", "image": "/media/04-02-08.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-09", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 9, "text": "What is a maxillectomy?\n● The maxilla is the upper jawbone. A\n maxillectomy refers to the removal\n of part or all of the maxilla.\n ○ Due to a tumor in the hard\n palate, upper gum area, or\n sinuses.\n● After surgery, some patients might\n need an obturator (prosthetic\n device) to aid in restoring speech\n and chewing.\n● Reconstruction can be done using\n tissue from other parts of the body.", "image": "/media/04-02-09.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-10", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 10, "text": "What is oral composite\nresection?\n● This is a more extensive surgery\n involving tumor removal throughout\n multiple connected structures in the\n mouth (tongue, ﬂoor of mouth,\n jawbone, or soft tissue).\n● Used for larger or more complex\n cancers.\n● Reconstruction and rehabilitation\n afterwards are common.", "image": "/media/04-02-10.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-11", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 11, "text": "Other Considerations", "image": "/media/04-02-11.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-02-12", "module": 4, "deck": "Ablative: Mouth Surgery", "page": 12, "text": "What to expect after your\nprocedure\n● Recovery from your procedure may\n include:\n ○ Swelling, changes in\n speech/swallowing.\n ○ Temporary feeding tubes or\n tracheostomy.\n ○ Reconstruction or prosthetics\n may be implemented.\n ○ Physical, speech, swallowing\n therapy as part of the healing\n process.", "image": "/media/04-02-12.jpg", "url": "https://docs.google.com/presentation/d/19bJBv_EZeTZHgHf7o4iWMWu2TUuGLxvu4Newckm9im0/view", "draft": true}, {"id": "04-03-01", "module": 4, "deck": "Ablative: Neck Dissection", "page": 1, "text": "Neck Dissection", "image": "/media/04-03-01.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-02", "module": 4, "deck": "Ablative: Neck Dissection", "page": 2, "text": "Sections in this Module\n What to Medications\n Procedure Expect After and Incision\n Background the Procedure Care\n\n\n\n General Eating,\n Drinking, Concerns\n Instructions\n Activity\n\n\n Click on the box to jump to each section", "image": "/media/04-03-02.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-03", "module": 4, "deck": "Ablative: Neck Dissection", "page": 3, "text": "Procedure Background", "image": "/media/04-03-03.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-04", "module": 4, "deck": "Ablative: Neck Dissection", "page": 4, "text": "What is a neck dissection?\n\n● A neck dissection is a surgical procedure\n done to remove lymph nodes and\n surrounding tissue in the neck that may be\n at risk of containing cancer.\n● It is done to prevent cancer from spreading.\n● It is done under general anesthesia.\n● The surgeon makes an incision along the\n neck to access and remove lymph nodes.", "image": "/media/04-03-04.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-05", "module": 4, "deck": "Ablative: Neck Dissection", "page": 5, "text": "What to Expect After the\n Procedure", "image": "/media/04-03-05.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-06", "module": 4, "deck": "Ablative: Neck Dissection", "page": 6, "text": "After the procedure, it is common\nto have\n● Pain and mild swelling at the incision site.\n ○ Swelling peaks ~4 days post surgery.\n● Numbness in the surgery area.\n● The skin around the surgery site will be\n tight and ﬁrm to the touch.\n ○ This will soften over 4-6 months.\n● Numbness, tingling, and shooting pains are\n normal post-surgery.", "image": "/media/04-03-06.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-07", "module": 4, "deck": "Ablative: Neck Dissection", "page": 7, "text": "General Instructions", "image": "/media/04-03-07.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-08", "module": 4, "deck": "Ablative: Neck Dissection", "page": 8, "text": "General instructions for recovery\n\n● Use additional pillows if needed to keep\n your head raised when you lie down for the\n ﬁrst few weeks after surgery.\n● This helps prevent increased swelling.\n● Use cold compresses (ice packs, bags of\n frozen foods) to help reduce swelling.\n● Keep up with ALL follow-up visits", "image": "/media/04-03-08.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-09", "module": 4, "deck": "Ablative: Neck Dissection", "page": 9, "text": "Medications and Incision Care", "image": "/media/04-03-09.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-10", "module": 4, "deck": "Ablative: Neck Dissection", "page": 10, "text": "Medications to take post-surgery\n● Take over-the-counter and prescription\n medications as instructed\n● If you were prescribed an antibiotic, take it\n as directed.\n ○ Do not stop taking it even if you feel\n better.\n● While on pain meds, avoid driving.\n● Some prescriptions can cause constipation.\n As a result:\n ○ Drink enough ﬂuids\n ○ Take over-the-counter stool softeners\n ○ Eat foods high in ﬁber\n ○ Limit foods high in fat and processed\n sugars", "image": "/media/04-03-10.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-11", "module": 4, "deck": "Ablative: Neck Dissection", "page": 11, "text": "Incision care\n● You may shower 48 hours post-surgery.\n Any soaps can be used. Do not scrub the\n incision site, just let the water run down\n your neck.\n● Leave skin glue in place. We will show you\n how to remove it during your ﬁrst post-op\n visit.\n● You may have a drain in place which would\n be removed ~4-5 days after your surgery.\n ○ The color of the drainage may change\n from red, a rose color, or yellow, which\n is a normal progression.", "image": "/media/04-03-11.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-12", "module": 4, "deck": "Ablative: Neck Dissection", "page": 12, "text": "Incision care (cont.)\n● You may use a gauze sponge or other\n dressing to prevent leaking.\n● Check your incision area every day for\n infection signs such as:\n ○ More redness, swelling, pain\n ○ Fluid or blood\n ○ Warmth\n ○ Pus or a foul smell\n● You may shower with a drain in place. Use\n a headband or something similar to secure\n the drain to your neck as you shower.", "image": "/media/04-03-12.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-13", "module": 4, "deck": "Ablative: Neck Dissection", "page": 13, "text": "Eating, Drinking, Activity", "image": "/media/04-03-13.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-14", "module": 4, "deck": "Ablative: Neck Dissection", "page": 14, "text": "Eating and drinking post-surgery\n● Please follow a regular diet while your\n drain is in place.\n● If your mouth or jaw is sore, eating soft\n foods until you feel better is the best\n option.", "image": "/media/04-03-14.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-15", "module": 4, "deck": "Ablative: Neck Dissection", "page": 15, "text": "Activity post-surgery\n● You might be more easily fatigued after\n surgery. This is normal. Please rest as\n needed but also be sure you’re up and\n moving to improve blood ﬂow and\n breathing.\n● Do not lift anything heavier than 10 lbs for\n 3 weeks post surgery.\n● Do not submerge your incision in any\n swimming pools, rivers, hot tubs, bath tubs,\n etc. for 4 weeks post-surgery.\n ○ You may only shower.", "image": "/media/04-03-15.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-16", "module": 4, "deck": "Ablative: Neck Dissection", "page": 16, "text": "Concerns", "image": "/media/04-03-16.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-03-17", "module": 4, "deck": "Ablative: Neck Dissection", "page": 17, "text": "Contact our ofﬁce if:\n\n● You have pain that does not get better with\n pain medications.\n● You have increasing redness, swelling, or\n pain around the incision.\n● Your incision feels warm to the touch.\n● You have pus or a bad smell coming from\n the incision.\n● You develop a fever.", "image": "/media/04-03-17.jpg", "url": "https://docs.google.com/presentation/d/1o6us5HtPN9HgBWMMN1eIQFAc84muJxSx5qzQk3Kk7g0/view", "draft": true}, {"id": "04-04-01", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 1, "text": "Oropharyngeal Surgery", "image": "/media/04-04-01.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-02", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 2, "text": "What is the oropharynx?\n● The oropharynx is the middle part\n of your throat.\n● It includes:\n ○ The back of your tongue\n ○ Your tonsils\n ○ The roof of your mouth (soft\n palate)\n ○ The walls of your throat\n● This area helps you talk, breathe,\n eat, and swallow.", "image": "/media/04-04-02.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-03", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 3, "text": "What is Transoral Robotic\nSurgery?\n● TORS stands for Transoral Robotic\n Surgery.\n● It helps surgeons remove cancer\n through the mouth.\n● It is a good option when the cancer is\n in a hard-to-reach area.\n● TORS avoids large cuts and can help\n you heal faster.", "image": "/media/04-04-03.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-04", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 4, "text": "Where is TORS used?\n● Best areas:\n ○ Tonsils\n ○ Base of the tongue\n ○ Roof of the mouth (palate)\n ○ Back of the throat (pharyngeal\n wall)\n ○ Voice box (supraglottis)\n● Some deep areas may still need laser\n surgery (TLM)", "image": "/media/04-04-04.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-05", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 5, "text": "Weighing the Risks and Beneﬁts\n\n RISKS BENEFITS\n\n ● No large cuts to the face or jaw\n ● Bleeding: especially around\n ● May reduce or avoid the need for\n 10 days after surgery\n chemo or radiation\n ● Taste changes (dysgeusia)\n ● Often no need for a breathing\n ● Trouble swallowing (may\n tube (tracheostomy)\n need a feeding tube at ﬁrst)\n ● Faster return to talking and\n ● Nasal food reﬂux or speech\n eating\n changes (rare)\n ● Less pain and bleeding\n ● Leak or ﬁstula (more likely if\n ● Shorter hospital stay and\n neck surgery is done too) recovery", "image": "/media/04-04-05.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-06", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 6, "text": "Who is a good candidate for\nTORS?\n● Not everyone is a good ﬁt\n● We look at:\n ○ Tumor location and size\n ○ How wide the mouth opens (trismus)\n ○ Shape of the jaw and tongue\n ○ Head movement (can you tilt your\n head back?)\n ○ Imaging to check blood vessels and\n tumor location\n**Disclaimer: The risks and benefits listed are general and may not apply to\neveryone. Your healthcare team will evaluate your individual condition to decide\nif TORS is right for you.", "image": "/media/04-04-06.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-07", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 7, "text": "Who is NOT a good candidate\nfor TORS?\n ● Tumor too close to the spine or big blood\n vessels\n ● Tumor involves too much of the tongue or\n throat wall\n ● Tumor is ﬁxed (stuck) to nearby tissues\n ● Carotid artery too close to tumor\n ● Not safe for general anesthesia\n ● Can’t open mouth enough to reach tumor\n\n**Disclaimer: The risks and benefits listed are general and may not apply to\neveryone. Your healthcare team will evaluate your individual condition to\ndecide if TORS is right for you.", "image": "/media/04-04-07.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-08", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 8, "text": "How do I prepare for surgery?\n ● You may meet with medical consult\n and anesthesia teams based on\n your age and medical history\n ● These teams help ensure you are\n ready for anesthesia and surgery\n ● Your care team includes the\n surgeon, residents, advanced\n practice providers (APPs), nurses,\n and anesthesia providers", "image": "/media/04-04-08.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-09", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 9, "text": "How do I prepare for surgery?\n(cont.)\n ● You will be told when to stop eating\n and drinking before surgery (usually\n nothing after midnight)\n ● Your team will tell you which\n medications to continue or stop\n ● You will be notiﬁed of your surgery\n start time and arrival time", "image": "/media/04-04-09.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-10", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 10, "text": "What happens in the\nprocedure?\n ● The procedure lasts about 3 to 4 hours\n ● If neck dissection (removal of lymph\n nodes) is done, the surgery may take\n longer\n ● You may have a feeding tube placed\n through your nose to your stomach to\n ensure you get enough nutrition\n ● You will be under general anesthesia,\n meaning you will be fully asleep", "image": "/media/04-04-10.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-11", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 11, "text": "What happens after the\nprocedure?\n● You will be monitored in the recovery\n room and then moved to the intensive\n care unit (ICU) for one night and once\n stable, you will move to a regular hospital\n unit\n● Your safety is important, so always ask for\n help before getting out of bed\n● Your team will monitor you closely for\n bleeding or other complications", "image": "/media/04-04-11.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-12", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 12, "text": "What is the recovery process\nlike?\n● Recovery time depends on your surgery\n type, pain control, and ability to eat and\n drink\n● Most patients stay in the hospital for at\n least 3 days\n● Throat pain is expected\n● Pain and bleeding risk are highest from\n days 5 to 10 after surgery\n● Most patients feel better by around 2\n weeks", "image": "/media/04-04-12.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-13", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 13, "text": "Diet After Surgery\n\n● Day 0 (day of surgery): Start with clear\n liquids like broth, apple juice, or tea\n● Day 1 (day after surgery): Progress to full\n liquids such as smoothies, milkshakes,\n and nutritional drinks (Ensure, Boost)\n● Stay on full liquids for 2 days\n● Try soft foods before leaving the hospital\n and move to a regular diet as tolerated", "image": "/media/04-04-13.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-14", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 14, "text": "Self-Care After Discharge\n● If you have a neck incision, clean it with\n normal saline twice a day and apply\n Aquaphor\n● Avoid lifting more than 10 pounds for 2\n weeks\n● Avoid activities that raise your heart rate\n● Gradually increase activity as tolerated\n● Drink 6 to 8 glasses of water daily\n● Use stool softeners to avoid constipation;\n stay hydrated and move around to help\n bowel function", "image": "/media/04-04-14.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-04-15", "module": 4, "deck": "Ablative: Oropharyngeal Surgery", "page": 15, "text": "Care Team After Discharge\n● Your surgical team will decide when\n you’re ready for discharge\n● Discharge planning starts before you\n leave and includes input from your\n surgical team, nurses, social worker,\n physical therapist, speech/swallow\n therapist, and nutritionist\n● You may go home or to a rehab/skilled\n nursing facility depending on your needs", "image": "/media/04-04-15.jpg", "url": "https://docs.google.com/presentation/d/1By6oN2PehzhP4d3p8hTkv41GYc0BjQt7HJLIRChA0lY/view", "draft": true}, {"id": "04-05-01", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 1, "text": "Salivary Gland Surgery", "image": "/media/04-05-01.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-02", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 2, "text": "Sections in this Module\n\n\n Submandibular\n Salivary\n Parotidectomy Gland\n Glands\n Resection\n\n\n\n Click on the box to jump to each section", "image": "/media/04-05-02.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-03", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 3, "text": "Salivary Glands", "image": "/media/04-05-03.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-04", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 4, "text": "What are salivary glands?\nSalivary glands make saliva, which helps you\nchew, swallow, and digest food.\n\nYou have 3 main pairs:\n\n ● Parotid glands (in front of your ears)\n ● Submandibular glands (under your jaw)\n ● Sublingual glands (under your tongue)\n\n\nThese glands can sometimes develop\ntumors, which may be benign\n(non-cancerous) or malignant (cancerous).", "image": "/media/04-05-04.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-05", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 5, "text": "Parotidectomy", "image": "/media/04-05-05.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-06", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 6, "text": "Superﬁcial Parotidectomy\nWhat is a parotidectomy?\n\n A parotidectomy is surgery to\n remove the parotid gland, the largest\n salivary gland.\n\n There are two types:\n ● Superﬁcial parotidectomy\n ● Total parotidectomy\n\n\n\n\n Total Parotidectomy", "image": "/media/04-05-06.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-07", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 7, "text": "Superﬁcial vs. Total Parotidectomy\n\n SUPERFICIAL TOTAL\n\n ● The entire parotid gland is\n ● Only the outer (superﬁcial)\n removed.\n part of the gland is removed.\n ● This may be needed if:\n ● Used when the tumor is ○ The tumor is deep inside the\n small and not deep. gland\n ● The surgeon carefully avoids ○ The cancer is more\n the facial nerve, which runs aggressive\n through the gland and ● The facial nerve is still preserved\n controls smiling, blinking, when possible, but sometimes\n and other facial movements. needs to be partially removed if\n involved by the tumor.", "image": "/media/04-05-07.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-08", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 8, "text": "What to expect after a\nparotidectomy?\n ● You may feel numbness or\n weakness in your face—this is\n usually temporary, but can\n sometimes last longer.\n ● A drain may be placed for 1–2 days\n to remove extra ﬂuid.\n ● You may have a scar near your ear\n or jaw, which usually heals well\n over time.\n ● Most patients go home within a day\n or two.", "image": "/media/04-05-08.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-09", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 9, "text": "Submandibular Gland\n Resection", "image": "/media/04-05-09.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-10", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 10, "text": "What is a submandibular gland\nresection?\n ● This surgery removes the\n submandibular gland, located under\n the jaw.\n ● It is done when a tumor or stone is\n found in the gland.\n ● The incision is made in the upper neck,\n under the jaw.", "image": "/media/04-05-10.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-11", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 11, "text": "What are the risks of a\nsubmandibular gland resection?\n ● Temporary or permanent numbness in\n the tongue or lower lip\n ○ The marginal mandibular nerve,\n which controls the lower lip, runs\n close by\n ○ Your surgeon will try to protect it\n ● A visible scar in the neck (usually\n fades over time)\n ● Swelling or tightness during healing", "image": "/media/04-05-11.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-05-12", "module": 4, "deck": "Ablative: Salivary Gland Surgery", "page": 12, "text": "Recovery Tips\n● Keep the area clean and dry\n● Follow your surgeon’s instructions on:\n ○ Pain medicine\n ○ Wound care\n ○ Drain care (if you have one)\n● You may have a follow-up with the surgeon\n and possibly a speech therapist if needed.\n● Your care team will let you know if you\n need radiation or other treatments based\n on the tumor type.", "image": "/media/04-05-12.jpg", "url": "https://docs.google.com/presentation/d/1iJFYOejc8SmRI4ceSXiunKIyJ1UGsPgcJ6EGTHr-jZ4/view", "draft": true}, {"id": "04-06-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-06-01.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "Sections in this Module\nBasic concepts,\ndeﬁnitions, and What to\nbackground Reconstruction Reconstruction expect before,\n when bone is of soft tissue during, and\nFlap surgery involved: upper (no bone is after the\ninvolving the and lower jaw reconstructed)\n (maxilla and hospital\ninside of the\nmouth mandible)\n\n\n Click on the box to jump to each section", "image": "/media/04-06-02.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "Basic Concepts, Deﬁnitions,\n and Background to Flaps", "image": "/media/04-06-03.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "What is a ﬂap?\nA ﬂap is a piece of tissue used to ﬁx a\nwound or cover a missing area after\nsurgery.\n\nA ﬂap is different from a graft because it\nhas its own blood supply (a graft does\nnot).\n\nBlood ﬂows into the ﬂap through an artery\nand out of the ﬂap through a vein to keep it\nalive.", "image": "/media/04-06-04.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "What can a ﬂap be made of?\n Soft tissue (skin, muscle, fat)\n\n Bone\n\n Both soft tissue and bone", "image": "/media/04-06-05.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "What is a graft?\nA graft is a piece of tissue used to repair\nor rebuild an area, but it does not have\nits own blood supply.\n\nA skin graft is very thin (like a piece of\npaper) and does not need blood vessels.\nIt can use oxygen and nutrients from the\ntissue it is placed on.\n\nBecause it is so thin, a skin graft is\nmostly used for surface repairs, not deep\nwounds.", "image": "/media/04-06-06.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "Bone or Cartilage Grafts\nSometimes bone or cartilage can\nbe used as a graft.\n\nBone or cartilage grafts are small\npieces without blood supply.\nThey get oxygen and nutrients\nfrom the soft tissue around them.", "image": "/media/04-06-07.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "Free Flap\nA free ﬂap is taken from a distant body part (like\nthe forearm or lower leg).\n\nBlood vessels are cut to move the ﬂap to the\nneeded area.\n\nThe ﬂap vessels are connected to blood vessels\nin the neck (artery to artery, vein to vein).\n\nThis process is like a transplant, but since it\ncomes from the patient’s own body, there is no\nrisk of rejection and no anti-rejection medications\nare needed.", "image": "/media/04-06-08.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "Pedicled Flap\nA pedicled ﬂap is taken from a nearby area (like the chest or shoulder).\n\nThe pedicled ﬂap stays attached to its original blood vessels.", "image": "/media/04-06-09.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "Key Differences Between Free\nFlaps and Pedicled Flaps\nA free ﬂap gives more freedom to shape\nand position the tissue.\n\nWhen bone is needed a free ﬂap is\nusually necessary (unless the piece of\nbone is very small).", "image": "/media/04-06-10.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "Situations When the Free\nFlap is a Better Option than\nthe Pedicled Flap or Graft\n A skin graft may be too thin and not\n work well for deep wounds.\n\n Skin grafts in the mouth can cause\n scarring and limit tongue\n movement.\n\n Skin grafts cannot be placed directly\n on bone because bone does not\n provide enough blood supply.", "image": "/media/04-06-11.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "Situations When the Free\nFlap is a Better Option than\nthe Pedicled Flap or Graft\n\n Grafts may not heal well if the area\n has had or will have radiation\n therapy.\n\n A pedicled ﬂap may be too thick or\n not reach the area needing repair.", "image": "/media/04-06-12.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "Flap Surgery Involving the\n Inside of the Mouth", "image": "/media/04-06-13.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "Flap Surgery Involving the Inside I Can Manage Cancer\n\n\nof the Mouth or Throat\nHow does surgery affect eating, drinking, and breathing?\n\nThe mouth and throat are important for eating, drinking,\nspeaking, and breathing.\n\nSurgery in these areas can cause swelling, which may\nmake it hard to breathe, sometimes requiring a\ntemporary tracheostomy tube (a breathing tube in the\nneck).\n\nIt can also affect the ability to swallow food and liquids,\nmaking a feeding tube necessary during healing.", "image": "/media/04-06-14.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "I Can Manage Cancer\nWhen can I eat by mouth?\nThe flap (usually skin) is stitched into place to repair the surgical\nwound in the mouth. Stitches dissolve in about a month, but healing\ntakes 2 to 3 weeks or longer. The wound must be fully sealed to\nprevent saliva from leaking into the wound. Your surgeon will decide\nwhen it is safe for you to start eating and drinking again.", "image": "/media/04-06-15.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-06-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "Can I swallow my own\nsaliva while I am healing, or\nshould I spit it out?\nYes, you can swallow your saliva.\n\nIt is not recommended to constantly\nspit or suction it out, unless you\ncannot swallow. This could cause\ndehydration over time.", "image": "/media/04-06-16.jpg", "url": "https://docs.google.com/presentation/d/1X0doRmqWPFxAvrQrHEoki8XiuSGRZoUObP8TA67xG2c/view", "draft": true}, {"id": "04-07-01", "module": 4, "deck": "Reconstructive Surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-07-01.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-02", "module": 4, "deck": "Reconstructive Surgery", "page": 2, "text": "Lower Jaw (Mandible)\n Reconstruction", "image": "/media/04-07-02.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-03", "module": 4, "deck": "Reconstructive Surgery", "page": 3, "text": "I Can Manage Cancer\nLower Jaw (Mandible)\nReconstruction\nWhy is a free flap used to repair the lower jaw?\n\nReconstructing the lower jaw usually requires a\nfree flap because these cancers need radiation\ntherapy after surgery to prevent the cancer from\nreturning.\n\nRadiation would destroy a bone graft because\nthe graft does not have a blood supply, but the\nfree flap does have blood supply.", "image": "/media/04-07-03.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-04", "module": 4, "deck": "Reconstructive Surgery", "page": 4, "text": "I Can Manage Cancer\n\nLower Jaw (Mandible) Reconstruction Continued\nAlso, a free flap is used when there is a gap in the bone bigger than about\n5 cm (2 inches) because larger grafts may not survive.\n\nThe bone-containing flaps that are commonly used for jaw reconstruction\nare the fibula, scapula, and a small amount from the radius/forearm flaps\n(AKA osteocutaneous radial forearm free flap).", "image": "/media/04-07-04.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-05", "module": 4, "deck": "Reconstructive Surgery", "page": 5, "text": "Which type of ﬂap will be used\nfor the mandible? The ﬁbula\nﬂap\nSurgeons usually use the ﬁbula ﬂap to\nrebuild the jaw. The ﬁbula is a strong\nbone in the lower leg that can be\nshaped to ﬁt the jaw.\n\nWe also take some soft tissue (skin, fat,\nand fascia) from the leg to help with the\nreconstruction.", "image": "/media/04-07-05.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-06", "module": 4, "deck": "Reconstructive Surgery", "page": 6, "text": "The Fibula Flap Continued\nThe ﬁbula’s blood vessels are long,\nwhich helps position the new jaw\ncorrectly.\n\nAnother beneﬁt is that while one\nsurgeon removes the tumor, another\ncan prepare the ﬁbula ﬂap at the same\ntime. This can save 1 to 2 hours in\nsurgery.", "image": "/media/04-07-06.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-07", "module": 4, "deck": "Reconstructive Surgery", "page": 7, "text": "The Scapula Flap\nAnother option is the scapula ﬂap (from\nthe shoulder blade). However, since it's on\nthe back, it takes more time in surgery\nbecause surgeons can’t work on it at the\nsame time as tumor removal.\n\nThe scapula ﬂap is often used if the lower\nleg isn’t healthy enough for a ﬁbula ﬂap.\nThis is because leg arteries can have more\nblockage (atherosclerosis), while the\nscapula’s artery is usually healthier.", "image": "/media/04-07-07.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-08", "module": 4, "deck": "Reconstructive Surgery", "page": 8, "text": "The Scapula Flap Continued\nUnlike the ﬁbula ﬂap, the scapula ﬂap\ndoesn’t need a special scan (CT\nangiogram) to check blood ﬂow because\nthe artery for the scapula ﬂap is not vital\nto any other body part.\n\nThe scapula ﬂap is also a better choice\nwhen a lot of soft tissue is needed, as it\nprovides more skin and muscle than the\nﬁbula.", "image": "/media/04-07-08.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-09", "module": 4, "deck": "Reconstructive Surgery", "page": 9, "text": "Other Options for Jaw Reconstruction- I Can Manage Cancer\n\n\n\n\nthe Radial Forearm Flap\nAnother option is the radial forearm flap (from the inner forearm). This\nflap includes a thin piece of bone, so it’s not usually the first choice for\nthe jaw. Instead, it’s often used for reconstructing the upper jaw,\ncheekbones, or eye sockets.", "image": "/media/04-07-09.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-10", "module": 4, "deck": "Reconstructive Surgery", "page": 10, "text": "How is the ﬂap bone connected\nto the jaw?\nA titanium plate is used to connect the pieces\nof bone together. This plate spans the gap\nacross the mandible where the tumor was\nremoved.\n\nThe plate is screwed into the remaining parts\nof the mandible as well as the bone of the\nﬂap after it is shaped to ﬁt the defect.", "image": "/media/04-07-10.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-11", "module": 4, "deck": "Reconstructive Surgery", "page": 11, "text": "The Titanium Plate Continued\nThe size and position of a mandible\nresection depends on the location of the\ntumor, but this is an example of a large\nreconstruction plate.\n\nEvery resection is a little different. In this\ncase, the entire chin is being removed. The\nbone that needs to be removed is\ndetermined by the cancer surgeon, based\non the location and size of the tumor.\n Click here to return to\n forearm ﬂap slide 81", "image": "/media/04-07-11.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-12", "module": 4, "deck": "Reconstructive Surgery", "page": 12, "text": "I Can Manage Cancer\n\nIs the titanium plate\nsafe?\nYes, the titanium plate is safe and\nstays in the body permanently for\nmost patients.\n\nIt does not cause allergies or\nreactions and cannot be rejected by\nthe body.", "image": "/media/04-07-12.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-13", "module": 4, "deck": "Reconstructive Surgery", "page": 13, "text": "Is the titanium plate safe?\nContinued\nThe titanium plate is not magnetic,\nso it won’t set off metal detectors\nand is safe for MRIs.\n\nOccasionally, the plate can become\ninfected over time (rarely) and need\nto be removed. Another rare\ncomplication is when the plate\nbecomes loose over time, requiring\nremoval, or the plate breaks. These\nsituations are rare.", "image": "/media/04-07-13.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-14", "module": 4, "deck": "Reconstructive Surgery", "page": 14, "text": "Soft Tissue Repair in the\nTongue, Cheek, or Under the\nTongue\nIf there is a soft tissue defect in the\ntongue, cheek, or under the tongue (ﬂoor\nof the mouth) some skin or muscle from\nthe ﬂap is sutured in place to patch the\nsoft tissue defect.\n\nThe sutures will all dissolve on their own.", "image": "/media/04-07-14.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-15", "module": 4, "deck": "Reconstructive Surgery", "page": 15, "text": "Will I look like myself after mandible reconstruction\nsurgery or will I be disﬁgured?\nFor most patients, the changes to appearance after mandible\nreconstruction are minimal. Signiﬁcant changes are rare and usually only\nhappen if the tumor or wound affects the external skin or soft tissue of the\nface or neck. This is typically seen in very large tumors.", "image": "/media/04-07-15.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-16", "module": 4, "deck": "Reconstructive Surgery", "page": 16, "text": "I Can Manage Cancer\nWill I have visible scars?\nGenerally, this surgery is done through the inside of the mouth and an\nincision on the neck. It is not usually necessary to place any scars on\nthe face unless the tumor is invading the skin of the face or neck (this\nis not common).", "image": "/media/04-07-16.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-17", "module": 4, "deck": "Reconstructive Surgery", "page": 17, "text": "I Can Manage Cancer\nWill I have visible scars?\nA neck incision is necessary to find blood\nvessels in the neck to re-establish blood\nflow to the flap. These neck incisions\nheal very well and leave a faint scar that\nis generally not obvious after it heals.\n\nUsually, lymph nodes need to be\nremoved from the neck as part of the\ncancer surgery. The same neck incision\nis used for this as well.", "image": "/media/04-07-17.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-07-18", "module": 4, "deck": "Reconstructive Surgery", "page": 18, "text": "I Can Manage Cancer\nWill my face shape change?\nThe shape of the reconstructed mandible\nis based on the shape of each individual\npatient’s jaw. The titanium plate is\ncustom made to each patient’s anatomy.\n\nIt is not possible to make the new jaw the\nexact same shape as the patient's\nnatural jaw, however, the changes are\nusually subtle once healing is complete", "image": "/media/04-07-18.jpg", "url": "https://docs.google.com/presentation/d/1hnNimMVDy7kX_EY-DAexm_ABeee-7pT8ZICO5YrcOmk/view", "draft": true}, {"id": "04-08-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-08-01.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "Swelling of the Face and Neck\nSwelling of the face and neck is normal\nand expected after surgery. Usually, this\nswelling is the worst 3 days after the\nsurgery and then gradually improves\nover the next several weeks to months.\n\nSwelling may come and go at times- this\nis normal.", "image": "/media/04-08-02.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "I Can Manage Cancer\n\nWhen is swelling the worst?\nSometimes patients find that swelling is worse in the morning when\nthey wake up – because they have been lying down all night. If this is\nthe case, sleep with your head elevated on extra pillows, or even in a\nreclining chair if necessary. Sometimes patients notice swelling\nincreases throughout the day, and it is better in the morning.", "image": "/media/04-08-03.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "When should I be worried about\nswelling?\nIf swelling is gradually worsening over\nseveral consecutive days, this may be a cause\nfor concern, especially if there is also\nincreased pain, redness of the neck or face, or\ndrainage of pus from incisions or drain tubes.\n\nThe presence of fevers and/or chills is a\nwarning sign as well. Talk to your surgical\nteam.", "image": "/media/04-08-04.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "Is this surgery painful?\n\nThis type of facial surgery is generally\nless painful than most patients expect.\nThere is certainly some pain, but it is\nusually well controlled with pain\nmedicine.\n\nThere may be some pain that comes and\ngoes. Pain may be worse at certain times\nof day and some days may be worse\nthan others. This is normal.", "image": "/media/04-08-05.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "I Can Manage Cancer\n\n\nWhen is pain concerning?\nPain is worrisome if it is continually\nincreasing over several days.\nEspecially if there is also\nfevers/chills, swelling that is\ngradually increasing over several\ndays, or any new drainage from any\nincisions.", "image": "/media/04-08-06.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "Upper Jaw / Midface\n Reconstruction", "image": "/media/04-08-07.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "Upper Jaw/Midface (Maxilla)\nReconstruction\nMaxillary reconstruction is similar to\nmandible reconstruction in many ways.\n\nThe bones are smaller than the mandible,\nso while titanium plates are still used to\njoin the bone segments together, these are\nsmaller than the plates used for mandible\nreconstruction.\n\nPlates are still usually custom made for\neach individual patient.", "image": "/media/04-08-08.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "Upper Jaw/Midface (Maxilla) Reconstruction Continued\n\nOther than these differences, the details of the mandible\nreconstruction section above apply to patients who are undergoing\nmaxillary reconstruction.", "image": "/media/04-08-09.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "Fibula Flap", "image": "/media/04-08-10.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "The Fibula Flap. How is the\nﬁbula used for reconstruction?\n\nThe ﬁbula is the smaller of the two lower\nleg bones (the larger bone is the tibia).\n\nIt can be safely removed and used for\nreconstruction. The central part of the\nﬁbula is removed, saving the bottom 3-4\ninches by the ankle, and a similar length\nby the knee.", "image": "/media/04-08-11.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "Will this affect blood ﬂow to\nmy leg?\nThe lower leg has 3 arteries that carry blood\ndown to the foot. The artery called the\nperoneal artery supplies the ﬁbula ﬂap.\n\nBecause the leg has 3 main arteries, and if\nthe other two arteries are healthy, blood\nﬂow to the foot remains normal after\nsurgery.", "image": "/media/04-08-12.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "How do we make sure it’s\nsafe?\nWe will check your pulses on your foot and\norder a scan called a CT Angiogram, which\nexamines the arteries in the legs.\n\nWe do this to make sure that it is safe to take\nthe peroneal vessels supplying the ﬁbula ﬂap\nwithout hurting the circulation to the foot.", "image": "/media/04-08-13.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "What will my leg look like\nafter surgery?\nIf no skin is needed for reconstruction,\nyou will have a in scar, in a straight line,\nrunning down the outside of the calf,\nfrom below the knee to above the\nankle.\n\nThe example on the right shows a scar\nafter two weeks of healing—this is not\nthe ﬁnal result.", "image": "/media/04-08-14.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "What happens if skin is needed for\nreconstruction?\n If skin is necessary for reconstruction, the resulting skin wound\n usually cannot be closed. This leaves a shallow, open wound, with\n exposed muscle, after the ﬂap is taken.\n\n To repair this, we may take a skin graft from the thigh. This skin\n graft is paper thin and is used to patch the leg wound.\n\n It will always look somewhat like a patch, but the color will even out\n over time, and the scars will fade and become smooth.", "image": "/media/04-08-15.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "What are my other options\nfor a skin graft?\nMore commonly, we are now using a skin\nsubstitute called biodegradable tissue matrix\n(BTM), rather than a skin graft for ﬁbula donor\nsites.\n\nThis is an artiﬁcial skin substitute that helps\nthe wound heal.\n\nThere is a thin plastic layer covering the BTM.\nThe surgeon will take this off in the clinic. If\nyou notice it falling off, do not be alarmed.", "image": "/media/04-08-16.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-17", "module": 4, "deck": "Reconstructive surgery", "page": 17, "text": "How does BTM work?\nThe BTM forms a layer of\nhealing tissue called\ngranulation tissue over the\nwound bed.\n\nOnce this (granulation tissue)\nhas formed, the body forms\nskin over the BTM naturally.", "image": "/media/04-08-17.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-08-18", "module": 4, "deck": "Reconstructive surgery", "page": 18, "text": "How long will this healing\nprocess take?\nThis process can take several\nmonths, depending on the size\nof the defect.\n\nThis is an example of what it\nmay look like when it's healed.", "image": "/media/04-08-18.jpg", "url": "https://docs.google.com/presentation/d/1Q0tsclqjUzdSRWD6Y100zWGdThpM5mr1bRcDHQBmu30/view", "draft": true}, {"id": "04-09-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-09-01.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "What to expect after surgery—\ndrain tube\nThere will be a plastic surgical\ndrain tube placed in the wound\nat the time of surgery.\n\nThis is usually removed before\nyou leave the hospital. Drain tube", "image": "/media/04-09-02.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "What to expect after\n surgery– wound VAC\n There will also be a wound VAC placed\n on the donor site (the are the skin is\n taken from) in the hospital.\n\n Patients rarely go home with a wound\n VAC, so you don’t need to learn to\n manage it.\n\n*We have additional information on the wound VAC\nelsewhere", "image": "/media/04-09-03.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "When can I walk?\nYou can walk and bear weight immediately\nafter surgery, with assistance.\n\nImmediately after surgery, patients have\nmany monitors, drains, and IV lines attached\nto them-- it is easy to trip and fall.\n\nYou will need to be helped when getting\nout of bed while you are in the hospital,\nespecially while in the ICU.", "image": "/media/04-09-04.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "Will I have pain in my leg?\nThe pain from the ﬁbula ﬂap is usually\nless severe than people expect.\n\nUsually, it is more bothersome after\npatients start walking more at home,\nand it can linger for weeks or even\nmonths.", "image": "/media/04-09-05.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "How long will I have pain in\nmy leg?\nThis pain resolves with time, but\nsometimes it can take months or a\nyear.\n\nUsually, the pain is mild soreness and\nlasts about 6 months.\n\nIt is like having a sprained ankle", "image": "/media/04-09-06.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "Will I need physical therapy?\nPhysical therapy is sometimes needed, but not\nalways.\n\nGenerally, healthy, active people regain full\nmobility more quickly than patients who have a\nlower baseline level of mobility and activity prior to\nsurgery.\n\nUsually, active, healthy patients can walk without\nassistance (meaning without a cane or walker) in a\nfew weeks.", "image": "/media/04-09-07.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "Will the surgery affect my walking?\n The ﬁbula bone functions to provide stability to the ankle, in\n addition to the many ligaments of the ankle and foot that bind the\n different bones together.\n\n When the ﬁbula is removed, extra stress is placed on these\n ligaments.\n\n Over time, the ligaments strengthen and compensate for the loss of\n the ﬁbula.\n\n Until this happens, there will be some discomfort and instability.", "image": "/media/04-09-08.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "Will I have have mobility issues?\nPatients who have problems with strength or\nmobility pre-operatively may require weeks or\nmonths of using a walker or cane, along with\nphysical therapy.\n\nThis is not usually expected, but it is a possibility\nto prepare for.\n\nIt is very unusual to have any permanent\nmobility problems after a ﬁbula ﬂap, but healing\ncan be slow.", "image": "/media/04-09-09.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "Is leg swelling normal?\nSwelling in the ﬁbula ﬂap donor leg is\nquite common.\n\nIf you have any swelling in the legs\nbefore surgery, it is very likely you will\nhave more severe swelling in the\ndonor leg after surgery.\n\nThis is usually temporary", "image": "/media/04-09-10.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "What can I do to help\nthe swelling go down?\n\nYou can use an ACE wrap or\na compression stocking to\nhelp with this.", "image": "/media/04-09-11.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "How do I use the ACE wrap?\n Make sure to wrap the leg starting at the toes, around the\n foot, and ankle.\n\n The goal is to provide more compression to the foot and\n ankle than to the calf.\n\n Wrapping the leg without wrapping the ankle will lead to\n worsened swelling because ﬂuid will be trapped below the\n compression, in the ankle.\n\n*We have a leg dressing guide that provides more instructions on how to\nwrap the leg appropriately", "image": "/media/04-09-12.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "Scapula (Shoulder Blade)\n Flap", "image": "/media/04-09-13.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "Is the whole scapula\nused?\nWhen the scapula is needed for\nreconstruction, it is not removed in\nits entirety.\n\nOnly the edge of the bone or the tip\nof the scapula is taken, leaving most\nof the scapula intact.", "image": "/media/04-09-14.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "What will the incision look\nlike?\nThe incision will run along the ﬂank,\nfrom the axilla (under-arm) down\nabout 10 inches or so.\n\nThe donor site wound can usually be\nclosed completely, without a skin\ngraft.", "image": "/media/04-09-15.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "Will my shoulder function\nbe affected?\n It is rare to have permanent major\n functional problems from a scapula ﬂap.\n\n There will certainly be some soreness and\n stiffness, which may last several months.\n\n If necessary, we will arrange for physical\n therapy.", "image": "/media/04-09-16.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-09-17", "module": 4, "deck": "Reconstructive surgery", "page": 17, "text": "How sore or stiff will I feel after?\n The degree of soreness and stiffness depends on the\n amount of tissue that is needed for the reconstruction.\n\n Smaller tumors and smaller ﬂaps lead to less issues\n with recovery.\n\n Larger surgeries can have more lasting stiffness and\n soreness.", "image": "/media/04-09-17.jpg", "url": "https://docs.google.com/presentation/d/1NYOPK0a412Tg83ctwDFxqBLpeVTnKjf6VqSv_cGeXAw/view", "draft": true}, {"id": "04-10-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-10-01.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "Will I have drain tubes?\nTwo rubber drainage tubes are left\nin the ﬂank at the time of surgery to\ndrain ﬂuid that accumulates in the\nsurgical wound.\n\nUsually, one drain is removed after\nabout one week and the second\nusually stays with the patient after drain tube\nthey are discharged home.", "image": "/media/04-10-02.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "How do I take care of my drain?\n The drain needs to be emptied twice daily (or more\n depending on the amount of drainage) and the output needs\n to be recorded.\n\n The surgeon will want to know the daily output of the drain\n in milliliters (ML) for each 24-hour period.\n\n When the drain output is less than 50 ML per 24-hour\n period, it may be ready to be removed.", "image": "/media/04-10-03.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "Will ﬂuid accumulate after\nthe drain tube is removed?\nOccasionally, ﬂuid continues to accumulate\neven after the drain is removed.\n\nThis can lead to swelling of the skin that\nfeels soft, like a water balloon.\n\nWhen you stand up the swelling will drift\ndown to the lowest portion of the surgical\nsite.", "image": "/media/04-10-04.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "What should I do if ﬂuid accumulates\nafter the drain is removed?\n This ﬂuid (called a seroma) usually needs to be drained but\n the procedure is easy and usually done in the ofﬁce.\n\n The skin overlying the area is usually numb from the surgery\n and the ﬂuid can be drained through a small needle inserted\n through the skin.\n\n Sometimes this can require several drainage procedures if the\n ﬂuid keeps reaccumulating.", "image": "/media/04-10-05.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "How long can I wait to get the ﬂuid drained?\nThis is not urgent – you do not need to come in the same day for\nthis problem.\n\nWaiting even a week or two will be okay", "image": "/media/04-10-06.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "What wound care do I need\nto do for the scapula ﬂap?\nAside from drain care, all you need to do is\napply petroleum jelly (Vaseline or\nAquaphor) to the incision several times a\nday.\n\nThis is to keep it from scabbing or drying\nout.", "image": "/media/04-10-07.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "Reconstruction of Soft Tissue\n(No Bone is Reconstructed)\n\n Regional\n Skin Graft Reconstruction\n Forearm Thigh\n Flap Flap\n Local Click on the\n Reconstruction box to jump to\n each section", "image": "/media/04-10-08.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "Forearm Flap", "image": "/media/04-10-09.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "What is a forearm ﬂap?\nThe forearm ﬂap consists of skin from the inner\nsurface of the forearm, above the wrist.", "image": "/media/04-10-10.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "How does the hand receive\nblood after surgery?\nThe radial artery is the blood vessel that\nsupplies blood ﬂow to the forearm ﬂap,\nand it is removed with the ﬂap during\nsurgery.\n\nOnce this is removed, the ulnar artery is\nthe only vessel supplying blood to the\nhand.", "image": "/media/04-10-11.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "How do we make sure its safe?\nTo ensure the hand will be safe and have sufﬁcient blood ﬂow\nafter the ﬂap is taken, we do a simple, non-invasive test during\nthe clinic examination.\n\nIt is extremely rare to have an injury to the hand if this test\nlooks good.\n\nIf there is doubt as to the safety of performing a radial\nforearm ﬂap, we will choose a different type of ﬂap instead.", "image": "/media/04-10-12.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "Is any bone taken from my arm?\nOccasionally, bone is\nneeded from the radius\n(forearm bone).\n\nThis is not typical, and\nunless your surgeon has\ndiscussed this with you\nahead of time it is\nextremely unlikely.", "image": "/media/04-10-13.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "What about if bone is taken from my\narm?\n If bone is taken from this location, the part taken doesn't go\n through the whole bone.\n\n A partial thickness shaving is taken from the inner surface\n (About 40-50%).\n\n To strengthen the area, a metal plate is placed across the\n section where part of the bone was removed and held in\n place with screws.", "image": "/media/04-10-14.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "What is the plate made of?\nThe plate is made of titanium (like the\nmandible plate described in the lower jaw\nreconstruction section).\n\nClick here to go to the\nmandible plate slide\n\nTitanium does not react with the body or\ncause allergies.\n\nIt is not magnetic, so it is MRI compatible and\ndoes not set off metal detectors.", "image": "/media/04-10-15.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "Will I have hand\nweakness?\nThis procedure does cause some\ntemporary weakness of the hand,\nand it can take months to regain a\nstrong grip.\n\nThis is normal and physical therapy\ncan help.", "image": "/media/04-10-16.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-17", "module": 4, "deck": "Reconstructive surgery", "page": 17, "text": "Wound Healing– Forearm\n Usually, the forearm donor site cannot be closed, and it\n is necessary to skin graft the forearm.\n\n To help the skin graft heal, a special dressing, called a\n wound VAC, is placed over it for 6 days.\n\n Once this is removed, there is a light dressing over the\n skin graft that you will change daily.\n\n\n\n*We have a separate information packet on wound care for the donor site.", "image": "/media/04-10-17.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-18", "module": 4, "deck": "Reconstructive surgery", "page": 18, "text": "What happens if part of the graft doesn’t\nsurvive?\nOccasionally, some part of the skin graft does not\nsurvive.\n\nThis can lead to muscle or tendon exposure in the\narea on the forearm where the ﬂap was taken.\n\nGenerally, these issues heal without further\nsurgery\n Image to the left is a\n healed forearm graft", "image": "/media/04-10-18.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-19", "module": 4, "deck": "Reconstructive surgery", "page": 19, "text": "How do I care for my forearm donor site?\nWe have a separate information packet on wound care for\nthe donor site.", "image": "/media/04-10-19.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-10-20", "module": 4, "deck": "Reconstructive surgery", "page": 20, "text": "How do I take care of the wound?\n Management involves preventing the wound from drying\n out—Vaseline and a dressing that covers the wound are\n critical.\n\n If, during your care, you experience these wound issues, you\n will be provided with speciﬁc wound care instructions.\n\n Again, this type of wound almost always heals on its own\n and is not a major concern.", "image": "/media/04-10-20.jpg", "url": "https://docs.google.com/presentation/d/1dMOYBaPrItM-PS2NsvKm2_X0VoDuxKg3AbqDE4j1Kzo/view", "draft": true}, {"id": "04-11-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-11-01.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "Thigh Flap", "image": "/media/04-11-02.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "Where is the thigh ﬂap taken from?\nThe ﬂap is taken from the outside of the thigh.\n\nThe thigh ﬂap is based on a blood vessel that is not critical\nto the function of the leg.\n\nThere is no test necessary to check this blood vessel (in\ncontrast to the ﬁbula ﬂap and forearm ﬂap).", "image": "/media/04-11-03.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "Will I need a skin graft?\nSometimes small openings develop along\nthe incision line over the ﬁrst couple\nweeks.\n\nThis can generally be treated with\ndressings and wound care—it rarely\nrequires additional surgery.\n\nIf this happens, your surgeon will provide\nspeciﬁc instructions on how to care for it.", "image": "/media/04-11-04.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "How long will a drain be in my leg?\nA drainage tube is left in the thigh at the time\nof surgery. This tube is about ¼\" thick and is\nnecessary to drain ﬂuid that accumulates in\nthe thigh because of surgery.\n\nUsually, the drain stays in place for a couple\nof weeks and patients go home with this leg\ndrain.", "image": "/media/04-11-05.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "Drain Care\nThe nurses in the hospital will teach you how\nto care for your drain, which is an easy\nprocess.\n\n● The drain needs to be emptied twice daily\n (or more frequently depending on the\n amount of drainage) and the output needs to\n be recorded.\n\n● Your surgeon will want to know the daily\n output of the drain in milliliters (mL) for each\n 24-hour period.", "image": "/media/04-11-06.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "When can I get my drain\nremoved?\nWhen the drain output is less than 30-50\nML per 24-hour period, it may be ready\nto be removed.", "image": "/media/04-11-07.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "What if there is still ﬂuid\npost-drain removal?\nOccasionally, ﬂuid continues to accumulate\neven after the drain is removed. This can\nlead to swelling of the leg that feels soft,\nlike a water balloon. When you stand up the\nswelling will move down to above the knee.\n\nThis ﬂuid (called a seroma) usually needs to\nbe drained, but the procedure is easy and\ndone in the ofﬁce.", "image": "/media/04-11-08.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "How will the ﬂuid\n(seroma) be drained?\nThe skin overlying the area is usually\nnumb from the surgery and the ﬂuid can\nbe drained through a small needle\ninserted through the skin. Sometimes this\ncan require several drainage procedures if\nthe ﬂuid keeps reaccumulating.\n\nThis is not urgent – you do not need to\ncome in the same day for this problem.\nWaiting even a week or two will be ok.\nThe procedure is very minor and not\nbothersome for patients.", "image": "/media/04-11-09.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "What wound care do I\nneed to do for the\nthigh ﬂap?\nAside from drain care, all you\nneed to do is apply Vaseline or\nAquaphor to the incision several\ntimes a day to keep it from\nscabbing or drying out.", "image": "/media/04-11-10.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "What wound care do I need to do for the\nthigh ﬂap?\n Wrap your thigh with an ACE bandage, so\n that compression is applied to the leg.\n\n • This will help reduce the amount of\n ﬂuid draining from the thigh.\n\n • Avoid excessive pressure causing\n pain or knee swelling.", "image": "/media/04-11-11.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "I Can Manage Cancer\n\n\n\nHow long do I need to wrap my thigh?\nContinue using the ACE wrap for 1 month after surgery, even\nafter the drain is removed.\n\n● Wrap as much of the thigh as possible.\n\n● Another option is a full leg compression stocking.", "image": "/media/04-11-12.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "Skin Grafts", "image": "/media/04-11-13.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "What are skin grafts?\n● A thin sheet of skin shaved\n from one area and placed\n onto a wound somewhere\n else.\n● It is used for more\n surface-level wounds when\n the underlying tissue is\n healthy to support healing.\n● Take 2-3 weeks to fully heal.\n ○ Monitor both the donor\n and graft sites for\n infection", "image": "/media/04-11-14.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "Local Reconstruction", "image": "/media/04-11-15.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "What is local\nreconstruction?\n● This procedure uses tissue\n from around the surgical site\n (nearby skin or cells) to ﬁll a\n defect.\n● Generally a shorter surgery\n and quicker recovery\n ○ Mild bruising and\n swelling is common", "image": "/media/04-11-16.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-17", "module": 4, "deck": "Reconstructive surgery", "page": 17, "text": "Regional Reconstruction", "image": "/media/04-11-17.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-11-18", "module": 4, "deck": "Reconstructive surgery", "page": 18, "text": "What is regional\nreconstruction?\n● This procedure uses tissue\n from a nearby region (such as\n the chest muscle) which is\n rotated into the defect area.\n● This is ideal for larger defects\n and is more robust than a\n local reconstruction.\n ○ It may leave a visible scar\n on the chest or neck.\n ○ Drains may be in place to\n prevent buildup of ﬂuid.", "image": "/media/04-11-18.jpg", "url": "https://docs.google.com/presentation/d/12emnraD8DqM5oEw-2yKGF9UYO_WcEdw3hmgag1AmqUY/view", "draft": true}, {"id": "04-12-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-12-01.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "What to expect before, during, and\nafter the hospital\n\nFitness and What to After the\nPreparation hospital Click on the\n expect in box to jump\nfor Surgery and follow\n the to each\n hospital up section", "image": "/media/04-12-02.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "Other Questions About\nFitness and Preparation for\n Surgery", "image": "/media/04-12-03.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "Am I healthy enough to\nhave this surgery?\nReconstructive surgery can be lengthy,\nespecially when combined with surgery\nfor tumor removal.\n\nThis certainly does place stress on the\nbody.", "image": "/media/04-12-04.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "Am I healthy enough to\nhave this surgery?\nYour primary medical doctor (PCP) will be\nasked to provide a clearance note for you\nto undergo anesthesia/surgery.\n\nIf you have other medical problems, such\nas heart, lung, liver or kidney problems, a\nnote may be needed from additional\nspecialists, such as cardiologist, or\npulmonologist, if applicable.", "image": "/media/04-12-05.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "Am I too old to have this\nsurgery?\nMost of our patients are in their\n50’s-80’s.\n\nAge itself does not lead to complications\nand the overall health and functional\nstatus of the patient are more important\nindicators of ﬁtness and risk.", "image": "/media/04-12-06.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "Am I too old to have this\nsurgery?\nSome patients are in their 80’s and are\nquite healthy. Others may be younger\nand have signiﬁcant medical problems\nthat make surgery riskier.\n\nThe decision as to whether anesthesia\nand surgery are safe for a patient is made\nby a multidisciplinary team of surgeons,\nanesthesia personnel, and other\nspecialists.", "image": "/media/04-12-07.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "What can I do to prepare for surgery?\n I Can Manage Cancer\n\n\n\n\nThe most important thing leading up to surgery is to maintain\ngood nutrition to support wound healing and to avoid any\nactivities that worsen wound healing.", "image": "/media/04-12-08.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "Good nutrition requires\nprotein.\nProtein intake should be around 1.25-1.5 g of\nprotein per kilogram of bodyweight per day.\n\nSupplementing your diet with Boost, Ensure, or\nother protein supplements and vitamins is good,\nespecially if you have difﬁculty eating\npreoperatively.\n\nExcessive protein intake is not healthy, so it is a\ngood idea to work with a dietician to assist with\nnutrition.", "image": "/media/04-12-09.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "Supplements\nOne regular daily multivitamin is\nsufﬁcient and there is no need to\ntake additional supplements\nunless speciﬁcally instructed to\nby your doctor.\n\nSome herbal supplements can be\nharmful. Discuss any of these\nwith your surgeon before taking.", "image": "/media/04-12-10.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "Diabetes\nIf you have diabetes, make sure you are\ntaking all your medications as prescribed\nby your primary doctor.\n\nAvoid excessively fatty and sugary foods.", "image": "/media/04-12-11.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "Diabetes\nUncontrolled diabetes will\ncompromise your body’s ability to\nheal.\n\n● If you're not sure your medicine is\n right for you, talk to your primary\n doctor as soon as possible to\n make sure your diabetes is under\n control before surgery.\n\n● Also discuss any changes after\n discharge from the hospital with\n your primary doctor.", "image": "/media/04-12-12.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "Alcohol and tobacco\nuse prior to surgery\nIt is important to stop tobacco\nproducts (smoking, vaping, dipping,\ncigars, pipes, etc.) at least three\nweeks before surgery.\n\nSmoking impairs wound healing\nand increases the risk of\npostoperative complications.", "image": "/media/04-12-13.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "Alcohol and tobacco\nuse prior to surgery\nHeavy alcohol use can also cause\npostoperative complications\n\nIf you have more than one or two drinks\nper day, stopping all consumption of\nalcohol “cold turkey” can lead to\nwithdrawal symptoms.\n\n • It is best to wean yourself down\n over the course of a couple\n weeks.", "image": "/media/04-12-14.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "Alcohol and tobacco\nuse prior to surgery\nIf you are drinking daily before surgery,\nplease let us know.\n\nYou may require medication to help\nprevent alcohol withdrawal while\nyou’re in the hospital.\n\nThis is critical information for\nappropriate anesthesia and\npostoperative medications.", "image": "/media/04-12-15.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "Alcohol and tobacco\nuse prior to surgery\nSometimes it is difﬁcult for patients\nto be honest with their healthcare\nteam regarding their use of alcohol,\ntobacco, or other products.\n\nIt is important to be forthcoming\nwith this information so that we can\nmake sure you have the most\nappropriate care and best outcome.", "image": "/media/04-12-16.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-17", "module": 4, "deck": "Reconstructive surgery", "page": 17, "text": "What to Expect in the\n Hospital", "image": "/media/04-12-17.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-18", "module": 4, "deck": "Reconstructive surgery", "page": 18, "text": "Day of Surgery - Arrival\nYou will be asked to come to the hospital\nearly in the morning. The hospital will call\nyou the evening before surgery to tell you\nwhere to go and when to arrive.\n\nUsually, they want you to come in around\n5:30 AM.\n • This is to prepare you for\n anesthesia.\n\nYou will see the surgeons and\nanesthesiologists before going back to the\noperating room.", "image": "/media/04-12-18.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-19", "module": 4, "deck": "Reconstructive surgery", "page": 19, "text": "Day of Surgery – Start\nof Surgery\nOnce in the operating room you will\nundergo anesthesia. This takes 15-20\nminutes.\n\nThen once you are asleep, we will\nprepare you for the surgery by padding\nand positioning your body, inserting a\ncatheter into the bladder, and inserting\nseveral more IV lines.\n\nThen the surgical site will be cleaned\nwith antiseptics.", "image": "/media/04-12-19.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-20", "module": 4, "deck": "Reconstructive surgery", "page": 20, "text": "Day of Surgery – During\nSurgery\nBy the time we start the operation, it will be\naround 8:30.\n\nDepending on the surgery, it may be\nanywhere from 5 to 12 or more hours.\n\nA designated family member or friend will\nreceive updates from a nurse in the operating\nroom. The surgeons will talk to family/friends\nwhen they have completed their portions of\nthe procedure.", "image": "/media/04-12-20.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-12-21", "module": 4, "deck": "Reconstructive surgery", "page": 21, "text": "Day of Surgery – After\nSurgery\nAfter the procedure is completed, you will\nbe transferred to the ICU and will wake up\nslowly.\n\nYou may not remember anything from the\nnight immediately following surgery.\n\nYou may have a tracheostomy tube and\nfeeding tube in place (if your surgeon\ndiscussed this with you), as well as several\nsurgical drains in the neck and the area\nwhere the ﬂap was taken.", "image": "/media/04-12-21.jpg", "url": "https://docs.google.com/presentation/d/1y_CwSJ6M2lD9_KqQWSXBLDzFW_t77XWHZeE4oV_OL8s/view", "draft": true}, {"id": "04-13-01", "module": 4, "deck": "Reconstructive surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-13-01.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-02", "module": 4, "deck": "Reconstructive surgery", "page": 2, "text": "Hospital Stay I Can Manage Cancer\n\n\n\n\nYou will be in the hospital for about 10 days after free ﬂap surgery.\n\nSometimes this is longer or shorter depending on the type of surgery.", "image": "/media/04-13-02.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-03", "module": 4, "deck": "Reconstructive surgery", "page": 3, "text": "Why do I have to stay for ~10 days?\nThe main purpose of the length of stay is to make sure the surgical\nsites are healing and that the ﬂap is healthy.\n\nWound healing problems often do not arise until about 1 week after\nsurgery.\n\nThis is the main reason patients remain in the hospital so long.", "image": "/media/04-13-03.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-04", "module": 4, "deck": "Reconstructive surgery", "page": 4, "text": "Hospital Stay - ICU\nThe ﬁrst 3 days will be in the ICU.\n\nThis is not because you will be sick or\nunstable, but simply for close\nmonitoring.\n\nAfter this you will go to the regular\nﬂoor.", "image": "/media/04-13-04.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-05", "module": 4, "deck": "Reconstructive surgery", "page": 5, "text": "Hospital Stay – Care\nYou will receive physical therapy in the\nhospital. This becomes more in-depth\nafter you leave the ICU.\n\nYou will be helped out of bed to a chair\nthe ﬁrst day after surgery and your\nactivity will be increased from there.\n\nYou will receive teaching regarding any\nwound care, tracheostomy care, feeding\ntube, or drain care needs.", "image": "/media/04-13-05.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-06", "module": 4, "deck": "Reconstructive surgery", "page": 6, "text": "Rehab/Nursing Facility/\n\"Can I go home after the\nhospital?\nMost patients can go home after they\nleave the hospital.\n\n● But if a patient doesn’t have anyone\n to help them at home, we might\n arrange for them to stay at a skilled\n nursing facility until they can\n manage on their own.", "image": "/media/04-13-06.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-07", "module": 4, "deck": "Reconstructive surgery", "page": 7, "text": "Rehab/Nursing Facility/\n\"Can I go home after the\nhospital?\nPhysical therapists usually decide if a\npatient needs to go to a rehab center\nafter leaving the hospital.\n\n● They will check on you several times\n while you're in the hospital, and if\n they think you need rehab, we will\n start making plans for your stay.", "image": "/media/04-13-07.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-08", "module": 4, "deck": "Reconstructive surgery", "page": 8, "text": "Fistula and Wound Infection\nWhen you have surgery involving the mouth or throat, the wound is\nexposed to saliva.\n\nEven if the wounds are sutured perfectly, the body needs to take over\nand heal the wound or it will eventually open again.\n\nWound healing is more difﬁcult in the presence of saliva, but there is\nno way to keep it off of the wound.", "image": "/media/04-13-08.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-09", "module": 4, "deck": "Reconstructive surgery", "page": 9, "text": "Complications\nIf part of the incision opens, saliva can track into the incision and down\ninto the neck. This is called a ﬁstula and can cause infection.\n\nIf saliva is draining into blood vessels, it can cause them to clot or\nrupture, which can damage or kill a ﬂap.\n\nUsually, a ﬁstula does not occur until about 7-10 days after surgery.\n\n• If it does happen, we may simply watch it closely (if it is small) or it\n may require additional procedures to clean the wound, patch the\n leak or place new drains.", "image": "/media/04-13-09.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-10", "module": 4, "deck": "Reconstructive surgery", "page": 10, "text": "Flap Clotting\nA clot can form in the blood vessel feeding the ﬂap and kill the\nﬂap. While this is not the type of clot that can go to your lungs or\nbrain and be life threatening, it can necessitate more surgery.\n\nLuckily, this is rare and occurs in about 1 patient out of every 100\ncases.", "image": "/media/04-13-10.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-11", "module": 4, "deck": "Reconstructive surgery", "page": 11, "text": "Flap Clotting\nSpontaneous ﬂap clotting is most common the ﬁrst couple days\nafter surgery.\n\nAfter this it is rare unless there is a ﬁstula or infection around the\nﬂap vessels, so the risk increases again about a week after surgery,\nwhen ﬁstulas and infections tend to develop.", "image": "/media/04-13-11.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-12", "module": 4, "deck": "Reconstructive surgery", "page": 12, "text": "Flap Clotting Risks\nThe risks may be higher if you have a condition that leads to blood\nclotting.\n\n● Make sure your surgeon knows if you have ever had a blood\n clot in your legs or lungs or if blood clots run in your family.\n\n● Clotting disorders include Factor V Leiden, Prothrombin\n mutation, Protein C or S deﬁciency, elevated homocysteine,\n dysﬁbrinogenemia, and others. These are all rare but very\n important to know about.", "image": "/media/04-13-12.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-13", "module": 4, "deck": "Reconstructive surgery", "page": 13, "text": "Flap Checks\nFlap checks are done to assess the blood\nﬂow to the ﬂap and make sure the ﬂap is\nalive and healthy.\n\nA ﬂap check involves looking at the ﬂap\nskin to make sure it the appropriate\ncolor.\n• The skin should look like normal\n healthy skin.\n• If it is very dark or purple or extremely\n pale, this can be an indication of a\n problem.", "image": "/media/04-13-13.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-14", "module": 4, "deck": "Reconstructive surgery", "page": 14, "text": "Flap Checks\nA doppler stethoscope is also used to\nassess blood ﬂow to the ﬂap. This is a\nnon-invasive way to listen to the\npulsation of blood through the ﬂap.\n\nSometimes we will need to scratch the\nﬂap with a needle to assess the blood\nﬂow to the ﬂap.\n\nWhen this is done you will not feel pain\nfrom the needle stick because the ﬂap\nhas no sensation as it has been detached\nfrom all nerves.", "image": "/media/04-13-14.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-15", "module": 4, "deck": "Reconstructive surgery", "page": 15, "text": "After the Hospital and\n Follow Up", "image": "/media/04-13-15.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-16", "module": 4, "deck": "Reconstructive surgery", "page": 16, "text": "Follow-up\nYou will follow up in your\nreconstructive surgeon’s ofﬁce 1\nweek after discharge, then 2-3 weeks\nafter the initial post-op visit, then\nabout 2-3 months later, followed by\nanother 1-3 visits every 6 months.\n\nVisits may be more frequent if there\nare any wound care issues.\n\nYour cancer surgeon and other\ndoctors will have different schedules.", "image": "/media/04-13-16.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-17", "module": 4, "deck": "Reconstructive surgery", "page": 17, "text": "Medication Management\nIt is important to check in with your primary\ndoctor and any specialists, such as\ncardiologist, pulmonologist, endocrinologist,\nafter discharge from the hospital.\n\nSome of your routine medications may\nchange while you are healing and dosing\nmay be altered during and after the hospital\nadmission.", "image": "/media/04-13-17.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-13-18", "module": 4, "deck": "Reconstructive surgery", "page": 18, "text": "Medication Management\nIt is very important to re-establish care with\nyour normal medical doctors after\ndischarge.\n\nAs surgeons, we are not familiar with\nmanagement of most of these medications\nand can provide minimal assistance with\nquestions and concerns regarding\nmanagement of blood pressure, diabetes,\nneurological conditions, and other medical\nproblems.", "image": "/media/04-13-18.jpg", "url": "https://docs.google.com/presentation/d/1awi_ouLiVxO_jkJyZbmE6Wh2OhYxCCvj_inHsltytP4/view", "draft": true}, {"id": "04-14-001", "module": 4, "deck": "Reconstructive Surgery", "page": 1, "text": "Reconstructive Surgery and Free Flaps", "image": "/media/04-14-001.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-002", "module": 4, "deck": "Reconstructive Surgery", "page": 2, "text": "Sections in this Module\nBasic concepts,\ndeﬁnitions, and What to\nbackground Reconstruction Reconstruction expect before,\n when bone is of soft tissue\n involved: upper during, and\nFlap surgery (no bone is\n and lower jaw after the\ninvolving the reconstructed)\n (maxilla and hospital\ninside of the\nmouth mandible)\n\n\n Click on the box to jump to each section", "image": "/media/04-14-002.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-003", "module": 4, "deck": "Reconstructive Surgery", "page": 3, "text": "Basic Concepts, Deﬁnitions,\n and Background to Flaps", "image": "/media/04-14-003.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-004", "module": 4, "deck": "Reconstructive Surgery", "page": 4, "text": "What is a ﬂap?\nA ﬂap is a piece of tissue used to ﬁx a\nwound or cover a missing area after\nsurgery.\n\nA ﬂap is different from a graft because it\nhas its own blood supply (a graft does\nnot).\n\nBlood ﬂows into the ﬂap through an artery\nand out of the ﬂap through a vein to keep it\nalive.", "image": "/media/04-14-004.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-005", "module": 4, "deck": "Reconstructive Surgery", "page": 5, "text": "What can a ﬂap be made of?\n Soft tissue (skin, muscle, fat)\n\n Bone\n\n Both soft tissue and bone", "image": "/media/04-14-005.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-006", "module": 4, "deck": "Reconstructive Surgery", "page": 6, "text": "What is a graft?\nA graft is a piece of tissue used to repair\nor rebuild an area, but it does not have\nits own blood supply.\n\nA skin graft is very thin (like a piece of\npaper) and does not need blood vessels.\nIt can use oxygen and nutrients from the\ntissue it is placed on.\n\nBecause it is so thin, a skin graft is\nmostly used for surface repairs, not deep\nwounds.", "image": "/media/04-14-006.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-007", "module": 4, "deck": "Reconstructive Surgery", "page": 7, "text": "Bone or Cartilage Grafts\nSometimes bone or cartilage can\nbe used as a graft.\n\nBone or cartilage grafts are small\npieces without blood supply.\nThey get oxygen and nutrients\nfrom the soft tissue around them.", "image": "/media/04-14-007.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-008", "module": 4, "deck": "Reconstructive Surgery", "page": 8, "text": "Free Flap\nA free ﬂap is taken from a distant body part (like\nthe forearm or lower leg).\n\nBlood vessels are cut to move the ﬂap to the\nneeded area.\n\nThe ﬂap vessels are connected to blood vessels\nin the neck (artery to artery, vein to vein).\n\nThis process is like a transplant, but since it\ncomes from the patient’s own body, there is no\nrisk of rejection and no anti-rejection medications\nare needed.", "image": "/media/04-14-008.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-009", "module": 4, "deck": "Reconstructive Surgery", "page": 9, "text": "Pedicled Flap\nA pedicled ﬂap is taken from a nearby area (like the chest or shoulder).\n\nThe pedicled ﬂap stays attached to its original blood vessels.", "image": "/media/04-14-009.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-010", "module": 4, "deck": "Reconstructive Surgery", "page": 10, "text": "Key Differences Between Free\nFlaps and Pedicled Flaps\nA free ﬂap gives more freedom to shape\nand position the tissue.\n\nWhen bone is needed a free ﬂap is\nusually necessary (unless the piece of\nbone is very small).", "image": "/media/04-14-010.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-011", "module": 4, "deck": "Reconstructive Surgery", "page": 11, "text": "Situations When the Free\nFlap is a Better Option than\nthe Pedicled Flap or Graft\n A skin graft may be too thin and not\n work well for deep wounds.\n\n Skin grafts in the mouth can cause\n scarring and limit tongue\n movement.\n\n Skin grafts cannot be placed directly\n on bone because bone does not\n provide enough blood supply.", "image": "/media/04-14-011.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-012", "module": 4, "deck": "Reconstructive Surgery", "page": 12, "text": "Situations When the Free\nFlap is a Better Option than\nthe Pedicled Flap or Graft\n\n Grafts may not heal well if the area\n has had or will have radiation\n therapy.\n\n A pedicled ﬂap may be too thick or\n not reach the area needing repair.", "image": "/media/04-14-012.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-013", "module": 4, "deck": "Reconstructive Surgery", "page": 13, "text": "Flap Surgery Involving the\n Inside of the Mouth", "image": "/media/04-14-013.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-014", "module": 4, "deck": "Reconstructive Surgery", "page": 14, "text": "Flap Surgery Involving the Inside I Can Manage Cancer\n\n\nof the Mouth or Throat\nHow does surgery affect eating, drinking, and breathing?\n\nThe mouth and throat are important for eating, drinking,\nspeaking, and breathing.\n\nSurgery in these areas can cause swelling, which may\nmake it hard to breathe, sometimes requiring a\ntemporary tracheostomy tube (a breathing tube in the\nneck).\n\nIt can also affect the ability to swallow food and liquids,\nmaking a feeding tube necessary during healing.", "image": "/media/04-14-014.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-015", "module": 4, "deck": "Reconstructive Surgery", "page": 15, "text": "I Can Manage Cancer\nWhen can I eat by mouth?\nThe flap (usually skin) is stitched into place to repair the surgical\nwound in the mouth. Stitches dissolve in about a month, but healing\ntakes 2 to 3 weeks or longer. The wound must be fully sealed to\nprevent saliva from leaking into the wound. Your surgeon will decide\nwhen it is safe for you to start eating and drinking again.", "image": "/media/04-14-015.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-016", "module": 4, "deck": "Reconstructive Surgery", "page": 16, "text": "Can I swallow my own\nsaliva while I am healing, or\nshould I spit it out?\nYes, you can swallow your saliva.\n\nIt is not recommended to constantly\nspit or suction it out, unless you\ncannot swallow. This could cause\ndehydration over time.", "image": "/media/04-14-016.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-017", "module": 4, "deck": "Reconstructive Surgery", "page": 17, "text": "Reconstruction When Bone is Involved\nLower Jaw Upper Jaw/ Fibula Scapula\n(Mandible) Midface Flap (Shoulder\n (Maxilla) Blade)\n Flap\n\n\n\n Click on the box to jump to each section", "image": "/media/04-14-017.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-018", "module": 4, "deck": "Reconstructive Surgery", "page": 18, "text": "Lower Jaw (Mandible)\n Reconstruction", "image": "/media/04-14-018.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-019", "module": 4, "deck": "Reconstructive Surgery", "page": 19, "text": "I Can Manage Cancer\nLower Jaw (Mandible)\nReconstruction\nWhy is a free flap used to repair the lower jaw?\n\nReconstructing the lower jaw usually requires a\nfree flap because these cancers need radiation\ntherapy after surgery to prevent the cancer from\nreturning.\n\nRadiation would destroy a bone graft because\nthe graft does not have a blood supply, but the\nfree flap does have blood supply.", "image": "/media/04-14-019.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-020", "module": 4, "deck": "Reconstructive Surgery", "page": 20, "text": "I Can Manage Cancer\n\nLower Jaw (Mandible) Reconstruction Continued\nAlso, a free flap is used when there is a gap in the bone bigger than about\n5 cm (2 inches) because larger grafts may not survive.\n\nThe bone-containing flaps that are commonly used for jaw reconstruction\nare the fibula, scapula, and a small amount from the radius/forearm flaps\n(AKA osteocutaneous radial forearm free flap).", "image": "/media/04-14-020.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-021", "module": 4, "deck": "Reconstructive Surgery", "page": 21, "text": "Which type of ﬂap will be used\nfor the mandible? The ﬁbula\nﬂap\nSurgeons usually use the ﬁbula ﬂap to\nrebuild the jaw. The ﬁbula is a strong\nbone in the lower leg that can be\nshaped to ﬁt the jaw.\n\nWe also take some soft tissue (skin, fat,\nand fascia) from the leg to help with the\nreconstruction.", "image": "/media/04-14-021.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-022", "module": 4, "deck": "Reconstructive Surgery", "page": 22, "text": "The Fibula Flap Continued\nThe ﬁbula’s blood vessels are long,\nwhich helps position the new jaw\ncorrectly.\n\nAnother beneﬁt is that while one\nsurgeon removes the tumor, another\ncan prepare the ﬁbula ﬂap at the same\ntime. This can save 1 to 2 hours in\nsurgery.", "image": "/media/04-14-022.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-023", "module": 4, "deck": "Reconstructive Surgery", "page": 23, "text": "The Scapula Flap\nAnother option is the scapula ﬂap (from\nthe shoulder blade). However, since it's on\nthe back, it takes more time in surgery\nbecause surgeons can’t work on it at the\nsame time as tumor removal.\n\nThe scapula ﬂap is often used if the lower\nleg isn’t healthy enough for a ﬁbula ﬂap.\nThis is because leg arteries can have more\nblockage (atherosclerosis), while the\nscapula’s artery is usually healthier.", "image": "/media/04-14-023.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-024", "module": 4, "deck": "Reconstructive Surgery", "page": 24, "text": "The Scapula Flap Continued\nUnlike the ﬁbula ﬂap, the scapula ﬂap\ndoesn’t need a special scan (CT\nangiogram) to check blood ﬂow because\nthe artery for the scapula ﬂap is not vital\nto any other body part.\n\nThe scapula ﬂap is also a better choice\nwhen a lot of soft tissue is needed, as it\nprovides more skin and muscle than the\nﬁbula.", "image": "/media/04-14-024.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-025", "module": 4, "deck": "Reconstructive Surgery", "page": 25, "text": "Other Options for Jaw Reconstruction- I Can Manage Cancer\n\n\n\n\nthe Radial Forearm Flap\nAnother option is the radial forearm flap (from the inner forearm). This\nflap includes a thin piece of bone, so it’s not usually the first choice for\nthe jaw. Instead, it’s often used for reconstructing the upper jaw,\ncheekbones, or eye sockets.", "image": "/media/04-14-025.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-026", "module": 4, "deck": "Reconstructive Surgery", "page": 26, "text": "How is the ﬂap bone connected\nto the jaw?\nA titanium plate is used to connect the pieces\nof bone together. This plate spans the gap\nacross the mandible where the tumor was\nremoved.\n\nThe plate is screwed into the remaining parts\nof the mandible as well as the bone of the\nﬂap after it is shaped to ﬁt the defect.", "image": "/media/04-14-026.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-027", "module": 4, "deck": "Reconstructive Surgery", "page": 27, "text": "The Titanium Plate Continued\nThe size and position of a mandible\nresection depends on the location of the\ntumor, but this is an example of a large\nreconstruction plate.\n\nEvery resection is a little different. In this\ncase, the entire chin is being removed. The\nbone that needs to be removed is\ndetermined by the cancer surgeon, based\non the location and size of the tumor.\n Click here to return to\n forearm ﬂap slide 81", "image": "/media/04-14-027.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-028", "module": 4, "deck": "Reconstructive Surgery", "page": 28, "text": "I Can Manage Cancer\n\nIs the titanium plate\nsafe?\nYes, the titanium plate is safe and\nstays in the body permanently for\nmost patients.\n\nIt does not cause allergies or\nreactions and cannot be rejected by\nthe body.", "image": "/media/04-14-028.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-029", "module": 4, "deck": "Reconstructive Surgery", "page": 29, "text": "Is the titanium plate safe?\nContinued\nThe titanium plate is not magnetic,\nso it won’t set off metal detectors\nand is safe for MRIs.\n\nOccasionally, the plate can become\ninfected over time (rarely) and need\nto be removed. Another rare\ncomplication is when the plate\nbecomes loose over time, requiring\nremoval, or the plate breaks. These\nsituations are rare.", "image": "/media/04-14-029.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-030", "module": 4, "deck": "Reconstructive Surgery", "page": 30, "text": "Soft Tissue Repair in the\nTongue, Cheek, or Under the\nTongue\nIf there is a soft tissue defect in the\ntongue, cheek, or under the tongue (ﬂoor\nof the mouth) some skin or muscle from\nthe ﬂap is sutured in place to patch the\nsoft tissue defect.\n\nThe sutures will all dissolve on their own.", "image": "/media/04-14-030.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-031", "module": 4, "deck": "Reconstructive Surgery", "page": 31, "text": "Will I look like myself after mandible reconstruction\nsurgery or will I be disﬁgured?\nFor most patients, the changes to appearance after mandible\nreconstruction are minimal. Signiﬁcant changes are rare and usually only\nhappen if the tumor or wound affects the external skin or soft tissue of the\nface or neck. This is typically seen in very large tumors.", "image": "/media/04-14-031.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-032", "module": 4, "deck": "Reconstructive Surgery", "page": 32, "text": "I Can Manage Cancer\nWill I have visible scars?\nGenerally, this surgery is done through the inside of the mouth and an\nincision on the neck. It is not usually necessary to place any scars on\nthe face unless the tumor is invading the skin of the face or neck (this\nis not common).", "image": "/media/04-14-032.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-033", "module": 4, "deck": "Reconstructive Surgery", "page": 33, "text": "I Can Manage Cancer\nWill I have visible scars?\nA neck incision is necessary to find blood\nvessels in the neck to re-establish blood\nflow to the flap. These neck incisions\nheal very well and leave a faint scar that\nis generally not obvious after it heals.\n\nUsually, lymph nodes need to be\nremoved from the neck as part of the\ncancer surgery. The same neck incision\nis used for this as well.", "image": "/media/04-14-033.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-034", "module": 4, "deck": "Reconstructive Surgery", "page": 34, "text": "I Can Manage Cancer\nWill my face shape change?\nThe shape of the reconstructed mandible\nis based on the shape of each individual\npatient’s jaw. The titanium plate is\ncustom made to each patient’s anatomy.\n\nIt is not possible to make the new jaw the\nexact same shape as the patient's\nnatural jaw, however, the changes are\nusually subtle once healing is complete", "image": "/media/04-14-034.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-035", "module": 4, "deck": "Reconstructive Surgery", "page": 35, "text": "Swelling of the Face and Neck\nSwelling of the face and neck is normal\nand expected after surgery. Usually, this\nswelling is the worst 3 days after the\nsurgery and then gradually improves\nover the next several weeks to months.\n\nSwelling may come and go at times- this\nis normal.", "image": "/media/04-14-035.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-036", "module": 4, "deck": "Reconstructive Surgery", "page": 36, "text": "I Can Manage Cancer\n\nWhen is swelling the worst?\nSometimes patients find that swelling is worse in the morning when\nthey wake up – because they have been lying down all night. If this is\nthe case, sleep with your head elevated on extra pillows, or even in a\nreclining chair if necessary. Sometimes patients notice swelling\nincreases throughout the day, and it is better in the morning.", "image": "/media/04-14-036.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-037", "module": 4, "deck": "Reconstructive Surgery", "page": 37, "text": "When should I be worried about\nswelling?\nIf swelling is gradually worsening over\nseveral consecutive days, this may be a cause\nfor concern, especially if there is also\nincreased pain, redness of the neck or face, or\ndrainage of pus from incisions or drain tubes.\n\nThe presence of fevers and/or chills is a\nwarning sign as well. Talk to your surgical\nteam.", "image": "/media/04-14-037.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-038", "module": 4, "deck": "Reconstructive Surgery", "page": 38, "text": "Is this surgery painful?\n\nThis type of facial surgery is generally\nless painful than most patients expect.\nThere is certainly some pain, but it is\nusually well controlled with pain\nmedicine.\n\nThere may be some pain that comes and\ngoes. Pain may be worse at certain times\nof day and some days may be worse\nthan others. This is normal.", "image": "/media/04-14-038.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-039", "module": 4, "deck": "Reconstructive Surgery", "page": 39, "text": "I Can Manage Cancer\n\n\nWhen is pain concerning?\nPain is worrisome if it is continually\nincreasing over several days.\nEspecially if there is also\nfevers/chills, swelling that is\ngradually increasing over several\ndays, or any new drainage from any\nincisions.", "image": "/media/04-14-039.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-040", "module": 4, "deck": "Reconstructive Surgery", "page": 40, "text": "Upper Jaw / Midface\n Reconstruction", "image": "/media/04-14-040.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-041", "module": 4, "deck": "Reconstructive Surgery", "page": 41, "text": "Upper Jaw/Midface (Maxilla)\nReconstruction\nMaxillary reconstruction is similar to\nmandible reconstruction in many ways.\n\nThe bones are smaller than the mandible,\nso while titanium plates are still used to\njoin the bone segments together, these are\nsmaller than the plates used for mandible\nreconstruction.\n\nPlates are still usually custom made for\neach individual patient.", "image": "/media/04-14-041.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-042", "module": 4, "deck": "Reconstructive Surgery", "page": 42, "text": "Upper Jaw/Midface (Maxilla) Reconstruction Continued\n\nOther than these differences, the details of the mandible\nreconstruction section above apply to patients who are undergoing\nmaxillary reconstruction.", "image": "/media/04-14-042.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-043", "module": 4, "deck": "Reconstructive Surgery", "page": 43, "text": "Fibula Flap", "image": "/media/04-14-043.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-044", "module": 4, "deck": "Reconstructive Surgery", "page": 44, "text": "The Fibula Flap. How is the\nﬁbula used for reconstruction?\n\nThe ﬁbula is the smaller of the two lower\nleg bones (the larger bone is the tibia).\n\nIt can be safely removed and used for\nreconstruction. The central part of the\nﬁbula is removed, saving the bottom 3-4\ninches by the ankle, and a similar length\nby the knee.", "image": "/media/04-14-044.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-045", "module": 4, "deck": "Reconstructive Surgery", "page": 45, "text": "Will this affect blood ﬂow to\nmy leg?\nThe lower leg has 3 arteries that carry blood\ndown to the foot. The artery called the\nperoneal artery supplies the ﬁbula ﬂap.\n\nBecause the leg has 3 main arteries, and if\nthe other two arteries are healthy, blood\nﬂow to the foot remains normal after\nsurgery.", "image": "/media/04-14-045.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-046", "module": 4, "deck": "Reconstructive Surgery", "page": 46, "text": "How do we make sure it’s\nsafe?\nWe will check your pulses on your foot and\norder a scan called a CT Angiogram, which\nexamines the arteries in the legs.\n\nWe do this to make sure that it is safe to take\nthe peroneal vessels supplying the ﬁbula ﬂap\nwithout hurting the circulation to the foot.", "image": "/media/04-14-046.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-047", "module": 4, "deck": "Reconstructive Surgery", "page": 47, "text": "What will my leg look like\nafter surgery?\nIf no skin is needed for reconstruction,\nyou will have a in scar, in a straight line,\nrunning down the outside of the calf,\nfrom below the knee to above the\nankle.\n\nThe example on the right shows a scar\nafter two weeks of healing—this is not\nthe ﬁnal result.", "image": "/media/04-14-047.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-048", "module": 4, "deck": "Reconstructive Surgery", "page": 48, "text": "What happens if skin is needed for\nreconstruction?\n If skin is necessary for reconstruction, the resulting skin wound\n usually cannot be closed. This leaves a shallow, open wound, with\n exposed muscle, after the ﬂap is taken.\n\n To repair this, we may take a skin graft from the thigh. This skin\n graft is paper thin and is used to patch the leg wound.\n\n It will always look somewhat like a patch, but the color will even out\n over time, and the scars will fade and become smooth.", "image": "/media/04-14-048.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-049", "module": 4, "deck": "Reconstructive Surgery", "page": 49, "text": "What are my other options\nfor a skin graft?\nMore commonly, we are now using a skin\nsubstitute called biodegradable tissue matrix\n(BTM), rather than a skin graft for ﬁbula donor\nsites.\n\nThis is an artiﬁcial skin substitute that helps\nthe wound heal.\n\nThere is a thin plastic layer covering the BTM.\nThe surgeon will take this off in the clinic. If\nyou notice it falling off, do not be alarmed.", "image": "/media/04-14-049.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-050", "module": 4, "deck": "Reconstructive Surgery", "page": 50, "text": "How does BTM work?\nThe BTM forms a layer of\nhealing tissue called\ngranulation tissue over the\nwound bed.\n\nOnce this (granulation tissue)\nhas formed, the body forms\nskin over the BTM naturally.", "image": "/media/04-14-050.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-051", "module": 4, "deck": "Reconstructive Surgery", "page": 51, "text": "How long will this healing\nprocess take?\nThis process can take several\nmonths, depending on the size\nof the defect.\n\nThis is an example of what it\nmay look like when it's healed.", "image": "/media/04-14-051.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-052", "module": 4, "deck": "Reconstructive Surgery", "page": 52, "text": "What to expect after surgery—\ndrain tube\nThere will be a plastic surgical\ndrain tube placed in the wound\nat the time of surgery.\n\nThis is usually removed before\nyou leave the hospital. Drain tube", "image": "/media/04-14-052.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-053", "module": 4, "deck": "Reconstructive Surgery", "page": 53, "text": "What to expect after\n surgery– wound VAC\n There will also be a wound VAC placed\n on the donor site (the are the skin is\n taken from) in the hospital.\n\n Patients rarely go home with a wound\n VAC, so you don’t need to learn to\n manage it.\n\n*We have additional information on the wound VAC\nelsewhere", "image": "/media/04-14-053.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-054", "module": 4, "deck": "Reconstructive Surgery", "page": 54, "text": "When can I walk?\nYou can walk and bear weight immediately\nafter surgery, with assistance.\n\nImmediately after surgery, patients have\nmany monitors, drains, and IV lines attached\nto them-- it is easy to trip and fall.\n\nYou will need to be helped when getting\nout of bed while you are in the hospital,\nespecially while in the ICU.", "image": "/media/04-14-054.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-055", "module": 4, "deck": "Reconstructive Surgery", "page": 55, "text": "Will I have pain in my leg?\nThe pain from the ﬁbula ﬂap is usually\nless severe than people expect.\n\nUsually, it is more bothersome after\npatients start walking more at home,\nand it can linger for weeks or even\nmonths.", "image": "/media/04-14-055.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-056", "module": 4, "deck": "Reconstructive Surgery", "page": 56, "text": "How long will I have pain in\nmy leg?\nThis pain resolves with time, but\nsometimes it can take months or a\nyear.\n\nUsually, the pain is mild soreness and\nlasts about 6 months.\n\nIt is like having a sprained ankle", "image": "/media/04-14-056.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-057", "module": 4, "deck": "Reconstructive Surgery", "page": 57, "text": "Will I need physical therapy?\nPhysical therapy is sometimes needed, but not\nalways.\n\nGenerally, healthy, active people regain full\nmobility more quickly than patients who have a\nlower baseline level of mobility and activity prior to\nsurgery.\n\nUsually, active, healthy patients can walk without\nassistance (meaning without a cane or walker) in a\nfew weeks.", "image": "/media/04-14-057.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-058", "module": 4, "deck": "Reconstructive Surgery", "page": 58, "text": "Will the surgery affect my walking?\n The ﬁbula bone functions to provide stability to the ankle, in\n addition to the many ligaments of the ankle and foot that bind the\n different bones together.\n\n When the ﬁbula is removed, extra stress is placed on these\n ligaments.\n\n Over time, the ligaments strengthen and compensate for the loss of\n the ﬁbula.\n\n Until this happens, there will be some discomfort and instability.", "image": "/media/04-14-058.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-059", "module": 4, "deck": "Reconstructive Surgery", "page": 59, "text": "Will I have have mobility issues?\nPatients who have problems with strength or\nmobility pre-operatively may require weeks or\nmonths of using a walker or cane, along with\nphysical therapy.\n\nThis is not usually expected, but it is a possibility\nto prepare for.\n\nIt is very unusual to have any permanent\nmobility problems after a ﬁbula ﬂap, but healing\ncan be slow.", "image": "/media/04-14-059.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-060", "module": 4, "deck": "Reconstructive Surgery", "page": 60, "text": "Is leg swelling normal?\nSwelling in the ﬁbula ﬂap donor leg is\nquite common.\n\nIf you have any swelling in the legs\nbefore surgery, it is very likely you will\nhave more severe swelling in the\ndonor leg after surgery.\n\nThis is usually temporary", "image": "/media/04-14-060.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-061", "module": 4, "deck": "Reconstructive Surgery", "page": 61, "text": "What can I do to help\nthe swelling go down?\n\nYou can use an ACE wrap or\na compression stocking to\nhelp with this.", "image": "/media/04-14-061.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-062", "module": 4, "deck": "Reconstructive Surgery", "page": 62, "text": "How do I use the ACE wrap?\n Make sure to wrap the leg starting at the toes, around the\n foot, and ankle.\n\n The goal is to provide more compression to the foot and\n ankle than to the calf.\n\n Wrapping the leg without wrapping the ankle will lead to\n worsened swelling because ﬂuid will be trapped below the\n compression, in the ankle.\n\n*We have a leg dressing guide that provides more instructions on how to\nwrap the leg appropriately", "image": "/media/04-14-062.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-063", "module": 4, "deck": "Reconstructive Surgery", "page": 63, "text": "Scapula (Shoulder Blade)\n Flap", "image": "/media/04-14-063.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-064", "module": 4, "deck": "Reconstructive Surgery", "page": 64, "text": "Is the whole scapula\nused?\nWhen the scapula is needed for\nreconstruction, it is not removed in\nits entirety.\n\nOnly the edge of the bone or the tip\nof the scapula is taken, leaving most\nof the scapula intact.", "image": "/media/04-14-064.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-065", "module": 4, "deck": "Reconstructive Surgery", "page": 65, "text": "What will the incision look\nlike?\nThe incision will run along the ﬂank,\nfrom the axilla (under-arm) down\nabout 10 inches or so.\n\nThe donor site wound can usually be\nclosed completely, without a skin\ngraft.", "image": "/media/04-14-065.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-066", "module": 4, "deck": "Reconstructive Surgery", "page": 66, "text": "Will my shoulder function\nbe affected?\n It is rare to have permanent major\n functional problems from a scapula ﬂap.\n\n There will certainly be some soreness and\n stiffness, which may last several months.\n\n If necessary, we will arrange for physical\n therapy.", "image": "/media/04-14-066.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-067", "module": 4, "deck": "Reconstructive Surgery", "page": 67, "text": "How sore or stiff will I feel after?\n The degree of soreness and stiffness depends on the\n amount of tissue that is needed for the reconstruction.\n\n Smaller tumors and smaller ﬂaps lead to less issues\n with recovery.\n\n Larger surgeries can have more lasting stiffness and\n soreness.", "image": "/media/04-14-067.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-068", "module": 4, "deck": "Reconstructive Surgery", "page": 68, "text": "Will I have drain tubes?\nTwo rubber drainage tubes are left\nin the ﬂank at the time of surgery to\ndrain ﬂuid that accumulates in the\nsurgical wound.\n\nUsually, one drain is removed after\nabout one week and the second\nusually stays with the patient after drain tube\nthey are discharged home.", "image": "/media/04-14-068.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-069", "module": 4, "deck": "Reconstructive Surgery", "page": 69, "text": "How do I take care of my drain?\n The drain needs to be emptied twice daily (or more\n depending on the amount of drainage) and the output needs\n to be recorded.\n\n The surgeon will want to know the daily output of the drain\n in milliliters (ML) for each 24-hour period.\n\n When the drain output is less than 50 ML per 24-hour\n period, it may be ready to be removed.", "image": "/media/04-14-069.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-070", "module": 4, "deck": "Reconstructive Surgery", "page": 70, "text": "Will ﬂuid accumulate after\nthe drain tube is removed?\nOccasionally, ﬂuid continues to accumulate\neven after the drain is removed.\n\nThis can lead to swelling of the skin that\nfeels soft, like a water balloon.\n\nWhen you stand up the swelling will drift\ndown to the lowest portion of the surgical\nsite.", "image": "/media/04-14-070.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-071", "module": 4, "deck": "Reconstructive Surgery", "page": 71, "text": "What should I do if ﬂuid accumulates\nafter the drain is removed?\n This ﬂuid (called a seroma) usually needs to be drained but\n the procedure is easy and usually done in the ofﬁce.\n\n The skin overlying the area is usually numb from the surgery\n and the ﬂuid can be drained through a small needle inserted\n through the skin.\n\n Sometimes this can require several drainage procedures if the\n ﬂuid keeps reaccumulating.", "image": "/media/04-14-071.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-072", "module": 4, "deck": "Reconstructive Surgery", "page": 72, "text": "How long can I wait to get the ﬂuid drained?\nThis is not urgent – you do not need to come in the same day for\nthis problem.\n\nWaiting even a week or two will be okay", "image": "/media/04-14-072.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-073", "module": 4, "deck": "Reconstructive Surgery", "page": 73, "text": "What wound care do I need\nto do for the scapula ﬂap?\nAside from drain care, all you need to do is\napply petroleum jelly (Vaseline or\nAquaphor) to the incision several times a\nday.\n\nThis is to keep it from scabbing or drying\nout.", "image": "/media/04-14-073.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-074", "module": 4, "deck": "Reconstructive Surgery", "page": 74, "text": "Reconstruction of Soft Tissue\n(No Bone is Reconstructed)\n\n Regional\n Skin Graft Reconstruction\n Forearm Thigh\n Flap Flap\n Local Click on the\n Reconstruction box to jump to\n each section", "image": "/media/04-14-074.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-075", "module": 4, "deck": "Reconstructive Surgery", "page": 75, "text": "Forearm Flap", "image": "/media/04-14-075.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-076", "module": 4, "deck": "Reconstructive Surgery", "page": 76, "text": "What is a forearm ﬂap?\nThe forearm ﬂap consists of skin from the inner\nsurface of the forearm, above the wrist.", "image": "/media/04-14-076.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-077", "module": 4, "deck": "Reconstructive Surgery", "page": 77, "text": "How does the hand receive\nblood after surgery?\nThe radial artery is the blood vessel that\nsupplies blood ﬂow to the forearm ﬂap,\nand it is removed with the ﬂap during\nsurgery.\n\nOnce this is removed, the ulnar artery is\nthe only vessel supplying blood to the\nhand.", "image": "/media/04-14-077.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-078", "module": 4, "deck": "Reconstructive Surgery", "page": 78, "text": "How do we make sure its safe?\nTo ensure the hand will be safe and have sufﬁcient blood ﬂow\nafter the ﬂap is taken, we do a simple, non-invasive test during\nthe clinic examination.\n\nIt is extremely rare to have an injury to the hand if this test\nlooks good.\n\nIf there is doubt as to the safety of performing a radial\nforearm ﬂap, we will choose a different type of ﬂap instead.", "image": "/media/04-14-078.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-079", "module": 4, "deck": "Reconstructive Surgery", "page": 79, "text": "Is any bone taken from my arm?\nOccasionally, bone is\nneeded from the radius\n(forearm bone).\n\nThis is not typical, and\nunless your surgeon has\ndiscussed this with you\nahead of time it is\nextremely unlikely.", "image": "/media/04-14-079.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-080", "module": 4, "deck": "Reconstructive Surgery", "page": 80, "text": "What about if bone is taken from my\narm?\n If bone is taken from this location, the part taken doesn't go\n through the whole bone.\n\n A partial thickness shaving is taken from the inner surface\n (About 40-50%).\n\n To strengthen the area, a metal plate is placed across the\n section where part of the bone was removed and held in\n place with screws.", "image": "/media/04-14-080.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-081", "module": 4, "deck": "Reconstructive Surgery", "page": 81, "text": "What is the plate made of?\nThe plate is made of titanium (like the\nmandible plate described in the lower jaw\nreconstruction section).\n\nClick here to go to the\nmandible plate slide\n\nTitanium does not react with the body or\ncause allergies.\n\nIt is not magnetic, so it is MRI compatible and\ndoes not set off metal detectors.", "image": "/media/04-14-081.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-082", "module": 4, "deck": "Reconstructive Surgery", "page": 82, "text": "Will I have hand\nweakness?\nThis procedure does cause some\ntemporary weakness of the hand,\nand it can take months to regain a\nstrong grip.\n\nThis is normal and physical therapy\ncan help.", "image": "/media/04-14-082.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-083", "module": 4, "deck": "Reconstructive Surgery", "page": 83, "text": "Wound Healing– Forearm\n Usually, the forearm donor site cannot be closed, and it\n is necessary to skin graft the forearm.\n\n To help the skin graft heal, a special dressing, called a\n wound VAC, is placed over it for 6 days.\n\n Once this is removed, there is a light dressing over the\n skin graft that you will change daily.\n\n\n\n*We have a separate information packet on wound care for the donor site.", "image": "/media/04-14-083.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-084", "module": 4, "deck": "Reconstructive Surgery", "page": 84, "text": "What happens if part of the graft doesn’t\nsurvive?\nOccasionally, some part of the skin graft does not\nsurvive.\n\nThis can lead to muscle or tendon exposure in the\narea on the forearm where the ﬂap was taken.\n\nGenerally, these issues heal without further\nsurgery\n Image to the left is a\n healed forearm graft", "image": "/media/04-14-084.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-085", "module": 4, "deck": "Reconstructive Surgery", "page": 85, "text": "How do I care for my forearm donor site?\nWe have a separate information packet on wound care for\nthe donor site.", "image": "/media/04-14-085.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-086", "module": 4, "deck": "Reconstructive Surgery", "page": 86, "text": "How do I take care of the wound?\n Management involves preventing the wound from drying\n out—Vaseline and a dressing that covers the wound are\n critical.\n\n If, during your care, you experience these wound issues, you\n will be provided with speciﬁc wound care instructions.\n\n Again, this type of wound almost always heals on its own\n and is not a major concern.", "image": "/media/04-14-086.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-087", "module": 4, "deck": "Reconstructive Surgery", "page": 87, "text": "Thigh Flap", "image": "/media/04-14-087.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-088", "module": 4, "deck": "Reconstructive Surgery", "page": 88, "text": "Where is the thigh ﬂap taken from?\nThe ﬂap is taken from the outside of the thigh.\n\nThe thigh ﬂap is based on a blood vessel that is not critical\nto the function of the leg.\n\nThere is no test necessary to check this blood vessel (in\ncontrast to the ﬁbula ﬂap and forearm ﬂap).", "image": "/media/04-14-088.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-089", "module": 4, "deck": "Reconstructive Surgery", "page": 89, "text": "Will I need a skin graft?\nSometimes small openings develop along\nthe incision line over the ﬁrst couple\nweeks.\n\nThis can generally be treated with\ndressings and wound care—it rarely\nrequires additional surgery.\n\nIf this happens, your surgeon will provide\nspeciﬁc instructions on how to care for it.", "image": "/media/04-14-089.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-090", "module": 4, "deck": "Reconstructive Surgery", "page": 90, "text": "How long will a drain be in my leg?\nA drainage tube is left in the thigh at the time\nof surgery. This tube is about ¼\" thick and is\nnecessary to drain ﬂuid that accumulates in\nthe thigh because of surgery.\n\nUsually, the drain stays in place for a couple\nof weeks and patients go home with this leg\ndrain.", "image": "/media/04-14-090.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-091", "module": 4, "deck": "Reconstructive Surgery", "page": 91, "text": "Drain Care\nThe nurses in the hospital will teach you how\nto care for your drain, which is an easy\nprocess.\n\n● The drain needs to be emptied twice daily\n (or more frequently depending on the\n amount of drainage) and the output needs to\n be recorded.\n\n● Your surgeon will want to know the daily\n output of the drain in milliliters (mL) for each\n 24-hour period.", "image": "/media/04-14-091.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-092", "module": 4, "deck": "Reconstructive Surgery", "page": 92, "text": "When can I get my drain\nremoved?\nWhen the drain output is less than 30-50\nML per 24-hour period, it may be ready\nto be removed.", "image": "/media/04-14-092.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-093", "module": 4, "deck": "Reconstructive Surgery", "page": 93, "text": "What if there is still ﬂuid\npost-drain removal?\nOccasionally, ﬂuid continues to accumulate\neven after the drain is removed. This can\nlead to swelling of the leg that feels soft,\nlike a water balloon. When you stand up the\nswelling will move down to above the knee.\n\nThis ﬂuid (called a seroma) usually needs to\nbe drained, but the procedure is easy and\ndone in the ofﬁce.", "image": "/media/04-14-093.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-094", "module": 4, "deck": "Reconstructive Surgery", "page": 94, "text": "How will the ﬂuid\n(seroma) be drained?\nThe skin overlying the area is usually\nnumb from the surgery and the ﬂuid can\nbe drained through a small needle\ninserted through the skin. Sometimes this\ncan require several drainage procedures if\nthe ﬂuid keeps reaccumulating.\n\nThis is not urgent – you do not need to\ncome in the same day for this problem.\nWaiting even a week or two will be ok.\nThe procedure is very minor and not\nbothersome for patients.", "image": "/media/04-14-094.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-095", "module": 4, "deck": "Reconstructive Surgery", "page": 95, "text": "What wound care do I\nneed to do for the\nthigh ﬂap?\nAside from drain care, all you\nneed to do is apply Vaseline or\nAquaphor to the incision several\ntimes a day to keep it from\nscabbing or drying out.", "image": "/media/04-14-095.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-096", "module": 4, "deck": "Reconstructive Surgery", "page": 96, "text": "What wound care do I need to do for the\nthigh ﬂap?\n Wrap your thigh with an ACE bandage, so\n that compression is applied to the leg.\n\n • This will help reduce the amount of\n ﬂuid draining from the thigh.\n\n • Avoid excessive pressure causing\n pain or knee swelling.", "image": "/media/04-14-096.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-097", "module": 4, "deck": "Reconstructive Surgery", "page": 97, "text": "I Can Manage Cancer\n\n\n\nHow long do I need to wrap my thigh?\nContinue using the ACE wrap for 1 month after surgery, even\nafter the drain is removed.\n\n● Wrap as much of the thigh as possible.\n\n● Another option is a full leg compression stocking.", "image": "/media/04-14-097.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-098", "module": 4, "deck": "Reconstructive Surgery", "page": 98, "text": "Skin Grafts", "image": "/media/04-14-098.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-099", "module": 4, "deck": "Reconstructive Surgery", "page": 99, "text": "What are skin grafts?\n● A thin sheet of skin shaved\n from one area and placed\n onto a wound somewhere\n else.\n● It is used for more\n surface-level wounds when\n the underlying tissue is\n healthy to support healing.\n● Take 2-3 weeks to fully heal.\n ○ Monitor both the donor\n and graft sites for\n infection", "image": "/media/04-14-099.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-100", "module": 4, "deck": "Reconstructive Surgery", "page": 100, "text": "Local Reconstruction", "image": "/media/04-14-100.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-101", "module": 4, "deck": "Reconstructive Surgery", "page": 101, "text": "What is local\nreconstruction?\n● This procedure uses tissue\n from around the surgical site\n (nearby skin or cells) to ﬁll a\n defect.\n● Generally a shorter surgery\n and quicker recovery\n ○ Mild bruising and\n swelling is common", "image": "/media/04-14-101.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-102", "module": 4, "deck": "Reconstructive Surgery", "page": 102, "text": "Regional Reconstruction", "image": "/media/04-14-102.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-103", "module": 4, "deck": "Reconstructive Surgery", "page": 103, "text": "What is regional\nreconstruction?\n● This procedure uses tissue\n from a nearby region (such as\n the chest muscle) which is\n rotated into the defect area.\n● This is ideal for larger defects\n and is more robust than a\n local reconstruction.\n ○ It may leave a visible scar\n on the chest or neck.\n ○ Drains may be in place to\n prevent buildup of ﬂuid.", "image": "/media/04-14-103.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-104", "module": 4, "deck": "Reconstructive Surgery", "page": 104, "text": "What to expect before, during, and\nafter the hospital\n\nFitness and What to After the\nPreparation hospital Click on the\n expect in box to jump\nfor Surgery and follow\n the to each\n hospital up section", "image": "/media/04-14-104.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-105", "module": 4, "deck": "Reconstructive Surgery", "page": 105, "text": "Other Questions About\nFitness and Preparation for\n Surgery", "image": "/media/04-14-105.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-106", "module": 4, "deck": "Reconstructive Surgery", "page": 106, "text": "Am I healthy enough to\nhave this surgery?\nReconstructive surgery can be lengthy,\nespecially when combined with surgery\nfor tumor removal.\n\nThis certainly does place stress on the\nbody.", "image": "/media/04-14-106.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-107", "module": 4, "deck": "Reconstructive Surgery", "page": 107, "text": "Am I healthy enough to\nhave this surgery?\nYour primary medical doctor (PCP) will be\nasked to provide a clearance note for you\nto undergo anesthesia/surgery.\n\nIf you have other medical problems, such\nas heart, lung, liver or kidney problems, a\nnote may be needed from additional\nspecialists, such as cardiologist, or\npulmonologist, if applicable.", "image": "/media/04-14-107.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-108", "module": 4, "deck": "Reconstructive Surgery", "page": 108, "text": "Am I too old to have this\nsurgery?\nMost of our patients are in their\n50’s-80’s.\n\nAge itself does not lead to complications\nand the overall health and functional\nstatus of the patient are more important\nindicators of ﬁtness and risk.", "image": "/media/04-14-108.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-109", "module": 4, "deck": "Reconstructive Surgery", "page": 109, "text": "Am I too old to have this\nsurgery?\nSome patients are in their 80’s and are\nquite healthy. Others may be younger\nand have signiﬁcant medical problems\nthat make surgery riskier.\n\nThe decision as to whether anesthesia\nand surgery are safe for a patient is made\nby a multidisciplinary team of surgeons,\nanesthesia personnel, and other\nspecialists.", "image": "/media/04-14-109.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-110", "module": 4, "deck": "Reconstructive Surgery", "page": 110, "text": "What can I do to prepare for surgery?\n I Can Manage Cancer\n\n\n\n\nThe most important thing leading up to surgery is to maintain\ngood nutrition to support wound healing and to avoid any\nactivities that worsen wound healing.", "image": "/media/04-14-110.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-111", "module": 4, "deck": "Reconstructive Surgery", "page": 111, "text": "Good nutrition requires\nprotein.\nProtein intake should be around 1.25-1.5 g of\nprotein per kilogram of bodyweight per day.\n\nSupplementing your diet with Boost, Ensure, or\nother protein supplements and vitamins is good,\nespecially if you have difﬁculty eating\npreoperatively.\n\nExcessive protein intake is not healthy, so it is a\ngood idea to work with a dietician to assist with\nnutrition.", "image": "/media/04-14-111.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-112", "module": 4, "deck": "Reconstructive Surgery", "page": 112, "text": "Supplements\nOne regular daily multivitamin is\nsufﬁcient and there is no need to\ntake additional supplements\nunless speciﬁcally instructed to\nby your doctor.\n\nSome herbal supplements can be\nharmful. Discuss any of these\nwith your surgeon before taking.", "image": "/media/04-14-112.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-113", "module": 4, "deck": "Reconstructive Surgery", "page": 113, "text": "Diabetes\nIf you have diabetes, make sure you are\ntaking all your medications as prescribed\nby your primary doctor.\n\nAvoid excessively fatty and sugary foods.", "image": "/media/04-14-113.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-114", "module": 4, "deck": "Reconstructive Surgery", "page": 114, "text": "Diabetes\nUncontrolled diabetes will\ncompromise your body’s ability to\nheal.\n\n● If you're not sure your medicine is\n right for you, talk to your primary\n doctor as soon as possible to\n make sure your diabetes is under\n control before surgery.\n\n● Also discuss any changes after\n discharge from the hospital with\n your primary doctor.", "image": "/media/04-14-114.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-115", "module": 4, "deck": "Reconstructive Surgery", "page": 115, "text": "Alcohol and tobacco\nuse prior to surgery\nIt is important to stop tobacco\nproducts (smoking, vaping, dipping,\ncigars, pipes, etc.) at least three\nweeks before surgery.\n\nSmoking impairs wound healing\nand increases the risk of\npostoperative complications.", "image": "/media/04-14-115.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-116", "module": 4, "deck": "Reconstructive Surgery", "page": 116, "text": "Alcohol and tobacco\nuse prior to surgery\nHeavy alcohol use can also cause\npostoperative complications\n\nIf you have more than one or two drinks\nper day, stopping all consumption of\nalcohol “cold turkey” can lead to\nwithdrawal symptoms.\n\n • It is best to wean yourself down\n over the course of a couple\n weeks.", "image": "/media/04-14-116.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-117", "module": 4, "deck": "Reconstructive Surgery", "page": 117, "text": "Alcohol and tobacco\nuse prior to surgery\nIf you are drinking daily before surgery,\nplease let us know.\n\nYou may require medication to help\nprevent alcohol withdrawal while\nyou’re in the hospital.\n\nThis is critical information for\nappropriate anesthesia and\npostoperative medications.", "image": "/media/04-14-117.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-118", "module": 4, "deck": "Reconstructive Surgery", "page": 118, "text": "Alcohol and tobacco\nuse prior to surgery\nSometimes it is difﬁcult for patients\nto be honest with their healthcare\nteam regarding their use of alcohol,\ntobacco, or other products.\n\nIt is important to be forthcoming\nwith this information so that we can\nmake sure you have the most\nappropriate care and best outcome.", "image": "/media/04-14-118.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-119", "module": 4, "deck": "Reconstructive Surgery", "page": 119, "text": "What to Expect in the\n Hospital", "image": "/media/04-14-119.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-120", "module": 4, "deck": "Reconstructive Surgery", "page": 120, "text": "Day of Surgery - Arrival\nYou will be asked to come to the hospital\nearly in the morning. The hospital will call\nyou the evening before surgery to tell you\nwhere to go and when to arrive.\n\nUsually, they want you to come in around\n5:30 AM.\n • This is to prepare you for\n anesthesia.\n\nYou will see the surgeons and\nanesthesiologists before going back to the\noperating room.", "image": "/media/04-14-120.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-121", "module": 4, "deck": "Reconstructive Surgery", "page": 121, "text": "Day of Surgery – Start\nof Surgery\nOnce in the operating room you will\nundergo anesthesia. This takes 15-20\nminutes.\n\nThen once you are asleep, we will\nprepare you for the surgery by padding\nand positioning your body, inserting a\ncatheter into the bladder, and inserting\nseveral more IV lines.\n\nThen the surgical site will be cleaned\nwith antiseptics.", "image": "/media/04-14-121.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-122", "module": 4, "deck": "Reconstructive Surgery", "page": 122, "text": "Day of Surgery – During\nSurgery\nBy the time we start the operation, it will be\naround 8:30.\n\nDepending on the surgery, it may be\nanywhere from 5 to 12 or more hours.\n\nA designated family member or friend will\nreceive updates from a nurse in the operating\nroom. The surgeons will talk to family/friends\nwhen they have completed their portions of\nthe procedure.", "image": "/media/04-14-122.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-123", "module": 4, "deck": "Reconstructive Surgery", "page": 123, "text": "Day of Surgery – After\nSurgery\nAfter the procedure is completed, you will\nbe transferred to the ICU and will wake up\nslowly.\n\nYou may not remember anything from the\nnight immediately following surgery.\n\nYou may have a tracheostomy tube and\nfeeding tube in place (if your surgeon\ndiscussed this with you), as well as several\nsurgical drains in the neck and the area\nwhere the ﬂap was taken.", "image": "/media/04-14-123.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-124", "module": 4, "deck": "Reconstructive Surgery", "page": 124, "text": "Hospital Stay I Can Manage Cancer\n\n\n\n\nYou will be in the hospital for about 10 days after free ﬂap surgery.\n\nSometimes this is longer or shorter depending on the type of surgery.", "image": "/media/04-14-124.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-125", "module": 4, "deck": "Reconstructive Surgery", "page": 125, "text": "Why do I have to stay for ~10 days?\nThe main purpose of the length of stay is to make sure the surgical\nsites are healing and that the ﬂap is healthy.\n\nWound healing problems often do not arise until about 1 week after\nsurgery.\n\nThis is the main reason patients remain in the hospital so long.", "image": "/media/04-14-125.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-126", "module": 4, "deck": "Reconstructive Surgery", "page": 126, "text": "Hospital Stay - ICU\nThe ﬁrst 3 days will be in the ICU.\n\nThis is not because you will be sick or\nunstable, but simply for close\nmonitoring.\n\nAfter this you will go to the regular\nﬂoor.", "image": "/media/04-14-126.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-127", "module": 4, "deck": "Reconstructive Surgery", "page": 127, "text": "Hospital Stay – Care\nYou will receive physical therapy in the\nhospital. This becomes more in-depth\nafter you leave the ICU.\n\nYou will be helped out of bed to a chair\nthe ﬁrst day after surgery and your\nactivity will be increased from there.\n\nYou will receive teaching regarding any\nwound care, tracheostomy care, feeding\ntube, or drain care needs.", "image": "/media/04-14-127.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-128", "module": 4, "deck": "Reconstructive Surgery", "page": 128, "text": "Rehab/Nursing Facility/\n\"Can I go home after the\nhospital?\nMost patients can go home after they\nleave the hospital.\n\n● But if a patient doesn’t have anyone\n to help them at home, we might\n arrange for them to stay at a skilled\n nursing facility until they can\n manage on their own.", "image": "/media/04-14-128.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-129", "module": 4, "deck": "Reconstructive Surgery", "page": 129, "text": "Rehab/Nursing Facility/\n\"Can I go home after the\nhospital?\nPhysical therapists usually decide if a\npatient needs to go to a rehab center\nafter leaving the hospital.\n\n● They will check on you several times\n while you're in the hospital, and if\n they think you need rehab, we will\n start making plans for your stay.", "image": "/media/04-14-129.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-130", "module": 4, "deck": "Reconstructive Surgery", "page": 130, "text": "Fistula and Wound Infection\nWhen you have surgery involving the mouth or throat, the wound is\nexposed to saliva.\n\nEven if the wounds are sutured perfectly, the body needs to take over\nand heal the wound or it will eventually open again.\n\nWound healing is more difﬁcult in the presence of saliva, but there is\nno way to keep it off of the wound.", "image": "/media/04-14-130.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-131", "module": 4, "deck": "Reconstructive Surgery", "page": 131, "text": "Complications\nIf part of the incision opens, saliva can track into the incision and down\ninto the neck. This is called a ﬁstula and can cause infection.\n\nIf saliva is draining into blood vessels, it can cause them to clot or\nrupture, which can damage or kill a ﬂap.\n\nUsually, a ﬁstula does not occur until about 7-10 days after surgery.\n\n• If it does happen, we may simply watch it closely (if it is small) or it\n may require additional procedures to clean the wound, patch the\n leak or place new drains.", "image": "/media/04-14-131.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-132", "module": 4, "deck": "Reconstructive Surgery", "page": 132, "text": "Flap Clotting\nA clot can form in the blood vessel feeding the ﬂap and kill the\nﬂap. While this is not the type of clot that can go to your lungs or\nbrain and be life threatening, it can necessitate more surgery.\n\nLuckily, this is rare and occurs in about 1 patient out of every 100\ncases.", "image": "/media/04-14-132.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-133", "module": 4, "deck": "Reconstructive Surgery", "page": 133, "text": "Flap Clotting\nSpontaneous ﬂap clotting is most common the ﬁrst couple days\nafter surgery.\n\nAfter this it is rare unless there is a ﬁstula or infection around the\nﬂap vessels, so the risk increases again about a week after surgery,\nwhen ﬁstulas and infections tend to develop.", "image": "/media/04-14-133.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-134", "module": 4, "deck": "Reconstructive Surgery", "page": 134, "text": "Flap Clotting Risks\nThe risks may be higher if you have a condition that leads to blood\nclotting.\n\n● Make sure your surgeon knows if you have ever had a blood\n clot in your legs or lungs or if blood clots run in your family.\n\n● Clotting disorders include Factor V Leiden, Prothrombin\n mutation, Protein C or S deﬁciency, elevated homocysteine,\n dysﬁbrinogenemia, and others. These are all rare but very\n important to know about.", "image": "/media/04-14-134.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-135", "module": 4, "deck": "Reconstructive Surgery", "page": 135, "text": "Flap Checks\nFlap checks are done to assess the blood\nﬂow to the ﬂap and make sure the ﬂap is\nalive and healthy.\n\nA ﬂap check involves looking at the ﬂap\nskin to make sure it the appropriate\ncolor.\n• The skin should look like normal\n healthy skin.\n• If it is very dark or purple or extremely\n pale, this can be an indication of a\n problem.", "image": "/media/04-14-135.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-136", "module": 4, "deck": "Reconstructive Surgery", "page": 136, "text": "Flap Checks\nA doppler stethoscope is also used to\nassess blood ﬂow to the ﬂap. This is a\nnon-invasive way to listen to the\npulsation of blood through the ﬂap.\n\nSometimes we will need to scratch the\nﬂap with a needle to assess the blood\nﬂow to the ﬂap.\n\nWhen this is done you will not feel pain\nfrom the needle stick because the ﬂap\nhas no sensation as it has been detached\nfrom all nerves.", "image": "/media/04-14-136.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-137", "module": 4, "deck": "Reconstructive Surgery", "page": 137, "text": "After the Hospital and\n Follow Up", "image": "/media/04-14-137.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-138", "module": 4, "deck": "Reconstructive Surgery", "page": 138, "text": "Follow-up\nYou will follow up in your\nreconstructive surgeon’s ofﬁce 1\nweek after discharge, then 2-3 weeks\nafter the initial post-op visit, then\nabout 2-3 months later, followed by\nanother 1-3 visits every 6 months.\n\nVisits may be more frequent if there\nare any wound care issues.\n\nYour cancer surgeon and other\ndoctors will have different schedules.", "image": "/media/04-14-138.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-139", "module": 4, "deck": "Reconstructive Surgery", "page": 139, "text": "Medication Management\nIt is important to check in with your primary\ndoctor and any specialists, such as\ncardiologist, pulmonologist, endocrinologist,\nafter discharge from the hospital.\n\nSome of your routine medications may\nchange while you are healing and dosing\nmay be altered during and after the hospital\nadmission.", "image": "/media/04-14-139.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "04-14-140", "module": 4, "deck": "Reconstructive Surgery", "page": 140, "text": "Medication Management\nIt is very important to re-establish care with\nyour normal medical doctors after\ndischarge.\n\nAs surgeons, we are not familiar with\nmanagement of most of these medications\nand can provide minimal assistance with\nquestions and concerns regarding\nmanagement of blood pressure, diabetes,\nneurological conditions, and other medical\nproblems.", "image": "/media/04-14-140.jpg", "url": "https://docs.google.com/presentation/d/1GZF26OnP2EXzLHuKE1fyy_yHKDc1AEgxMlHnzDkEicQ/view", "draft": true}, {"id": "05-01-01", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 1, "text": "Preparing for Your Head and\nNeck Surgery", "image": "/media/05-01-01.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-02", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 2, "text": "Optimizing Your Health Before Surgery to Reduce\nYour Likelihood of Complications", "image": "/media/05-01-02.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-03", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 3, "text": "What does smoking and alcohol have\nto do with head and neck cancer?\n● Smoking and heavy alcohol use have a\n exponential effect on developing head and\n neck cancer. This means that the effect is\n more than adding the impact of these two\n causes together.", "image": "/media/05-01-03.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-04", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 4, "text": "Quitting Smoking at Least 3 Weeks\nBefore Head and Neck Cancer Treatment:\n Why and How to Do it", "image": "/media/05-01-04.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-05", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 5, "text": "So what should I do?\nWe recommend you quit smoking\nimmediately after your cancer diagnosis\nand as many weeks as possible before the\nstart of cancer treatment.\n\nSince quitting is hard, we recommend you\nget as much help as possible from your\nclinical team, which includes your\nsurgeon, other oncologists, primary care\ndoctor, nurse, social worker, and team\nmembers within the tobacco treatment\nprogram.", "image": "/media/05-01-05.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-06", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 6, "text": "Why should I quit smoking\nimmediately after a cancer\ndiagnosis?\n\n Smoking before surgery increases the\n risk of wound healing problems and\n death around the time of surgery.\n\n This is because quitting smoking\n improves your body’s ability to heal\n and respond to treatment.", "image": "/media/05-01-06.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-07", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 7, "text": "Why should I quit smoking immediately after a\ncancer diagnosis?\n Patients who receive\n intensive smoking\n cessation treatment at\n least four weeks before\n surgery have a lower risk\n of surgical\n complications.", "image": "/media/05-01-07.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-08", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 8, "text": "Why should I quit smoking\nimmediately after a cancer\ndiagnosis?\n Quitting at the time of diagnosis may\n reduce the risk of your cancer returning\n after treatment.\n\n Quitting also reduces your risk that a\n second cancer will develop.\n\n Quitting smoking reduces your risk that\n your cancer will be fatal.", "image": "/media/05-01-08.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-09", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 9, "text": "So what should I do? How do I\nquit smoking?\nSupport to Stop Smoking is Available:\n\n● Regularly talking to an expert to help you quit\n AND taking medication is the most effective form\n of treatment. Doing both are more effective than\n doing one or the other.\n\n● A person in expertise in helping patients quit\n smoking can help you identify triggers, develop\n coping strategies and provide emotional support.\n\n● FDA-approved medications help address cravings\n as well as withdrawal and mood symptoms.", "image": "/media/05-01-09.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-10", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 10, "text": "If you’re interested in quitting\nsmoking:\n● Ask your doctor for a referral to the UTSW\n nicotine cessation program.\n\n● Ask your doctor for a prescription for\n medications to help you quit.", "image": "/media/05-01-10.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-11", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 11, "text": "What to Expect When Quitting\nSmoking\nSmoking affects several key chemicals called\nneurotransmitters in the brain:\n\n● Creating alertness\n● Increasing energy\n● Elevating mood\n\nQuitting can lead to feelings of anxiety and low\nmood/depression as the brain adjusts to a change in its\nchemistry.\n\nMedications can help re-balance these neurotransmitters\nwithout the harmful side-effects of smoking.", "image": "/media/05-01-11.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-12", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 12, "text": "What to Expect When Quitting\nSmoking\nQuitting is hard but your clinical team is\nhere to support you.\n\nEven so called “failures” are successes –\nthere is a good chance you can quit\nlong-term if you are able to stay off\ncigarettes for one week.", "image": "/media/05-01-12.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-13", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 13, "text": "Drinking Alcohol Sparingly,\nIf At All", "image": "/media/05-01-13.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-14", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 14, "text": "Reducing Your Alcohol Intake\nIf you drink heavily:\n\n● Notify your surgeon\n● Reduce your alcohol intake, ideally to\n sparingly, if at all\n● This means 1-2 drinks per week or\n less\n\nWe do not know if there is a “safe”\namount of alcohol intake for head and\nneck cancer survivors.", "image": "/media/05-01-14.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-15", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 15, "text": "Detoxing From Alcohol\n● Sometimes a surgeon may\n recommend detoxing from alcohol\n before starting treatment.\n\n● Detoxing from alcohol can be life\n threatening and may require\n admission to the hospital.\n\n● In the hospital, they can help your\n withdrawal symptoms with\n medications, such as benzodiazepines.", "image": "/media/05-01-15.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-16", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 16, "text": "What to Expect When Quitting\nAlcohol\n● Alcohol acts as a depressant in the body,\n affecting heart rate, blood pressure and\n breathing.\n\n● Alcohol also interferes with the chemicals\n that affect our mood. Drinking can make\n you feel relaxed initially but later leads to\n feeling irritable and restless. Another drink\n repeats the cycle.", "image": "/media/05-01-16.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-17", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 17, "text": "Why should I decrease my\nalcohol use?\nContinued heavy alcohol use may lead\nto:\n\n● Lowered ability of your immune\n system to ﬁght cancer\n● Delayed surgery\n● Longer and more frequent\n hospitalizations\n● Longer recoveries from treatment", "image": "/media/05-01-17.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-18", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 18, "text": "What are the beneﬁts to\nquitting alcohol?\nQuitting alcohol helps your body ﬁght\ncancer and reduces your risk of developing\nnew cancers.\n\nQuitting alcohol also reduces the severity\nof treatment side effects, such as\nmucositis.", "image": "/media/05-01-18.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-19", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 19, "text": "What to Expect When Quitting\nAlcohol\nSupport to abstain from alcohol is available:\n\n ● We can refer you to a specialized\n psychiatrist to help quit alcohol by\n managing cravings and mood symptoms\n ● Support from the clinic social worker to\n identify triggers, alternative coping skills\n and problem-solve barriers to quit", "image": "/media/05-01-19.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-20", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 20, "text": "Improving Nutrition", "image": "/media/05-01-20.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-21", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 21, "text": "Dietician Orientation\nIf you prefer information in video format please view the short video below:", "image": "/media/05-01-21.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-22", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 22, "text": "Why Do I Need Proper Nutrition?\nProper nutrition plays an important role before and\nafter your surgery.\n\nProper nutrition:\n\n● Supports wound healing\n● Strengthens your immune system\n● Helps the body manage the stress of surgery\n\nMalnutrition can increase the risk of\ncomplications, prolonged hospital stays, and\nslower recovery", "image": "/media/05-01-22.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-23", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 23, "text": "How do I maintain my nutrition status?\nA dietician is a healthcare professional that specializes in\nfood and nutrition. Ask your provider to place a referral if you\nwould like to be contacted or need help with any of the\nfollowing listed below.\n\nTheir goals are to help you make sure you are:\n● Consuming adequate protein\n● Maintaining your weight\n● Staying hydrated\n\nThey can also help with:\n ● Coping with potential nutrition-related side effects\n from treatment.\n ● Tube feeding assistance. For more information, refer\n to the NG tube module.", "image": "/media/05-01-23.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-24", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 24, "text": "How do I maintain my nutrition status?\nProtein is essential for faster healing so it’s important to\nincrease your protein intake both before and after surgery.\n\nCalories are equally important for the healing process as they\nhelp you maintain your weight.\n\n ● Select foods that are both high in protein and calories to\n support recovery.\n\n ● Drink 2-3 protein shakes a day for at least two weeks\n prior to surgery is recommended. Shakes that are high in\n protein and calories are best. For more information on\n speciﬁc brands, refer to the Dietician Orientation video at\n the start of this module.", "image": "/media/05-01-24.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-25", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 25, "text": "What are good sources of protein?\nDepending on tumor size and location, soft protein\nsources may be easier for you to eat before surgery.\n\nAfter surgery you will likely rely on soft foods,\nsoups, and shakes for your protein needs.\n\nEggs are a good source of protein. You can\nincorporate dishes like egg salad, quiche, and\ncustard into your diet.", "image": "/media/05-01-25.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-26", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 26, "text": "What are good sources of protein?\nMeat is also a good source of protein: include meats\nsuch as chicken, pork, beef, and lamb to meet your\nprotein needs.\n\n● If it is difﬁcult to chew or swallow meat, opt for\n shredded or ground meat with extra gravy, or\n choose casseroles and chicken salad for easier\n consumption.\n\nFish is another great soft high protein food.", "image": "/media/05-01-26.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-27", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 27, "text": "What are good sources of protein?\nDairy products like greek yogurt, cottage cheese, and\nmilk are also high in protein.\n\n● Choosing whole milk or chocolate milk can add\n extra calories, helping you maintain your weight.\n\n● For added calories and protein, you can prepare\n oatmeal with milk instead of water\n\n● Creamy or chunky soup like clam chowder,\n potato, cream of chicken, broccoli, or soups with\n beans are also a good option.", "image": "/media/05-01-27.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-28", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 28, "text": "What are good sources of protein?\nFor vegetarian protein sources, try:\n\n● Beans, lentils, or hummus (chickpeas)\n\n● Tofu\n\n● Soy milk or soy yogurt\n\n● Nut butters\n\n● Veggie burgers", "image": "/media/05-01-28.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-29", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 29, "text": "Staying Active", "image": "/media/05-01-29.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-01-30", "module": 5, "deck": "Optimizing Health Before Surgery", "page": 30, "text": "Why is it important to stay active\nbefore my surgery?\nStaying active before surgery can help your body\nprepare and recover more quickly.\n\nGenerally, healthy, active people regain full mobility\nquicker than patients who have a lower baseline\nlevel of mobility and activity prior to surgery.\n\nUsually, active, healthy patients can walk without\nassistance (meaning without a cane or walker) in a\nfew weeks.", "image": "/media/05-01-30.jpg", "url": "https://docs.google.com/presentation/d/1w5BBWlFzGJb0pAhj52sCAktIqNtIliZaeqvZPLTFMOk/view", "draft": false}, {"id": "05-02-01", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 1, "text": "Preparing for Your Hospitalization and\nDischarge", "image": "/media/05-02-01.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-02", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 2, "text": "Preparing for Your Hospitalization After\n Free Flap Surgery and Tracheostomy", "image": "/media/05-02-02.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-03", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 3, "text": "Bring a Caretaker\nIf possible, plan to have a family member or a loved\none stay with you in the hospital for at least the ﬁrst\nfew days after your surgery.\n\nIt is helpful to have someone with you that knows\nyou well and who can anticipate your needs to\nsupport you while you recover.\n\nYou will have your own room with a private\nbathroom. There will also be a recliner or pull out\nbed so your support person can stay comfortably\nwith you.", "image": "/media/05-02-03.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-04", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 4, "text": "What else should I bring?\nTo help you feel more at ease during your stay, we\nencourage you to bring a few comfort items and\nthings to keep yourself entertained, such as:\n\n● Cozy socks or slippers\n● A favorite blanket\n● A sound machine or headphones\n● A tablet\n● Puzzles or games\n● Books or magazines\n● Pictures of loved ones", "image": "/media/05-02-04.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-05", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 5, "text": "What else should I bring?\nMost likely you will be unable to talk right after your\nsurgery so it is a good idea to have a way to\ncommunicate your needs.\n\nWhile a caregiver can help, you can also use the\nfollowing to help communicate:\n\n● A whiteboard and a marker (provided by the\n hospital)\n● Phone-based apps like a talk to text app or a\n notes app", "image": "/media/05-02-05.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-06", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 6, "text": "What to Expect When You Wake Up", "image": "/media/05-02-06.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-07", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 7, "text": "What To Expect When You Wake Up\n\nThe ﬁrst few days after surgery require the most\nadjustment as you grow accustomed to your trach\nand the changes with your surgery, the hospital\nsetting and the close monitoring of your progress.\n\nRemember, you will adjust to these changes and\nyour hospital team is there to support you.", "image": "/media/05-02-07.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-08", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 8, "text": "What To Expect When You Wake\nUp\nWhen you wake up, you will be coming out of a\nmajor surgery and still feeling the effects of\nanesthesia. This is completely normal.\n\nYou will be given pain medication to keep you\ncomfortable but it may also make you feel groggy,\nsleepy, or a little confused at ﬁrst.\n\nYou will likely rely on your caregivers or written or\ntext-based forms of communication, at ﬁrst.", "image": "/media/05-02-08.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-09", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 9, "text": "What To Expect When You Wake\nUp\nWhen you wake up from surgery, you will likely have\nseveral thing attached to your body, such as a\ntracheostomy, drains, tubes, or monitors.\n\n● These are all in place to help you heal and will be\n removed as you recover.\n\nIt is helpful to remember that the ﬁrst few days after\nsurgery can be the hardest to adjust to but your team\nis there to support you through this difﬁcult\nexperience.", "image": "/media/05-02-09.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-10", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 10, "text": "Will I be able to eat and drink?\nBecause your surgery involves the head and\nneck, you won't be able to eat or drink by\nmouth when you wake up.\n\nYour care team will ensure you receive\nnutrition in other ways until your surgeon\ndetermines that it is safe for you to resume\neating and drinking again.", "image": "/media/05-02-10.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-11", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 11, "text": "How independent will I be after\nsurgery?\nAt the beginning, you will need help from the\nhospital staff to do most things--this is\ncompletely normal and expected.\n\nYou may also need to rely on your caretaker during\nthis time to communicate your needs.\n\n● Having someone who knows you well can be\n comforting and can help ensure your care\n team understands your wishes.", "image": "/media/05-02-11.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-12", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 12, "text": "How independent will I be after\nsurgery?\nYou will be moving around and encouraged to get\nout of bed the ﬁrst few days with assistance.\n\nDuring your stay, you will gradually regain strength\nand be able to move around more on your own, but\nthis won’t happen right away.\n\nYour care team will be there to support you every\nstep of the way. This team includes physical and\noccupational therapy.", "image": "/media/05-02-12.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-13", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 13, "text": "What to Expect in the ICU", "image": "/media/05-02-13.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-14", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 14, "text": "What to Expect in the ICU\nWhen you ﬁrst wake up from the surgery, you will be\nplaced in the Surgical Intensive Care Unit (SICU).\n\nIn the SICU you will have your own room with glass doors\nthat can be closed for privacy and to maintain a quiet\nenvironment.\n\nThere is a lot of activity in the SICU and a lot of people\ncoming to check on various aspects of your healing.\n\n ● After your reconstruction, your team will be monitoring\n your new free ﬂap frequently to make sure your new\n tissue is healthy and healing.", "image": "/media/05-02-14.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-15", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 15, "text": "What to Expect in the ICU\nThe ﬁrst few nights in the ICU may not\nprovide quality restful sleep.\n\nIt is important to ensure you have items that\nwill make you as comfortable as you can be.", "image": "/media/05-02-15.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-16", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 16, "text": "Comfort Care in the SICU\nIn the SICU, your pain medication will likely be given\nthrough a device called a Patient-Controlled\nAnalgesia (PCA) pump also known as a “pain button”.\n\n● This device allows you to self-administer\n medication for pain relief by pressing a button.\n\nIf you are tall or you ﬁnd that your feet touch the\nheadboard, the hospital can provide a bed extender.\n\n● You can also ask you care team ahead of time if you\n think you might need one.", "image": "/media/05-02-16.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-17", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 17, "text": "Can I have visitors in the ICU?\nYes, you can have visitors in the ICU.\n\nCheck with the front desk to ﬁnd out the visitor policy.", "image": "/media/05-02-17.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-18", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 18, "text": "What to Expect on the Recovery Floor", "image": "/media/05-02-18.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-19", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 19, "text": "What to Expect on the Recovery Floor\nAfter a few days, you will be transferred from the\nICU to a recovery ﬂoor.\n\nHere you will have a private room (with a full bath)\nwith doors that can be closed for privacy and to\nmaintain a quiet environment.\n\nThere is less activity here as well.\n\n● While your care team will still be monitoring\n your healing, it will be less frequent than in the\n ICU.", "image": "/media/05-02-19.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-20", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 20, "text": "What to Expect on the Recovery Floor\nOn the ﬂoor, your pain medication will likely be given PRN\nwhich means as needed.\n\n ● This means your pain medication will not be given at\n set times, but instead when you ask for it. This gives\n you more control over when you receive pain relief.\n\n ● It is important to pay attention to how you are feeling\n and let your care team when you are feeling\n uncomfortable.\n\nDon’t wait until the pain is severe--your team is here to\nhelp manage your pain and keep you as comfortable as\npossible.", "image": "/media/05-02-20.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-21", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 21, "text": "Planning for Discharge", "image": "/media/05-02-21.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-22", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 22, "text": "Planning for Discharge\nAs you get closer to leaving the hospital, a care\ncoordinator will help ensure everything is in place for\na smooth and safe discharge.\n\nThey work closely with your doctors, nurses, and\ncaregiver to:\n\n● Coordinate arrangements following your\n discharge including medical equipment,\n prescriptions, nutritional supplements.\n● Answer any questions you have about your\n discharge plan.", "image": "/media/05-02-22.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-23", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 23, "text": "Where will I discharge to?\nWhen it's time to leave the hospital, your care team\nand care coordinator will talk with you and your loved\nones to help choose the best option for your recovery.\n\nCommon discharge options include:\n ● Home with home health\n ● To a nursing facility\n ● To a rehabilitation facility\n\nMore information about each of these discharge\noptions will be provided on the next slides.", "image": "/media/05-02-23.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-24", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 24, "text": "Where will I discharge to?\nHome with home health:\n ● You go home but have a home health\n provider visit you a few times a week to\n help with things like wound care and\n medications.", "image": "/media/05-02-24.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-25", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 25, "text": "Where will I discharge to?\nTo a rehabilitation facility:\n ● You go to a rehab center for more intensive\n therapy, like physical or occupational therapy,\n to help you recover strength and function\n before returning home.\n\nTo a skilled nursing facility:\n ● You temporarily stay at a facility where you\n can get more hands-on medical care and help\n with daily activities until you are stronger.", "image": "/media/05-02-25.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-26", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 26, "text": "Planning for Discharge\nBefore you leave the hospital, your care team will help you schedule follow-up\nappointments with your treatment team before you discharge.\n\n ● You will be coming back in about a week for a follow up appointment with\n your surgical oncologist and your reconstructive surgeon.", "image": "/media/05-02-26.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-27", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 27, "text": "Planning for Discharge\nShould you go home with any medical equipment your hospital team will provide\neducation on the items you will discharge with.\n\n● This may include things like tracheostomy training, wound vac training,\n wound care training, feeding tube training.", "image": "/media/05-02-27.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-02-28", "module": 5, "deck": "Preparing for Your Hospitalization", "page": 28, "text": "Support at Home\nIf possible, after you leave the hospital, having help\nfrom a caregiver or loved one will be very\nimportant. Caregivers are encouraged to reach out\nto the care coordinator if any questions arise.\n\nThey can assist with daily tasks, help manage\nmedications, and provide emotional support as you\ncontinue to recover at home.\n\nIf you have any questions or concerns at any point,\ndon’t hesitate to talk with your care team—they’re\nhere to help and support you throughout your\nrecovery. Additionally, caregivers can contact the\ncare coordinator if they have any questions.", "image": "/media/05-02-28.jpg", "url": "https://docs.google.com/presentation/d/1OtF247glAGXyVA6w_jm-HCxw0nAcJKBv2asibs4fTq0/view", "draft": false}, {"id": "05-03-1", "module": 5, "deck": "The Barium Swallowing Test", "page": 1, "text": "The Modiﬁed Barium Swallow Study", "image": "/media/05-03-1.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "05-03-2", "module": 5, "deck": "The Barium Swallowing Test", "page": 2, "text": "What is a Modiﬁed Barium\nSwallow Study (MBS)?\n\nA modiﬁed barium swallow study is a\nvideo X-ray that shows how food and drink\nmove through your mouth and throat when\nyou swallow. It helps check how well your\nthroat muscles are working and how food\ntravels into the top part of your esophagus\n(food pipe). It speciﬁcally tests the safety\nand efﬁciency of your swallow.", "image": "/media/05-03-2.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "05-03-3", "module": 5, "deck": "The Barium Swallowing Test", "page": 3, "text": "What is the Process of getting\nan MBS?\n\nDuring testing, you will be seated in an\nopen x-ray machine. Video x-rays are\nrecorded as you swallow liquid and bites\nof food.\nThe food and drink you consume is tinted\nwith barium, which allows it to be seen\nunder an x-ray.", "image": "/media/05-03-3.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "05-03-4", "module": 5, "deck": "The Barium Swallowing Test", "page": 4, "text": "What Happens if you have\nDifﬁculty Swallowing?\n\nThe MBS study helps your care team ﬁgure out which foods and drinks\nare safe for you to eat.\n\nIt also lets the speech pathologist see if you might beneﬁt from\nswallowing therapy.\n\nHaving this test done before head and neck cancer treatment can help\nyour team plan for your nutrition and decide if a feeding tube may be\nneeded after treatment.", "image": "/media/05-03-4.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "05-03-5", "module": 5, "deck": "The Barium Swallowing Test", "page": 5, "text": "How Should You Prepare for the\nTest?\n● You can eat and drink normally before\n the test; there are no restrictions.\n● Bring any food or drink you ﬁnd hard to\n swallow so we can observe you\n ingesting them.\n● Avoid wearing jewelry or clothing with\n metal.\n● If you use special drinking tools (like a\n straw or bottle), please bring them.", "image": "/media/05-03-5.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "05-03-6", "module": 5, "deck": "The Barium Swallowing Test", "page": 6, "text": "How Should You Prepare for the\nTest?\n● Please arrive 30 minutes early to allow\n time for check-in.\n ○ Check in at the Outpatient Building:\n 1801 Inwood Rd, Dallas, TX 75390,\n 1st ﬂoor.\n● On MyChart, your MBS appointment will\n appear as an X-ray visit followed by a\n speech pathology visit. Both are done\n during the same visit at the outpatient\n building.\n● For any questions, please contact us via\n MyChart or at 214-645-8898.", "image": "/media/05-03-6.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "05-03-7", "module": 5, "deck": "The Barium Swallowing Test", "page": 7, "text": "References\nTo learn more about the information in module 5, please visit the following\nwebpages, which are hosted by the National Cancer Institute and the\nAmerican Cancer Society.\nHead and Neck Cancer—Patient Version - NCI\nHead and Neck Cancers | Cancers of the Head and Neck\nABOUT HEAD & NECK CANCER | Head & Neck Cancer Alliance\nhttps://www.headandneck.org/hnc-resources/\nFor Patients - American Head & Neck Society", "image": "/media/05-03-7.jpg", "url": "https://docs.google.com/presentation/d/1ZQXP8qedL0AaqPBWdTPZbmMd7vSXYDXP1Fz8ecW1RRo/view", "draft": false}, {"id": "06-01-01", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 1, "text": "Managing and Cleaning\nYour Tracheostomy Tube", "image": "/media/06-01-01.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-02", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 2, "text": "What is a Tracheostomy Tube?\nA tracheostomy tube is a medical device\ninserted into a small opening in your neck\ncalled a stoma, which leads directly into\nyour windpipe (trachea).\n\nThis tube helps you breathe when you're\nunable to breathe normally through your\nnose or mouth. It allows air to ﬂow directly\ninto your lungs and may be used\ntemporarily or long-term depending on\nyour condition.", "image": "/media/06-01-02.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-03", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 3, "text": "Parts of Your\n Tracheostomy\n Tube\n1 Outer Cannula\n 1\n2 Neck Plate\n 1\n\n3 Neck Plate Slot\n\n4 Inner Cannula Hub", "image": "/media/06-01-03.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-04", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 4, "text": "Parts of Your Tracheostomy Tube Continued\n1 Inner cannula\n\n2 Obturator", "image": "/media/06-01-04.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-05", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 5, "text": "Parts of Your Tracheostomy Tube Continued\n\nThe inner cannula is a hollow tube placed in the tracheostomy opening\nthat remains there during routine use. It's primary purpose is to keep\nthe airway open and allows it to be cleaned at regular intervals without\nremoving the tracheostomy tube.\n\nThe obturator is a solid insert used during tube insertion or exchange. It\nserves as a guide when inserting the tube and is then removed.", "image": "/media/06-01-05.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-06", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 6, "text": "Before Discharge From the Hospital\n\nPatients or caregivers should demonstrate tracheostomy care (such as\nsuctioning, cleaning, and tube changes) under supervision to conﬁrm\nunderstanding and safe technique.", "image": "/media/06-01-06.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-07", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 7, "text": "Cleaning Your Tracheostomy\n Tube", "image": "/media/06-01-07.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-08", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 8, "text": "Supplies Needed to Clean Your\nTracheostomy Tube\n1 Clean washcloth\n\n2 Distilled water or sterile water\n\n3 Cotton tipped swabs\n\n4 Cleaning brush\n\n5 Tap water\n\n6 2 clean bowls or cups", "image": "/media/06-01-08.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-sup.jpg"}, {"id": "06-01-09", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 9, "text": "Cleaning Your Tracheostomy\nTube Steps\n Step 1: Wash your hands with soap\n and water before you start.\n\n Step 2: Pour distilled water or sterile\n water into two clean bowls or cups.", "image": "/media/06-01-09.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false}, {"id": "06-01-10", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 10, "text": "Cleaning Your Tracheostomy Tube Steps Continued\n Step 3: Unlock the inner cannula of your tracheostomy and take it out,\n as seen below.", "image": "/media/06-01-10.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-s3.jpg"}, {"id": "06-01-11", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 11, "text": "Cleaning Your Tracheostomy Tube Steps Continued\n If you have a reusable inner cannula, follow steps 4 and 5:\n\n Step 4: Put the inner cannula into the distilled or sterile water. Use a cotton\n tip swab or cleaning brush to clean the inner cannula as shown below.", "image": "/media/06-01-11.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-s4.jpg"}, {"id": "06-01-12", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 12, "text": "Cleaning Your Tracheostomy Tube Steps Continued\n If you have a reusable inner cannula, follow steps 4 and 5:\n\n Step 5: Rinse the inner cannula with fresh tap water. Shake off excess\n water.", "image": "/media/06-01-12.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-s5.jpg"}, {"id": "06-01-13", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 13, "text": "Cleaning Your Tracheostomy Tube Steps Continued\n Step 6: Dip cotton tipped swabs in fresh distilled or sterile water\n and clean around your tracheostomy. Wipe from within the\n tracheostomy stoma outwards towards the skin, as shown below.", "image": "/media/06-01-13.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-s6.jpg"}, {"id": "06-01-14", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 14, "text": "Cleaning Your Tracheostomy Tube Steps Continued\n Step 7: Put the inner cannula back in and lock it as shown below.", "image": "/media/06-01-14.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-s7.jpg"}, {"id": "06-01-15", "module": 6, "deck": "Managing and Cleaning Your Tracheostomy Tube", "page": 15, "text": "Cleaning Your Tracheostomy\nTube Steps Continued\n Step 8: Wet a clean washcloth with clean\n warm water. Wipe the skin around your\n tracheostomy stoma.\n\n Step 9: Dry your skin with a clean towel.\n\n Step 10: Wash your hands with soap and\n water.", "image": "/media/06-01-15.jpg", "url": "https://docs.google.com/presentation/d/1nSOBV1vr5RTOB3yMCfybx2-RhJOczRhWjZgVeFzr76o/view", "draft": false, "photo": "/media/trach-s8.jpg"}, {"id": "06-02-01", "module": 6, "deck": "Suctioning Your Tube", "page": 1, "text": "Suctioning Your Tube", "image": "/media/06-02-01.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-02", "module": 6, "deck": "Suctioning Your Tube", "page": 2, "text": "Suctioning\n Your tracheostomy should be suctioned\n if you feel mucus in your chest and are\n unable to cough it out.\n\n If you are able to cough up the mucus,\n you should not need to suction the\n tracheostomy.", "image": "/media/06-02-02.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-03", "module": 6, "deck": "Suctioning Your Tube", "page": 3, "text": "Supplies Needed to Suction Your\n Tracheostomy Tube\n1 Suction machine with tubing\n\n2 Sterile suction kit (with red rubber catheter)\n\n3 Clean cup with tap water\n\n4 Normal saline bullets", "image": "/media/06-02-03.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-04", "module": 6, "deck": "Suctioning Your Tube", "page": 4, "text": "Suctioning Your Tracheostomy\nTube Steps\n Step 1: Wash your hands.\n\n Step 2: Turn on the suction machine.\n\n Step 3: Sit or stand in front of a\n mirror.\n\n Step 4: Open the suction kit.\n\n Step 5: Put on the gloves that are\n found inside the kit.", "image": "/media/06-02-04.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-05", "module": 6, "deck": "Suctioning Your Tube", "page": 5, "text": "Suctioning Your Tracheostomy Tube Steps Continued\nStep 6: Remove the suction catheter from the kit as shown in the\nbottom left image, and connect it to the suction line coming from the\nmachine as shown in the bottom right image. Keep the tip of the\nsuction catheter as clean as possible.", "image": "/media/06-02-05.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-06", "module": 6, "deck": "Suctioning Your Tube", "page": 6, "text": "Suctioning Your Tracheostomy Tube Steps Continued\nStep 7: Gently insert the catheter\ninto your tracheostomy tube\nstoma about 8 cm (roughly the\nlength of your index ﬁnger) or\nuntil you cough.\n\nStep 8: Do not apply suction\nwhen you are pushing the\ncatheter into your tracheostomy\ntube stoma.", "image": "/media/06-02-06.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-07", "module": 6, "deck": "Suctioning Your Tube", "page": 7, "text": "Suctioning Your Tracheostomy Tube Steps Continued\nStep 9: While slowly pulling the catheter out, pulse the suction by\ncovering and uncovering the thumbhole of the catheter as shown\nbelow.", "image": "/media/06-02-07.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-08", "module": 6, "deck": "Suctioning Your Tube", "page": 8, "text": "Suctioning Your Tracheostomy\nTube Steps Continued\n Step 10: Do not suction more than 10\n seconds.\n\n Step 11: You can repeat the suction\n again if needed, but ﬁrst take a few\n deep breaths. If suctioning doesn’t\n help, squeeze a saline bullet into\n your tracheostomy tube and repeat\n suction. The saline may cause you to\n cough, but this is normal.", "image": "/media/06-02-08.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-09", "module": 6, "deck": "Suctioning Your Tube", "page": 9, "text": "Suctioning Your Tracheostomy\nTube Steps Continued\n Step 12: Rinse the catheter by\n suctioning the water from the cup\n until the catheter and suction\n machine are free of mucous. Remove\n the catheter and throw away the\n catheter and gloves. Never reuse a\n catheter.\n\n Step 13: Wash your hands with soap\n and water.", "image": "/media/06-02-09.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-10", "module": 6, "deck": "Suctioning Your Tube", "page": 10, "text": "Concerning Secretions\n\n Contact your provider if you notice any of the following:\n ● Yellow-green thick secretions\n ● Pus or foul-smelling discharge\n ● Frank blood or signiﬁcant blood-tinged discharge\n ● Increased volume of secretions that may also be associated\n with fever, cough, or trouble breathing", "image": "/media/06-02-10.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-11", "module": 6, "deck": "Suctioning Your Tube", "page": 11, "text": "Changing the Velcro Neck\n Band", "image": "/media/06-02-11.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-12", "module": 6, "deck": "Suctioning Your Tube", "page": 12, "text": "Supplies Needed to Change the\n Velcro Neck Band\n1 Velcro Neck Band\n\n2 Scissors\n2\n\n It is important to keep a ﬁnger on the\n neck plate at all times to hold the\n tracheostomy tube in place while\n changing ties.\n\n The velcro band can be changed as\n needed and does not need to be done at\n the same time as suctioning the tube.", "image": "/media/06-02-12.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-13", "module": 6, "deck": "Suctioning Your Tube", "page": 13, "text": "Changing the Velcro Neck Band\nSteps\nStep 1: Wash your hands.\n\nStep 2: Remove the tracheostomy tube\nneck band from the package.\n\nStep 3: Separate the long and short end\nof the neck band.", "image": "/media/06-02-13.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-14", "module": 6, "deck": "Suctioning Your Tube", "page": 14, "text": "Changing the Velcro Neck Band Steps\nStep 4: Hold the tracheostomy tube secure and remove one side of the\nold ties. Thread the thin velcro tab (of the longer side of the new band)\nthrough the back of the neck plate slit and fold it back to stick it to the\nband (as shown below).", "image": "/media/06-02-14.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-15", "module": 6, "deck": "Suctioning Your Tube", "page": 15, "text": "Changing the Velcro Neck Band Steps Continued\nStep 5: Bring the long end of the cotton band behind your neck.\nRemove the second side of the old Velcro band. Thread the thin Velcro\ntab of the shorter side of the new band through the back of the other\nneck plate slot and fold it back to stick it to the band, as shown below.", "image": "/media/06-02-15.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-02-16", "module": 6, "deck": "Suctioning Your Tube", "page": 16, "text": "Changing the Velcro Neck Band Steps Continued\nStep 6: Adjust the neck band to the proper length. You should be able to\nﬁt two ﬁngers under the band, between the band and your neck, as\nshown in the bottom right image. Secure it in place by sticking the wide\nVelcro tab to the free end of the opposite band. If you have too much\nextra band, you can trim the long end of the band with scissors.\n\nStep 7. Discard the old neck band in the trash.", "image": "/media/06-02-16.jpg", "url": "https://docs.google.com/presentation/d/1uinckKWzdQalWqQoxRlyc-N9YAHsEmuTnUtposbPz0Y/view", "draft": false}, {"id": "06-03-01", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 1, "text": "Staying Safe and Comfortable with a\nTracheostomy", "image": "/media/06-03-01.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-02", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 2, "text": "How to Put My Tracheostomy\nTube Back in If It Comes Out", "image": "/media/06-03-02.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-03", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 3, "text": "Supplies Needed\n1 Replacement tracheostomy tube\n\n2 Obturator\n\n\n3 Inner cannula\n\n4 Velcro neck band or tracheostomy\n ties\n\n5 Mirror\n\n6 Scissors", "image": "/media/06-03-03.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-04", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 4, "text": "How to Put Your Tracheostomy\nTube Back in Steps\n Step 1: If your tracheostomy tube\n accidentally comes out, do not panic.\n The stoma in your neck will not close.\n Take a few slow deep breaths.\n\n Step 2: Locate the spare\n tracheostomy tube sent home in your\n tracheostomy care kit.\n\n Step 3: Open the box and remove the\n tracheostomy tube and obturator.", "image": "/media/06-03-04.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-05", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 5, "text": "I Can Manage Cancer\n\n\nHow to Put Your Tracheostomy Tube Back in Steps\nStep 4: Place the obturator inside the tracheostomy tube, as shown\nbelow.", "image": "/media/06-03-05.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-06", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 6, "text": "How to Put Your Tracheostomy Tube Back in Steps\nContinued\n\n\n Step 5: Stand in front of the mirror,\n holding the tracheostomy tube and\n obturator with your dominant hand,\n as shown in the top picture to the\n right.", "image": "/media/06-03-06.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-07", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 7, "text": "How to Put Your Tracheostomy Tube Back in Steps\nContinued\n\n\n Step 6: As you breathe in, insert the\n tracheostomy tube (with obturator in\n place) into your stoma by pushing in\n and following the curve of the tube.", "image": "/media/06-03-07.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-08", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 8, "text": "How to Put Your Tracheostomy Tube Back in\nSteps Continued\n Step 7: Hold the tube in place\n with your ﬁngers resting on the\n neck plate, while quickly removing\n the obturator. Insert the cannula\n and secure in place.\n\n Step 8: Secure the tracheostomy\n tube in place as previously\n described in the “Changing The\n Velcro Neck Band” section of this\n module.", "image": "/media/06-03-08.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-09", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 9, "text": "Protecting Your Tracheostomy\nTube and General Comfort Tips", "image": "/media/06-03-09.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-10", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 10, "text": "Protecting Your Tracheostomy\nTube\nDo not let water get into your\ntracheostomy tube. This means no\nswimming or water sports.\n\nWhen you take a shower, move the\nshower head, so the water hits you\nbelow the tracheostomy tube. When\nyou rinse your head or neck, cup your\nhands over your tracheostomy tube.\nYou can also wring out a washcloth\nand put it over your tracheostomy\ntube.", "image": "/media/06-03-10.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-11", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 11, "text": "Protecting Your Tracheostomy\nTube Continued\n Protect the opening of the\n tracheostomy tube. You can do this\n with a piece of moist gauze, knitted\n tracheostomy cover, or folded\n handkerchief. This is important so\n things like dust, hair, lint, or insects\n cannot get into your tracheostomy\n tube.", "image": "/media/06-03-11.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-12", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 12, "text": "Improving Comfort for Your\nTracheostomy Tube\n\n Take in plenty of liquids either by\n mouth or feeding tube once the\n clinical team has deemed it safe.\n This helps keep your mucus\n thinner and easier to cough out.", "image": "/media/06-03-12.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-13", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 13, "text": "Humidifying the Airway\nHumidiﬁcation helps keep your secretions\nthin, which reduces the risk of developing\nmucus plugs.\n\nWear your tracheostomy mask (also known as\ntracheostomy collar) while sleeping or when\nsitting at home for long periods of time.\n\nUse a humidiﬁer with distilled water to\nmaintain proper airway moisture.", "image": "/media/06-03-13.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-14", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 14, "text": "Humidifying the Airway Continued\nBoth tracheostomy masks and HME caps provide\nhumidiﬁcation of the airway.\n\nA tracheostomy mask or tracheostomy collar\nprovides external humidiﬁed air or oxygen through\nmist.\n\nAn HME (heat and moisture exchanger) cap is a small\ndevice attached to the tracheostomy tube that helps\nretain heat and moisture during breathing.\n\nContact provider if you have any additional\nquestions.", "image": "/media/06-03-14.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-15", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 15, "text": "Speaking Valves\n\nTracheostomy speaking valves are\none-way valves, such as the Passy\nMuir Valve, which opens when you\nbreathe in and closes when you\nbreathe out.\n\nThis redirects airﬂow to enable\nspeech.", "image": "/media/06-03-15.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-16", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 16, "text": "I Can Manage Cancer\n\n\n\nDental Care\nKeep your mouth clean. Brush your teeth and follow up with dentist\nregularly for preventative care.", "image": "/media/06-03-16.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-17", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 17, "text": "Tracheostomy Tube Insertion Difﬁculty Troubleshooting\n1) Stay calm and check for signs of trouble breathing.\n2) Try to reinsert with the same size tube. May use\n water-based lubricant, but do not force the tube back in.\n3) If unsuccessful with the same-size tube, try a tube that is a\n half-size smaller.\n4) If a smaller tube fails, insert a endotracheal tube.\n5) If a tube is not able to be inserted, call 911 and use a\n bag-valve mask to ventilate.", "image": "/media/06-03-17.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-18", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 18, "text": "Emergency Situations\n If you have severe problems with\n breathing and suctioning your\n tracheostomy tube does not\n help, call 911 right away. Go to\n the nearest emergency room.", "image": "/media/06-03-18.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-19", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 19, "text": "When to Be Concerned\nCome to the hospital right\naway if:\n ● Your tracheostomy tube\n comes out, and you are\n unable to put on back in\n yourself\n ● You bleed from your\n tracheostomy stoma or\n notice blood in the tube\n ● You have trouble breathing", "image": "/media/06-03-19.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "06-03-20", "module": 6, "deck": "Staying Safe and Comfortable with a Tracheostomy", "page": 20, "text": "References\nTo learn more about the information in module 6, please visit the following\nwebpages and journal articles.\nHead and Neck Cancer—Patient Version - NCI\nHead and Neck Cancers | Cancers of the Head and Neck\nABOUT HEAD & NECK CANCER | Head & Neck Cancer Alliance\nhttps://www.headandneck.org/hnc-resources/\nFor Patients - American Head & Neck Society\nhttps://doi.org/10.4187/respcare.02920\nhttps://doi.org/10.3322/caac.21343\nhttps://doi.org/10.1177/0194599812460376", "image": "/media/06-03-20.jpg", "url": "https://docs.google.com/presentation/d/1HsNKRi_-hDj-x0VmlhWaWGzr651g0CUbu48VOaSI1eI/view", "draft": false}, {"id": "07-01-1", "module": 7, "deck": "Gastrostomy and Nasogastric Tube Introduction", "page": 1, "text": "Gastrostomy and Nasogastric Tube\nIntroduction", "image": "/media/07-01-1.jpg", "url": "https://docs.google.com/presentation/d/1cmIR6no-Te_1EsP9Azvir59kZMg7CkFr98lHbn5aU-s/view", "draft": true}, {"id": "07-01-2", "module": 7, "deck": "Gastrostomy and Nasogastric Tube Introduction", "page": 2, "text": "What is a gastrostomy (G tube)\nor nasogastric tube (NG tube)?\n A gastrostomy tube (G tube) and a\n nasogastric tube (NG tube) are types of\n feeding tubes that help provide nutrition,\n ﬂuids, and medications when a person is\n unable to eat or drink enough by mouth.\n\n They are essential tools for supporting\n health and healing in people with certain\n medical conditions affecting the mouth,\n throat, esophagus, or digestive system.", "image": "/media/07-01-2.jpg", "url": "https://docs.google.com/presentation/d/1cmIR6no-Te_1EsP9Azvir59kZMg7CkFr98lHbn5aU-s/view", "draft": true}, {"id": "07-01-3", "module": 7, "deck": "Gastrostomy and Nasogastric Tube Introduction", "page": 3, "text": "What is a gastrostomy tube (G tube)?\n\n A G tube is a soft, ﬂexible tube that\n is placed through the skin of the\n abdomen directly into the stomach.\n It provides a way to deliver nutrition,\n ﬂuids, and medications directly into\n the stomach when oral feeding is\n not possible or safe.\n\n G tubes are typically used for\n long-term feeding needs (weeks to Source: Cancer Research UK / Wikimedia Commons\n\n years).", "image": "/media/07-01-3.jpg", "url": "https://docs.google.com/presentation/d/1cmIR6no-Te_1EsP9Azvir59kZMg7CkFr98lHbn5aU-s/view", "draft": true}, {"id": "07-01-4", "module": 7, "deck": "Gastrostomy and Nasogastric Tube Introduction", "page": 4, "text": "What is a nasogastric tube (NG tube)?\n\n An NG tube is a thin, ﬂexible tube\n that is inserted through the nose,\n down the throat, and into the\n stomach.\n\n NG tubes are generally used for\n short-term feeding (days to weeks).\n\n They may also be used to remove\n stomach contents or administer\n medications. Source: Cancer Research UK / Wikimedia Commons", "image": "/media/07-01-4.jpg", "url": "https://docs.google.com/presentation/d/1cmIR6no-Te_1EsP9Azvir59kZMg7CkFr98lHbn5aU-s/view", "draft": true}, {"id": "07-01-5", "module": 7, "deck": "Gastrostomy and Nasogastric Tube Introduction", "page": 5, "text": "Parts of the G tube or NG tube\n\n 1. Feeding tube - soft tube inserted into the\n stomach (G tube) or through the nose (NG\n tube)\n\n 2. External Flange/Bumper- Round disk on\n the outside of the body that holds the tube\n in place\n\n 3. Internal Retention Device- Internal\n balloon or bumper that prevents the tube\n from slipping out", "image": "/media/07-01-5.jpg", "url": "https://docs.google.com/presentation/d/1cmIR6no-Te_1EsP9Azvir59kZMg7CkFr98lHbn5aU-s/view", "draft": true}, {"id": "07-01-6", "module": 7, "deck": "Gastrostomy and Nasogastric Tube Introduction", "page": 6, "text": "Parts of the G tube or NG tube\nContinued\n4. Extension set- connects to the feeding tube\nand allows for feeding or ﬂushing\n\n5. Feeding bag/ syringe- holds liquid nutrition or\nmedication to be given through the tube\n\n6. Cap or clamp- closes off the tube when not in\nuse, preventing leakage or air entry\n\n7. Stoma - the small opening on your body’s\nsurface where a feeding tube (like a G tube or\nNG tube) enters and connects to your stomach\nor digestive system.", "image": "/media/07-01-6.jpg", "url": "https://docs.google.com/presentation/d/1cmIR6no-Te_1EsP9Azvir59kZMg7CkFr98lHbn5aU-s/view", "draft": true}, {"id": "07-02-01", "module": 7, "deck": "Gastrostomy Tube Care", "page": 1, "text": "Gastrostomy Tube (G-Tube) Care", "image": "/media/07-02-01.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-02", "module": 7, "deck": "Gastrostomy Tube Care", "page": 2, "text": "After G-tube surgery", "image": "/media/07-02-02.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-03", "module": 7, "deck": "Gastrostomy Tube Care", "page": 3, "text": "Day 1–7 Post-Insertion\n Clean around the tube and stoma (hole\n where the tube goes through the belly\n into the stomach) with mild soap and\n water using gauze or Q-tips.\n\n Dry thoroughly and place a new piece of\n gauze with a Y cut into the center to\n allow for the gauze to sit around the tube\n and under the external ﬂange.\n\n Do not use lotions, ointments, or creams\n on the skin. Change the gauze at least\n every 24 hours.", "image": "/media/07-02-03.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-04", "module": 7, "deck": "Gastrostomy Tube Care", "page": 4, "text": "I Can Manage Cancer\n\n\nAfter Day 7 Post-Insertion\nRemove the gauze and do not replace it. Continue daily cleaning with\nmild soap and water around the stoma and tube.", "image": "/media/07-02-04.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-05", "module": 7, "deck": "Gastrostomy Tube Care", "page": 5, "text": "After Day 7 Post-Insertion\nContinued\n After cleaning the tube and stoma site,\n rotate or spin the tube in your hand\n several times, this is to make sure it is\n free and can freely spin. If it does not\n rotate or spin, please call the clinic.\n\n Rotate the tube 360° once daily to\n prevent sticking. Rotate the\n ﬂange/bumper feet at least once a day so\n that the feet do not rest on the same area\n of skin as this can cause damage.", "image": "/media/07-02-05.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-06", "module": 7, "deck": "Gastrostomy Tube Care", "page": 6, "text": "After Day 7 Post-Insertion Continued\n\n If you still have the stitch on the tube, please call the clinic to schedule an\n appointment to have this removed.", "image": "/media/07-02-06.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-07", "module": 7, "deck": "Gastrostomy Tube Care", "page": 7, "text": "Nutritional Supplement\nInformation\nBefore you leave the hospital, you and your\nfamily will be taught how to use your feeding\ntube. It’s important to feel comfortable using it\nat home.\n\nThe tube is used to give you liquid nutrition, but\nyou can also use it for other liquids like water or\nelectrolyte drinks.\n\nIt is important to administer the nutritional\nsupplement slowly. Do not to rush the feeding\nas it can cause an upset stomach.", "image": "/media/07-02-07.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-08", "module": 7, "deck": "Gastrostomy Tube Care", "page": 8, "text": "G-Tube General Information", "image": "/media/07-02-08.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-09", "module": 7, "deck": "Gastrostomy Tube Care", "page": 9, "text": "Checking Your G Tube Position\nYour G tube has a number printed on it near\nthe plastic disk that rests against your skin\n(called the external bumper or ﬂange). This\nnumber shows how far the tube is inserted.\nWhen you ﬁrst got your tube, the doctor or\nnurse made a note of this number—it’s your\ncorrect tube position.\n\nCheck this number every day.\n\nThe number should stay the same unless\nyour healthcare provider tells you\notherwise.", "image": "/media/07-02-09.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-10", "module": 7, "deck": "Gastrostomy Tube Care", "page": 10, "text": "Checking Your G Tube Position\nContinued\n If the number is smaller, the tube may\n have pulled out. Please call the clinic\n immediately.\n\n If the number is larger, this may cause\n the tube to be too loose. To correct this,\n gently pull the tube up and slide the\n external ﬂange down to the correct\n marking.", "image": "/media/07-02-10.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-11", "module": 7, "deck": "Gastrostomy Tube Care", "page": 11, "text": "G Tube Daily Care\n The external ﬂange/bumper on the G tube\n should rest snugly on top of the skin, but\n there should be enough room for daily\n cleaning underneath.\n\n After the G tube is inserted, there may be\n a small amount of red or yellowish ﬂuid\n around the new site. This is normal.", "image": "/media/07-02-11.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-12", "module": 7, "deck": "Gastrostomy Tube Care", "page": 12, "text": "G-Tube Daily Care Continued\n Mild leakage around the tube is\n normal. The leakage might be the\n color of the tube feeds,\n stomach/bilious ﬂuid or pinkish.\n\n Place a new piece of gauze with a Y\n cut into the center to allow for the\n gauze to sit around the tube and\n under the external ﬂange. Change\n this as the gauze gets saturated. DO\n NOT allow saturated gauze to sit on\n your skin for any period of time.", "image": "/media/07-02-12.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-13", "module": 7, "deck": "Gastrostomy Tube Care", "page": 13, "text": "G-Tube Daily Care Continued\n Keep the tube at a 90° angle from the\n skin for the ﬁrst 2 weeks. This will\n help prevent leaking and other\n complications.\n\n Tuck at least 1 inch of gauze around\n the tube and on top of the bumper,\n and tape the gauze in place. Do not\n tape the tube itself down to the skin.", "image": "/media/07-02-13.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-14", "module": 7, "deck": "Gastrostomy Tube Care", "page": 14, "text": "Chemical Burns\nIf the skin turns red or is hot, then please\ncall the clinic and upload a picture of the\nsite on MyChart. This is usually a chemical\nburn from the drainage around the tube, if\nthis is conﬁrmed, then follow the following\nsteps:\n -1 Keep the site as dry as possible, even if\n this means replacing the gauze\n frequently.\n -2 Place a thin layer of diaper rash cream\n on the skin around the tube site to\n protect it from drainage.", "image": "/media/07-02-14.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-15", "module": 7, "deck": "Gastrostomy Tube Care", "page": 15, "text": "Showering\nYou may shower 48 hours after tube\ninsertion.\n\nYou may NOT submerge your tube\nsite (in a bathtub/swimming\npool/lake/etc.) until at least 2 weeks\nafter insertion.\n\nIt is important to cleanse the site with\nmild soapy water and thoroughly dry\nthe site after it gets wet.", "image": "/media/07-02-15.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-16", "module": 7, "deck": "Gastrostomy Tube Care", "page": 16, "text": "G-Tube Maintenance\n Flush your tube with 30 mL of drinking\n water:\n - Before and after feedings\n - Before and after medications\n\n Regular ﬂushing will help to prevent the\n tube from clogging. If any feeding or\n medication is left in the tube, this puts\n your tube at a high risk of clogging.\n\n Some discoloration of the G-tube over\n time is normal.", "image": "/media/07-02-16.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-17", "module": 7, "deck": "Gastrostomy Tube Care", "page": 17, "text": "Replacing Your G-Tube\n Replace your G-tube approximately\n every 6 months, or sooner if\n damaged. Please call the clinic for an\n appointment to replace your tube.\n\n If the tube cracks or the connections\n come loose sooner, please call the\n clinic for a replacement sooner.", "image": "/media/07-02-17.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-18", "module": 7, "deck": "Gastrostomy Tube Care", "page": 18, "text": "Oral Care\n It is important to maintain good oral care\n even if you may not be eating/drinking\n anything by mouth. This can help prevent\n complications like infection.\n\n Please gently brush your teeth, gums,\n tongue, and palate at least twice a day if\n you have been told it is safe to do so. You\n should also rinse with mouthwash if it is\n deemed safe (Biotene can help if you are\n experiencing dry mouth).", "image": "/media/07-02-18.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-19", "module": 7, "deck": "Gastrostomy Tube Care", "page": 19, "text": "I Can Manage Cancer\n\n\n\nOral Care\nIf you are at a high risk of aspiration, you may need to use oral swabs\nand a suction catheter.", "image": "/media/07-02-19.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-20", "module": 7, "deck": "Gastrostomy Tube Care", "page": 20, "text": "Troubleshooting Tube Issues", "image": "/media/07-02-20.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-21", "module": 7, "deck": "Gastrostomy Tube Care", "page": 21, "text": "If Your Tube is Clogged\n If you are unable to ﬂush your tube or\n meet signiﬁcant resistance when\n trying to ﬂush, your tube is likely\n clogged. Don’t panic! Here are a few\n things you can try to unclog your\n tube:\n - Make sure your tube is not\n 1\n clamped\n - If using a valve at the end of your\n 2\n tube, make sure it is in the correct\n position", "image": "/media/07-02-21.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-22", "module": 7, "deck": "Gastrostomy Tube Care", "page": 22, "text": "If Your Tube is Clogged\nContinued\n - Carefully massage the tube\n 3\n between your thumb and index\n ﬁnger to try to break up any\n clogs. Be careful not to tug or\n pull hard on your tube to keep it\n in place.\n 4\n - Hook up an empty syringe and\n slowly and gently try to draw\n back any material that is stuck.", "image": "/media/07-02-22.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-23", "module": 7, "deck": "Gastrostomy Tube Care", "page": 23, "text": "If Your Tube is Clogged Continued\n5 Try using warm water to unclog the tube. Use water that is hot but\n not too hot—it should be warm enough to drink comfortably. Gently\n push the warm water into the tube and let it sit for 10 to 15 minutes.\n Then, try ﬂushing the tube again. If you still encounter resistance,\n repeat the process:\n - Add more warm water\n - Gently massage the tube\n - Wait another 10 to 15 minutes\n\n Keep trying until the tube ﬂushes easily.", "image": "/media/07-02-23.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-24", "module": 7, "deck": "Gastrostomy Tube Care", "page": 24, "text": "If Your Tube is Clogged\nContinued\nIf your tube remains clogged after\nattempting the 6 steps described\npreviously, you should present to the\nemergency room to either let medical\nprofessionals attempt to unclog it or have\nthe tube exchanged.", "image": "/media/07-02-24.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-25", "module": 7, "deck": "Gastrostomy Tube Care", "page": 25, "text": "If Your Tube is Clogged\nContinued\nDo NOT try to ﬂush your tube with a large\namount of force. This can cause the tubing\nto bubble and even burst or leak. If you\nnotice that your tube is leaking (not from\nyour skin but from the actual tubing itself)\nyou will need to have your tube replaced.\n\nDo NOT attempt to insert anything into\nyour tube to mechanically push the clog\nout. This is likely to damage the tube and\nis not safe.", "image": "/media/07-02-25.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-02-26", "module": 7, "deck": "Gastrostomy Tube Care", "page": 26, "text": "Emergency Situations\n If your tube comes out within 4\n weeks of placement, go to the ER\n immediately. The hole can close\n within hours.\n\n Call the UTSW MDSC Surgery Clinic\n at 214-645-2900 and/or the on-call\n surgeon for instructions.\n\n This is an emergency. Do not wait\n until morning.", "image": "/media/07-02-26.jpg", "url": "https://docs.google.com/presentation/d/1WPgKZcDBWWcR4tP_g4NfWmP26U3r2BVHiJmyA1NUw20/view", "draft": true}, {"id": "07-03-01", "module": 7, "deck": "Nasogastric Tube Care", "page": 1, "text": "Nasogastric (NG) Tube Care", "image": "/media/07-03-01.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-02", "module": 7, "deck": "Nasogastric Tube Care", "page": 2, "text": "The Nasogastric (NG) Tube\n\n ● The NG tube is used to deliver\n nutrients from the nose to the\n stomach.\n\n ● If the tube is only needed for\n shorter periods of time, the\n NG tube is usually preferred\n over the G tube.\n\n\n Source: Cancer Research UK / Wikimedia Commons", "image": "/media/07-03-02.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-03", "module": 7, "deck": "Nasogastric Tube Care", "page": 3, "text": "How is the NG tube secured?\n\n ● Often a nasal bridle system is used to\n secure the NG tube. The system has\n small magnets to help keep the tube\n in the nose, which should not be\n painful.\n ● This decreases risk of accidental\n removal including during feedings.\n However, if the bridle is pulled this\n may result in discomfort.", "image": "/media/07-03-03.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-04", "module": 7, "deck": "Nasogastric Tube Care", "page": 4, "text": "Nutritional Supplement\nInformation\n● Before you leave the hospital, you and your\n family will be taught how to use your\n feeding tube. It’s important to feel\n comfortable using it at home.\n\n● The tube is used to give you liquid nutrition,\n but you can also use it for other liquids like\n water or electrolyte drinks.\n\n● It is important to administer the nutritional\n supplement slowly. Do not to rush the\n feeding as it can cause an upset stomach.", "image": "/media/07-03-04.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-05", "module": 7, "deck": "Nasogastric Tube Care", "page": 5, "text": "How Tube Feeds Are Delivered\n\n● Bolus feeds: Formula is given manually\n using a syringe several times per day.\n\n● Pump feeds: Formula is delivered slowly\n using a feeding pump (e.g., Kangaroo\n pump), often overnight.\n\n● Your care team will choose the method\n based on your nutritional needs and\n comfort.", "image": "/media/07-03-05.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-06", "module": 7, "deck": "Nasogastric Tube Care", "page": 6, "text": "NG Tube Clogs\n ● To help keep the tube working\n properly, try to avoid putting\n crushed-up medications or thick\n liquids through the tube, as these\n can cause clogs.\n\n ● If the tube does get clogged, a\n small amount of carbonated soda\n (like ginger ale or cola) may help\n clear it. If that doesn’t work, you\n may need to visit your doctor’s\n ofﬁce or the emergency room.", "image": "/media/07-03-06.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-07", "module": 7, "deck": "Nasogastric Tube Care", "page": 7, "text": "Comfort Tips for Nasogastric\n(NG) Tube Use\n ● Wearing a nasal feeding tube can\n feel uncomfortable at ﬁrst, and\n it’s common to become very\n aware of its presence.\n\n ● The tube may occasionally get\n tugged or caught on clothing or\n other objects. While it is unlikely\n to come out, accidental pulling\n can cause discomfort.", "image": "/media/07-03-07.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-08", "module": 7, "deck": "Nasogastric Tube Care", "page": 8, "text": "Comfort Tips for Nasogastric\n(NG) Tube Use\n ● To help manage this discomfort, some\n patients ﬁnd it helpful to secure the\n tube by gently pinning it to the collar\n of their shirt or by looping it up and\n around the ear to keep it out of the\n way.\n\n ● Finding a method that works for you\n can make daily activities more\n comfortable and help you feel more at\n ease while wearing the tube.", "image": "/media/07-03-08.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-09", "module": 7, "deck": "Nasogastric Tube Care", "page": 9, "text": "Removing the NG Tube\n\n ● When it’s time to remove the\n feeding tube, the process is\n quick and can be done during\n a scheduled clinic\n appointment.\n\n ● Removing the NG tube does\n not require a return to the\n hospital.", "image": "/media/07-03-09.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-10", "module": 7, "deck": "Nasogastric Tube Care", "page": 10, "text": "Warning signs (to contact your provider)\n\n ● Bright green output\n\n ● Bloody drainage\n\n ● Increased nausea/vomiting\n\n ● Sudden increase in suction\n output", "image": "/media/07-03-10.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "07-03-11", "module": 7, "deck": "Nasogastric Tube Care", "page": 11, "text": "ADD REFERENCE SLIDE", "image": "/media/07-03-11.jpg", "url": "https://docs.google.com/presentation/d/1dQVB6c6hRkw-rjr2dLNhEPkPZ7AqFnclcVr_DzCq0tY/view", "draft": true}, {"id": "08-01-01", "module": 8, "deck": "Management of Incisions", "page": 1, "text": "Management of Incisions", "image": "/media/08-01-01.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-02", "module": 8, "deck": "Management of Incisions", "page": 2, "text": "Wound Care for Incisions\nIncision: A surgical cut made by the\ndoctor to access the treatment area,\nwhich is usually closed with stitches or\nstaples.\n\nDressings should be changed regularly\nto prevent infection of the wound site.\n\nIf the dressings are more complex, a\nhome health nurse may be able to come\nto your home to change the dressings.\nTalk to your doctor about this option.", "image": "/media/08-01-02.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-03", "module": 8, "deck": "Management of Incisions", "page": 3, "text": "How do I avoid irritating the\nincision area?\n\n● Wear loose-ﬁtting clothing over the\n donor site.\n● Avoid rubbing, soaking, or scrubbing\n the area\n● Avoid bathtubs or pools\n● Don’t expose it to direct sunlight\n because the skin is extra sensitive", "image": "/media/08-01-03.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-04", "module": 8, "deck": "Management of Incisions", "page": 4, "text": "How to prevent infection?\n● Wash your hands before touching the\n area.\n● Don’t apply creams or ointments unless\n prescribed.\n● Watch for signs of infection:\n ○ Increased redness or swelling\n ○ Yellow or green drainage\n ○ Foul smell\n ○ Fever or chills", "image": "/media/08-01-04.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-05", "module": 8, "deck": "Management of Incisions", "page": 5, "text": "I Can Manage Cancer\n\n\nWhen is pain concerning?\nPain is worrisome if it is continually\nincreasing over several days.\n\nNew or worsening pain at the\nincision or donor site is also\nworrisome.", "image": "/media/08-01-05.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-06", "module": 8, "deck": "Management of Incisions", "page": 6, "text": "When should I be worried about\nswelling?\nIf swelling is gradually worsening over\nseveral consecutive days, this may be a\ncause for concern, especially if there is\nalso redness of the neck or face.", "image": "/media/08-01-06.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-07", "module": 8, "deck": "Management of Incisions", "page": 7, "text": "When should I be worried about\ndrainage?\nNew or foul smelling drainage is worrisome\nespecially if you also have fever over\n100.4°F (38°C).\n\nCloudy drainage is is a warning sign as well.\nTalk to your surgical team.", "image": "/media/08-01-07.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-08", "module": 8, "deck": "Management of Incisions", "page": 8, "text": "I Can Manage Cancer\n\n\n\nSaltwater Mouthwash\nSaltwater mouth rinses are commonly recommended after many HNC\nsurgeries to promote oral hygiene, reduce infection risk, and support\nhealing.", "image": "/media/08-01-08.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-09", "module": 8, "deck": "Management of Incisions", "page": 9, "text": "When to use a I Can Manage Cancer\n\n\n\n\nsaltwater mouthwash?\n ● Oral Cavity Surgeries:\n ○ Glossectomy (partial or total tongue removal)\n ○ Mandibulectomy\n ○ Maxillectomy\n ○ Oral composite resection\n ○ Mouth cancer surgery\n ● Pharyngectomy\n ● Laryngectomy (total or partial)\n\nThese surgeries involve direct incisions in the mouth.\nSaltwater rinses help keep wounds clean, reduce bacteria,\nand prevent infection without irritating the surgical site.", "image": "/media/08-01-09.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-01-10", "module": 8, "deck": "Management of Incisions", "page": 10, "text": "How to use the mouthwash?\nSupplies needed:\n● 16 ounce bottle of water\n● 1 teaspoon salt\n● 1 teaspoon baking soda\n\n1. Keep a bottle by the bathroom and\n kitchen sinks\n2. Rinse, gargle, and spit after meals,\n before bed, and anytime your mouth\n feels dry or sore", "image": "/media/08-01-10.jpg", "url": "https://docs.google.com/presentation/d/1PqrgG967m_NDzVoJwwFIRl91y2gw0tvBrw8Wc5mVmJM/view", "draft": false}, {"id": "08-02-01", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 1, "text": "Management of Skin Graft Harvest/\nDonor Site", "image": "/media/08-02-01.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-02", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 2, "text": "What is a donor site?\n You have a skin graft donor site where\n a thin layer of skin was removed (a\n split-thickness skin graft) to help repair\n another area.\n\n Most commonly, the skin graft is taken\n from the thigh. The donor site may look\n like a rug burn or road rash—this is\n completely normal.", "image": "/media/08-02-02.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-03", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 3, "text": "Understanding the Donor Site\n Only the outermost layer of skin is\n removed. The full thickness of the skin\n (dermis) is not affected.\n\n Because the wound is very superﬁcial,\n it generally heals well with minimal\n risk of infection.\n\n If an infection does occur, it is usually\n very mild.", "image": "/media/08-02-03.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-04", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 4, "text": "Initial Dressing – Mepilex Ag\n Your donor site has been covered with\n a dressing called Mepilex Ag, which\n contains silver to help prevent infection\n and promote healing.\n\n This dressing may look bloody or\n crusty over time. This is expected and\n normal.", "image": "/media/08-02-04.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-05", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 5, "text": "Caring for the Mepilex Ag\nDressing\n Keep the Mepilex Ag dressing in place\n until it falls off on its own. Do not\n remove it unless instructed to do so by\n your doctor.\n\n If the edges begin to peel up, you may\n trim them carefully with clean scissors", "image": "/media/08-02-05.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-06", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 6, "text": "What to do if the Mepilex\ncomes off early?\n If the dressing comes off early or is\n removed, some bleeding may occur.\n\n Apply gentle pressure to stop any\n bleeding. This is not cause for concern.", "image": "/media/08-02-06.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-07", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 7, "text": "What to do after the Mepilex comes\noff?\nOnce the Mepilex Ag dressing has naturally fallen\noff, begin daily dressing care as follows:\n1. There is no speciﬁc need to clean the donor\n area. It is okay to shower and to let water run\n over the site. Do not scrub or soak the area. Pat\n it dry with a clean towel. Do not submerge it in\n a tub or pool.\n2. Apply a thin layer of Vaseline or Aquaphor to\n the wound.", "image": "/media/08-02-07.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-08", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 8, "text": "What to do after the Mepilex comes\noff (continued)?\n3. Cover the area with a non-adherent dressing, such\nas Vaseline gauze, Adaptid, Xeroform, or Telfa.\n4. Place a layer of regular gauze over the\nnon-adherent dressing and tape it down. Do not place\nregular gauze directly on the wound, as it may stick\nand cause bleeding when removed.\n5. Change the dressing once per day, or more often if\nit becomes wet or dirty or develops an odor.\n6. If the dressing starts to stick to the wound, add\nmore Vaseline or Aquaphor to keep the area moist.", "image": "/media/08-02-08.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-09", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 9, "text": "What to expect during healing?\nSome bleeding is normal, especially during\ndressing changes, because the healing\ntissue is very delicate. If bleeding occurs:\n● Apply ﬁrm pressure with the dressing\n material for several minutes.\n● You may also use gauze ﬂuffs and\n secure them with gentle pressure\n using tape.", "image": "/media/08-02-09.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-10", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 10, "text": "How do I know the wound is\nhealed?\nThe wound is considered healed when a\nnew layer of skin has formed and there is\nno longer any crusting or scabbing.\n\nThe new skin is usually pink or purple in\ncolor and may look different or shinier from\nthe surrounding skin at ﬁrst. This is normal,\nand the color will even out over time.\n\nMost donor sites heal within 2-3 weeks", "image": "/media/08-02-10.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-11", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 11, "text": "How do I care for the new skin\nafter healing is complete?\nOnce healed, the new skin is more fragile\nand can bleed if scratched or rubbed.\n\nWhile a dressing is no longer needed, you\nmay keep it covered with an ACE bandage\nor gauze if it is sensitive.\n\nYou may apply a non-adherent dressing\nwith gentle pressure if any minor bleeding\noccurs.", "image": "/media/08-02-11.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-02-12", "module": 8, "deck": "Management of Skin Graft Harvest/ Donor Sites", "page": 12, "text": "Long-term Skin Care\nAfter new skin has formed, you may begin\napplying vitamin E lotion or other\nover-the-counter scar cream to help with the\nappearance of the scar.\nThe new skin should be protected from direct\nsunlight to reduce the chance of discoloration. This\nis especially true during the ﬁrst year.\nYou may use sunscreen (SPF 30 or higher) on the\narea once the skin has completely healed. Do not\nsubmerge the area in bathtubs, swimming pools,\nlakes, or hot tubs until the new skin has fully\nformed.", "image": "/media/08-02-12.jpg", "url": "https://docs.google.com/presentation/d/1JBBfOCsC7Ba4So3fTJ8_AojHjLF3isPdpSIWwSS2J2E/view", "draft": false}, {"id": "08-03-1", "module": 8, "deck": "General Surgical Drains and Drain Management", "page": 1, "text": "General Surgical Drains and Drain\nManagement", "image": "/media/08-03-1.jpg", "url": "https://docs.google.com/presentation/d/1vYJDEKud_pFqGDKd3_zZGPU4yC1TE-c6wdKSsP1VA4o/view", "draft": false}, {"id": "08-03-2", "module": 8, "deck": "General Surgical Drains and Drain Management", "page": 2, "text": "What is a drain tube?\nA drainage tube is left in the surgical\nwound at the time of surgery. This tube is\nabout ¼\" thick and is necessary to drain\nﬂuid that accumulates because of\nsurgery.\n\nUsually, the drain stays in place for a\ncouple of weeks and patients go home\nwith this drain.\n drain tube", "image": "/media/08-03-2.jpg", "url": "https://docs.google.com/presentation/d/1vYJDEKud_pFqGDKd3_zZGPU4yC1TE-c6wdKSsP1VA4o/view", "draft": false}, {"id": "08-03-3", "module": 8, "deck": "General Surgical Drains and Drain Management", "page": 3, "text": "How do I take care of my drain?\n1 The drain needs to be emptied twice daily (or more\n depending on the amount of drainage) and the output needs\n to be recorded.\n\n2 The surgeon will want to know the daily output of the drain\n in milliliters (ML) for each 24-hour period.\n\n3 When the drain output is less than 30-50 ML per 24-hour period, it\n may be ready to be removed.", "image": "/media/08-03-3.jpg", "url": "https://docs.google.com/presentation/d/1vYJDEKud_pFqGDKd3_zZGPU4yC1TE-c6wdKSsP1VA4o/view", "draft": false}, {"id": "08-03-4", "module": 8, "deck": "General Surgical Drains and Drain Management", "page": 4, "text": "Will ﬂuid accumulate after\nthe drain tube is removed?\nOccasionally, ﬂuid continues to accumulate\neven after the drain is removed.\n\nThis can lead to swelling of the skin that\nfeels soft, like a water balloon.\n\nWhen you stand up the swelling will drift\ndown to the lowest portion of the surgical\nsite.", "image": "/media/08-03-4.jpg", "url": "https://docs.google.com/presentation/d/1vYJDEKud_pFqGDKd3_zZGPU4yC1TE-c6wdKSsP1VA4o/view", "draft": false}, {"id": "08-03-5", "module": 8, "deck": "General Surgical Drains and Drain Management", "page": 5, "text": "What should I do if ﬂuid accumulates\nafter the drain is removed?\n1 This ﬂuid (called a seroma) usually needs to be drained but\n the procedure is easy and usually done in the ofﬁce.\n\n2 The skin overlying the area is usually numb from the surgery\n and the ﬂuid can be drained through a small needle inserted\n through the skin.\n\n3 Sometimes this can require several drainage procedures if the\n ﬂuid keeps reaccumulating.", "image": "/media/08-03-5.jpg", "url": "https://docs.google.com/presentation/d/1vYJDEKud_pFqGDKd3_zZGPU4yC1TE-c6wdKSsP1VA4o/view", "draft": false}, {"id": "08-03-6", "module": 8, "deck": "General Surgical Drains and Drain Management", "page": 6, "text": "How long can I wait to get the ﬂuid drained?\nThis is not urgent – you do not need to come in the same day for\nthis problem.\n\nWaiting even a week or two will be okay", "image": "/media/08-03-6.jpg", "url": "https://docs.google.com/presentation/d/1vYJDEKud_pFqGDKd3_zZGPU4yC1TE-c6wdKSsP1VA4o/view", "draft": false}, {"id": "08-04-1", "module": 8, "deck": "Management of Wound VACs", "page": 1, "text": "Management of Wound Vacs", "image": "/media/08-04-1.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-2", "module": 8, "deck": "Management of Wound VACs", "page": 2, "text": "What is a wound VAC ?\nA Wound VAC (Vacuum-Assisted\nClosure) is a medical device that\nsupports wound healing through\nnegative pressure therapy.\n\nThis increases blood ﬂow in the wound\nand helps with healing.", "image": "/media/08-04-2.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-3", "module": 8, "deck": "Management of Wound VACs", "page": 3, "text": "How does it work?\nIt involves placing a foam dressing\nwithin the wound bed, sealing the area\nwith an adhesive drape, and connecting\nit to a vacuum pump via tubing.\n\nThe system gently removes ﬂuid and\ndebris, reduces swelling, and helps\ndraw the edges of the wound together.", "image": "/media/08-04-3.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-4", "module": 8, "deck": "Management of Wound VACs", "page": 4, "text": "Why use a wound VAC?\nWound VACs are commonly used after major\nhead and neck cancer surgeries, especially\nwhen there are large or complex surgical\nwounds, tissue ﬂaps, or areas at high risk for\nﬂuid collection.\nThey help the area heal by removing ﬂuid,\nimproving blood ﬂow, preventing infection,\nand protecting tissue ﬂaps.", "image": "/media/08-04-4.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-5", "module": 8, "deck": "Management of Wound VACs", "page": 5, "text": "What to expect?\nThe VAC device will remain in place\ncontinuously, typically connected to portable\nsuction.\nThe dressing is sealed tightly to the skin, and\nyou may feel a light pulling or suction\nsensation. Mild discomfort can occur but should\nnot be severe.\nThe dressing is usually changed every 2–3 days\nby trained providers, either in the hospital or\nclinic setting.", "image": "/media/08-04-5.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-6", "module": 8, "deck": "Management of Wound VACs", "page": 6, "text": "Daily management of the\nWound VAC\nAvoid disconnecting or turning off the\nWound VAC unless instructed. Keep the\ntubing free of kinks and below the wound\nsite to allow proper drainage.", "image": "/media/08-04-6.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-7", "module": 8, "deck": "Management of Wound VACs", "page": 7, "text": "When to Call Your Care\nTeam\n\nMake sure the seal is intact—if you hear air\nleaks or see dressing lifting, notify your care\nteam. If the canister becomes full or alarms\nsound, contact your provider or home health\nnurse.", "image": "/media/08-04-7.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-04-8", "module": 8, "deck": "Management of Wound VACs", "page": 8, "text": "Hygiene and activity\nprecautions\n● Do not shower while the VAC is in place\n unless your provider has approved a\n special cover or dressing.\n● Avoid submerging the VAC or dressing in\n water.\n● Be cautious with neck movement and\n avoid pulling on the tubing.\n● Limit strenuous activities and avoid laying\n directly on the VAC dressing site to\n prevent pressure disruption.", "image": "/media/08-04-8.jpg", "url": "https://docs.google.com/presentation/d/1hBgrfCqXLJ-RISognPArboOiI228uF8tZOZuukmUQMo/view", "draft": false}, {"id": "08-05-1", "module": 8, "deck": "Lymphedema", "page": 1, "text": "Lymphedema", "image": "/media/08-05-1.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-2", "module": 8, "deck": "Lymphedema", "page": 2, "text": "I Can Manage Cancer\n\n\n\nWhat is cancer-related Lymphedema\n● Lymphedema refers to swelling caused by the buildup of lymph ﬂuid beneath the\n skin. The lymphatic system normally functions to collect and transport excess ﬂuid,\n proteins, and waste products from body tissues back into the bloodstream. It also\n plays a key role in ﬁltering out bacteria, viruses, and other harmful substances.\n● When lymph nodes or vessels are damaged or obstructed, lymph ﬂuid cannot drain\n effectively. This results in ﬂuid accumulation and swelling.", "image": "/media/08-05-2.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-3", "module": 8, "deck": "Lymphedema", "page": 3, "text": "What are the causes?\n Cancer related lymphedema occurs when\n the lymphatic system is blocked or\n damaged from the effects of cancer cancer\n treatments.\n\n Common causes:\n ● Surgery to remove lymph nodes\n ● Radiation treatment for cancer\n ● Tumor growth from cancer", "image": "/media/08-05-3.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-4", "module": 8, "deck": "Lymphedema", "page": 4, "text": "What increases the risk?\n\n The following factors may make you more\n likely to develop this complication:\n\n ● Older age\n ● Obesity\n ● Rheumatoid or inﬂammatory arthritis\n ● History of lymphedema", "image": "/media/08-05-4.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-5", "module": 8, "deck": "Lymphedema", "page": 5, "text": "What are the physical exam\nsigns of lymphedema?\n ● Sensation of heaviness, tightness, or\n fullness in the affected area\n ● Mild swelling that may come and go,\n especially at the end of the day\n ● Clothing, jewelry, or compression\n garments feeling tighter than usual\n ● Skin changes, such as slight pufﬁness,\n decreased elasticity, or indentation when\n pressed\n ● Aching, tingling, or discomfort in the\n limb or region\n ● Reduced range of motion in the neck,\n shoulder, or affected limb", "image": "/media/08-05-5.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-6", "module": 8, "deck": "Lymphedema", "page": 6, "text": "How to treat lymphedema?\n Compression Garments\n ● Sleeves or stockings to maintain pressure\n ● Elevated the limb above the level of your heart if\n possible\n Compression Bandaging\n ● Multi-layer wraps to reduce swelling\n Pneumatic Compression Pump\n ● External pump with inﬂatable sleeve to promote\n drainage\n Surgery (for severe cases)\n ● Reserved for chronic, refractory lymphedema\n Complete Decongestive Therapy (CDT)\n ● Manual lymphatic drainage (specialized massage)\n ● Compression therapy\n ● Gentle exercise\n ● Skin care", "image": "/media/08-05-6.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-7", "module": 8, "deck": "Lymphedema", "page": 7, "text": "Instructions at home\n\n DO DON’T\n ● Check your skin and the affected area ● Walk barefoot\n everyday for signs of increased ● Have your blood pressure checked on\n swelling, irritation or redness the affected limb\n ● Keep the affected area clean and dry ● Apply ice to the affected area\n ● Apply lotion to prevent dry skin ● Use a heating pad over the affected\n ● Protect your skin from cuts and injuries area\n ● Protect the affected area from extreme ● Wear right clothes, shoes, or jewelry\n cold ● Sit with your legs crossed\n ● Avoid medical procedures such as\n blood draws and injections in the\n affected limb", "image": "/media/08-05-7.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-8", "module": 8, "deck": "Lymphedema", "page": 8, "text": "Contact a healthcare provider\nIF….\n ● You have a fever\n ● You have a cut or injury that does\n not heal\n ● You have redness or pain in the\n affected area\n ● You have new or increased swelling\n ● You develop purplish spots or sores\n on your affected limb", "image": "/media/08-05-8.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-05-9", "module": 8, "deck": "Lymphedema", "page": 9, "text": "Seek immediate medical\nattention IF…..\n ● You develop a skin rash\n ● You have chills or sweating\n ● You have trouble breathing", "image": "/media/08-05-9.jpg", "url": "https://docs.google.com/presentation/d/1sDI6wdNREACxf35X4dvHeuOCN7kV4aHYD8QADa88GN0/view", "draft": false}, {"id": "08-06-01", "module": 8, "deck": "Exercises to Help With Recovery", "page": 1, "text": "Exercises to Help With Recovery", "image": "/media/08-06-01.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-02", "module": 8, "deck": "Exercises to Help With Recovery", "page": 2, "text": "Sections in this Module\n\n\n Dysphagia Strategies and Spinal Accessory Nerve\n Exercises Exercises\n\n\n\n\n Click on the box to jump to each section", "image": "/media/08-06-02.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-03", "module": 8, "deck": "Exercises to Help With Recovery", "page": 3, "text": "Dysphagia Strategies and\n Exercises", "image": "/media/08-06-03.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-04", "module": 8, "deck": "Exercises to Help With Recovery", "page": 4, "text": "What is Dysphagia?\n\n● Dysphagia, or difﬁculty swallowing, is a common\n postoperative symptom.\n● Postoperative dysphagia can result from swelling,\n nerve irritation, muscle weakness, or structural\n changes that disrupt the normal swallowing\n mechanism.", "image": "/media/08-06-04.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-05", "module": 8, "deck": "Exercises to Help With Recovery", "page": 5, "text": "Speech Therapy\n ● Speech therapy plays an integral role in your\n ability to swallow and is essential to optimize\n your health while undergoing treatment\n ● A wide range of conditions, illnesses, and their\n treatments can disrupt the process of\n swallowing which can lead to choking,\n malnutrition, and other problems\n ● UTSW Speech Therapy department will\n provide you more strategies to successfully\n navigate your nutritional status before and\n after surgery.", "image": "/media/08-06-05.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-06", "module": 8, "deck": "Exercises to Help With Recovery", "page": 6, "text": "Exercise #1: Jaw Resistance\n\n1. Slightly open your mouth and press chin\n against the palm\n2. Let your elbow be on your knee\n3. Feel the engagement in the center neck\n and below the chin\n4. Sustain the position for 10 seconds\n5. Keep breathing (5 repetitions, 3-5 times\n a day)", "image": "/media/08-06-06.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-07", "module": 8, "deck": "Exercises to Help With Recovery", "page": 7, "text": "Exercise #2: Tongue Hold\n(Masako)\n1. Hold your tongue between your teeth\n2. Swallow while keeping your tongue\n between your teeth\nThis exercise strengthens the muscles in the\nback of your throat.\n(5 repetitions, 3-5 times a day)", "image": "/media/08-06-07.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-08", "module": 8, "deck": "Exercises to Help With Recovery", "page": 8, "text": "Exercise #3: Effortful\nSwallow\n1. Swallow with extra force\n2. Feel your tongue against the roof of your\n mouth as you swallow\n (5 repetitions, 3-5 times a day)", "image": "/media/08-06-08.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-09", "module": 8, "deck": "Exercises to Help With Recovery", "page": 9, "text": "Exercise #4: Tongue\nPull-back\n1. Say the “k-k-k-k-k” harshly\n2. Feel the engagement of the back of the\n tongue\n (5 repetitions, 3-5 times a day)", "image": "/media/08-06-09.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-10", "module": 8, "deck": "Exercises to Help With Recovery", "page": 10, "text": "Exercise #5: Pharyngeal\nConstriction\n1. Say a high pitched “ee” sound for 5\n seconds\n2. Watch yourself in the mirror and make\n sure your neck muscles are engaged\n (5 repetitions, 3-5 times a day)", "image": "/media/08-06-10.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-11", "module": 8, "deck": "Exercises to Help With Recovery", "page": 11, "text": "Exercise #6: Mendelsohn\nManeuver\n1. Feel the top of your larynx (Adam’s\n apple) moving upward during a swallow\n2. At the highest point of your swallow\n (when you hear the clicking sound), try to\n hold the larynx up.\n3. Hold your breath for 5 seconds.\nThis exercise helps lift your larynx and opens\nthe top of your food pipe (esophagus). This\ncan help clear out any leftover food stuck in\nyour throat. (5 repetitions, 3-5 times a day)", "image": "/media/08-06-11.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-12", "module": 8, "deck": "Exercises to Help With Recovery", "page": 12, "text": "When are these exercises useful?\n Helpful for:\n\n ● Laryngectomy (partial or total)\n ● Oropharynx surgery\n ● Radiation to throat or neck\n\n Beneﬁts:\n\n ● Keeps swallowing muscles strong\n ● Speeds up recovery after treatment\n ● Lowers risk of feeding tube or\n aspiration\n ● Helps you keep eating by mouth\n longer", "image": "/media/08-06-12.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-13", "module": 8, "deck": "Exercises to Help With Recovery", "page": 13, "text": "Spinal Accessory Nerve\n Exercises", "image": "/media/08-06-13.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-14", "module": 8, "deck": "Exercises to Help With Recovery", "page": 14, "text": "What is the spinal accessory\nnerve?\nThe spinal accessory nerve is located in\nthe back of your upper shoulder. When\nthe nerve is injured, it can cause pain and\ncan greatly reduce the range of motion in\nthat shoulder", "image": "/media/08-06-14.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-15", "module": 8, "deck": "Exercises to Help With Recovery", "page": 15, "text": "Exercise #1: Shoulder\nShrugs\n1. Shoulder shrugs can strengthen the injured\n area.\n2. Stand with your legs hip-distance apart.\n3. Shrug your shoulders up and lower them\n down as far as you comfortably can\n4. Do a total of 10 repetitions\n5. As you progress hold weights in your\n hands as you do this exercise", "image": "/media/08-06-15.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-16", "module": 8, "deck": "Exercises to Help With Recovery", "page": 16, "text": "Exercise #2: Supine\nShoulder Rotation\n1. Use a bed or mat for another\n strengthening exercise\n2. Lie on your back and bend your elbows\n3. Your upper arm should be at your side\n horizontal to the ground and your lower\n arms in the air perpendicular to the\n ground\n4. Slowly bring your hands down to the mat\n or bed and back up in the air\n5. Do a total of 10 repetitions", "image": "/media/08-06-16.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-17", "module": 8, "deck": "Exercises to Help With Recovery", "page": 17, "text": "Exercise #3: Shoulder\nElevation with Wand\n1. The American Physical Therapy Association\n suggests this exercise that involves using a\n cane, broomstick or dowel\n2. Lie on your back holding the cane, broomstick or\n dowel with your hands resting on your upper\n legs\n3. Your hands should be about 18 inches apart, and\n your palms should be facing up\n4. Slowly lift your arms as far over your head as is\n comfortable, leading with the uninjured arm\n5. Hold for 5 seconds and return to your original\n position do a total of ﬁve repetitions", "image": "/media/08-06-17.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-18", "module": 8, "deck": "Exercises to Help With Recovery", "page": 18, "text": "Exercise #4: Wall Slide\n1. The APTA also recommends a standing\n exercise to rehabilitate a spinal accessory\n nerve injury\n2. Stand close to a wall, facing sideways\n3. Slide your injured arm up the wall using\n your ﬁngers to walk up the wall, palms\n facing down\n4. Keep sliding your hand until you feel a\n stretch and hold the position for 5 seconds\n5. Slowly drop your arm and do a total of ﬁve\n repetitions\n6. Do not make the mistake of turning your\n body towards the wall", "image": "/media/08-06-18.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-19", "module": 8, "deck": "Exercises to Help With Recovery", "page": 19, "text": "Exercise #5: Wall Press\n1. Stand facing a wall for this\n strengthening exercise\n2. You should be two to three feet away\n from the wall\n3. Put your hands on the wall at\n shoulder level and press against it\n4. As you do this, squeeze your shoulder\n blades together and then separate\n them\n5. Return to your starting position\n6. Do a total of 10 repetitions", "image": "/media/08-06-19.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-06-20", "module": 8, "deck": "Exercises to Help With Recovery", "page": 20, "text": "When are these exercises useful?\n Helpful for: Neck dissection surgery\n (especially levels II–V)\n\n Beneﬁts:\n\n ● Protects shoulder and neck\n strength\n ● Reduces risk of shoulder pain and\n stiffness\n ● Improves posture and range of\n motion\n ● Easier return to normal activity after\n surgery", "image": "/media/08-06-20.jpg", "url": "https://docs.google.com/presentation/d/1HfN6UasfmFXgEN1-Zw_xBYSlUEo5kX3fH8Ks-_I-Vwc/view", "draft": false}, {"id": "08-07-1", "module": 8, "deck": "Post Operative Diet", "page": 1, "text": "Post Operative Diet", "image": "/media/08-07-1.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-2", "module": 8, "deck": "Post Operative Diet", "page": 2, "text": "Diet priorities after surgery\n● High-calorie, high-protein foods to support\n healing and strength\n● Small, frequent meals if eating by mouth is\n difﬁcult\n● Feeding tube nutrition is often needed\n temporarily and helps keep you well-nourished\n● Sip ﬂuids often to prevent dehydration and\n help with swallowing", "image": "/media/08-07-2.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-3", "module": 8, "deck": "Post Operative Diet", "page": 3, "text": "Eggs and Egg Dishes\n\n\n ● High protein gelatin ● French toast\n ● Hard boiled eggs ● Quiche\n ● Custard ● Poached eggs\n ● Scrambled eggs ● Egg salad\n ● Deviled eggs ● Soufﬂé\n ● Omelet", "image": "/media/08-07-3.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-4", "module": 8, "deck": "Post Operative Diet", "page": 4, "text": "Meat Salads and Soft Meats\n\n\n ● Chicken salad ● Ground hamburger\n ● Seafood salad with gravy/cream sauce\n ● Ham salad ● Minced casserole\n ● Tuna salad ● Soufﬂé\n ● Roast beef salad ● Flaked ﬁsh with dill\n ● Turkey salad sauce\n ● Beef stew ● Chicken pot pie\n ● Meatloaf", "image": "/media/08-07-4.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-5", "module": 8, "deck": "Post Operative Diet", "page": 5, "text": "Soft Cheese Foods\n\n\n ● Cheese cake ● Cheese topping on\n ● Macaroni and baked or mashed\n cheese potato\n ● Cheese cubes ● Twice baked potato\n ● Cottage cheese ● Fondue\n ● Cheese sauce on\n vegetables", "image": "/media/08-07-5.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-6", "module": 8, "deck": "Post Operative Diet", "page": 6, "text": "Dairy Foods and Milk\n\n\n ● Double strength milk ● Malts\n ● Eggnog ● Frozen yogurt\n ● Ice cream ● Smoothies\n ● Mousse ● Hot cocoa made with\n ● Pudding pops milk\n ● Powdered milk mixed ● Milkshakes\n into casseroles ● Pudding\n ● Soy milk ● Yogurt", "image": "/media/08-07-6.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-7", "module": 8, "deck": "Post Operative Diet", "page": 7, "text": "Soups\n\n\n ● Bean soup ● New england clam\n ● Cream of celery chowder\n ● Cream of tomato ● Cream of broccoli\n ● Split pea soup ● Cream of mushroom\n ● Cream of asparagus ● Potato soup\n ● Cream of chicken", "image": "/media/08-07-7.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "08-07-8", "module": 8, "deck": "Post Operative Diet", "page": 8, "text": "Grains, Nuts, and Legumes\n\n\n\n ● Baked beans ● Pork and beans\n ● Hummus ● Tofu, soft or silken\n ● Peanut butter ● Oatmeal\n ● Almond butter ● Cream of wheat", "image": "/media/08-07-8.jpg", "url": "https://docs.google.com/presentation/d/14vaBAfk-OtkoKhUCgzYWeLw4Ge0s1wldLlMDZ9q6QsE/view", "draft": false}, {"id": "09-01-01", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 1, "text": "Introduction to Postoperative Radiation", "image": "/media/09-01-01.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-02", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 2, "text": "Sections in this Module\n\n General\n Postoperative Timing of\n Reasons for\n Radiation and Postoperative\n Postoperative\n Chemotherapy Radiation\n Radiation\n\n\n\n Click on the box to jump to each section", "image": "/media/09-01-02.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-03", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 3, "text": "General Reasons for\nPostoperative Radiation", "image": "/media/09-01-03.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-04", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 4, "text": "Why do I need radiation after\nsurgery?\nYou may need radiation after surgery based on\ncertain risk features found in your tumor.\nRadiation is used to reduce the risk of cancer\nreturning after surgery.\n\nWhen cancer comes back after treatment, it's\ncalled a recurrence. Radiation helps lower the\nchances of this happening.", "image": "/media/09-01-04.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-05", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 5, "text": "Common Reasons for\nPostoperative Radiation\n● Advanced stage primary tumor: If your\n tumor is classiﬁed as T3 or T4 (larger or\n more invasive tumors), radiation is typically\n recommended.\n● Perineural invasion: If cancer is found\n spreading along small nerves, this\n increases the risk of recurrence.\n● Lymphovascular invasion: Cancer cells\n found in small blood vessels or lymphatic\n vessels suggest a higher likelihood of\n spread.", "image": "/media/09-01-05.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-06", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 6, "text": "Common Reasons for\nPostoperative Radiation (cont.)\n● Close margins: If the tumor is close to the\n edge of the surgical specimen, there may\n be microscopic cancer left behind.\n● Lymph node involvement:\n ○ Multiple lymph nodes with cancer\n (pathologic N2 or N3 disease)\n ○ Large lymph nodes involved\n ○ Involvement of low or posterior neck\n lymph nodes (levels 4 or 5)", "image": "/media/09-01-06.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-07", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 7, "text": "Postoperative Radiation and\n Chemotherapy", "image": "/media/09-01-07.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-08", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 8, "text": "What is chemotherapy?\n\nChemotherapy is medicine that travels\nthrough your whole body to kill cancer cells.\nIt’s usually given by IV or as a pill, and it\nworks by targeting fast-growing cells like\ncancer.", "image": "/media/09-01-08.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-09", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 9, "text": "Why do I need both radiation\nand chemotherapy after surgery?\nIn some cases, chemotherapy is added to\nradiation therapy to improve treatment\noutcomes. This decision is based on certain\nhigh-risk features found during surgery.\n\nThis combination of treatments may increase\nside effects but can improve the chances of\ncure in high-risk patients.", "image": "/media/09-01-09.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-10", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 10, "text": "Common Reasons for\nPostoperative Radiation with\nChemotherapy\n● Positive surgical margins: If cancer cells are\n seen right at the edge of the removed tissue,\n this indicates that not all cancer may have\n been removed.\n● Extracapsular spread (ECS): If cancer has\n spread outside a lymph node into\n surrounding tissue, chemotherapy is typically\n recommended in addition to radiation.", "image": "/media/09-01-10.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-11", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 11, "text": "Timing of Postoperative\n Radiation", "image": "/media/09-01-11.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-12", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 12, "text": "When do I start receiving\npostoperative radiation therapy?\nRadiation is most effective when started\nsoon after surgery, once you have healed but\nbefore too much time passes.", "image": "/media/09-01-12.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-01-13", "module": 9, "deck": "Introduction to Postoperative Radiation", "page": 13, "text": "What is a typical timeline?\n\n● Start radiation within 6 weeks of\n surgery, ideally.\n● This allows enough time for surgical\n healing while ensuring radiation is still\n effective.\n● Delays beyond 8 weeks may reduce\n treatment success, so it's important to\n keep appointments and complete\n pre-radiation evaluations on time.", "image": "/media/09-01-13.jpg", "url": "https://docs.google.com/presentation/d/1pYRV5IXqIabU2HMcLXvD7WPOj6Om7-vh5Nzj7mLXUi0/view", "draft": false}, {"id": "09-02-01", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 1, "text": "Important Pre-Radiation Dental\nConsiderations", "image": "/media/09-02-01.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-02", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 2, "text": "Sections in this Module\n\n\n Maintaining Dental\n Visiting the Dentist\n Health\n\n\n\n Click on the box to jump to each section", "image": "/media/09-02-02.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-03", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 3, "text": "Visiting the Dentist", "image": "/media/09-02-03.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-04", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 4, "text": "Why do I need to see\nthe dentist?\nRadiation to the head and neck can\ndamage your salivary glands and\ncause xerostomia (dry mouth)\nwhich increases the risk of:\n ● Cavities and dental infections\n ● Osteoradionecrosis (jawbone\n damage)\n ● Other long-term dental\n complications", "image": "/media/09-02-04.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-05", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 5, "text": "What do I need to do?\n\n● Schedule a pre-radiation dental\n evaluation at least a few weeks\n before starting radiation.\n● Your dentist will check for and\n treat any dental issues\n beforehand.\n● You may need extractions, ﬁllings,\n or cleanings to reduce the risk of\n problems during or after\n treatment.", "image": "/media/09-02-05.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-06", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 6, "text": "Goals of Pre-Radiation\nOral/Dental Evaluation:\n● Patient education (both oral and\n written) about dental risks and\n preventive care\n● Complete head and neck dental\n exam, including x-rays\n● Identify and treat sources of\n infection before radiation", "image": "/media/09-02-06.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-07", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 7, "text": "Maintaining Dental Health", "image": "/media/09-02-07.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-08", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 8, "text": "Dry Mouth Management\n● Increase hydration\n● Avoid caffeine and alcohol\n● Use salivary stimulants (e.g.,\n xylitol gum/lozenges, sorbitol,\n pilocarpine, cevimeline)\n● Use alcohol-free mouthwash\n (e.g., 0.1% chlorine dioxide rinse)\n● Use salivary substitutes (e.g.,\n gels with lysozyme, lactoferrin,\n calcium phosphate)", "image": "/media/09-02-08.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-09", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 9, "text": "Dental Caries Prevention\n● Brush and ﬂoss daily\n● Use ﬂuoride treatments:\n ○ 1.1% NaF gel or dentifrice\n daily\n ○ Fluoride varnish 3x/year\n ○ Calcium phosphate\n rinses/gels\n● Frequent dental checkups", "image": "/media/09-02-09.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-10", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 10, "text": "Fungal Infection Prevention\n● Antifungal lozenges or rinses\n● Systemic antifungals if needed (consult infectious disease\n specialist)", "image": "/media/09-02-10.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-11", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 11, "text": "Extractions and Jaw Tightness\n● Determine if tooth extractions are needed before RT (at least 2\n weeks prior)\n● Coordinate any future extractions with your oncology team\n● Monitor and manage trismus (jaw tightness)", "image": "/media/09-02-11.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "09-02-12", "module": 9, "deck": "Pre-Radiation Dental Considerations", "page": 12, "text": "Post-Treatment Dental\nManagement\n● Continue managing dry mouth\n and trismus\n● Maintain strict oral hygiene and\n caries prevention\n● Prevent/manage\n osteoradionecrosis\n● Avoid implants or extractions\n without radiation oncologist\n consultation\n● Dental visits every 6 months or\n more frequently if xerostomia or\n new dental issues arise", "image": "/media/09-02-12.jpg", "url": "https://docs.google.com/presentation/d/166Yfl5_rnq9JvE_Zfnv5kFvolPF4iNj9FZRQTHSdNNg/view", "draft": false}, {"id": "10-01-01", "module": 10, "deck": "Long-Term Survivorship", "page": 1, "text": "Long-Term Survivorship", "image": "/media/10-01-01.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-02", "module": 10, "deck": "Long-Term Survivorship", "page": 2, "text": "Sections in this Module\n\n Health\n Promotion and Surveillance\n Wellness\n\n\n Physical and\n Screening for\n Psychosocial\n Secondary\n Effects of\n Cancers\n Treatment\n\n\n Click on the box to jump to each section", "image": "/media/10-01-02.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-03", "module": 10, "deck": "Long-Term Survivorship", "page": 3, "text": "Health Promotion and\n Wellness", "image": "/media/10-01-03.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-04", "module": 10, "deck": "Long-Term Survivorship", "page": 4, "text": "Recommendations for survivors\npost-treatment\n● Maintain a healthy weight and eat\n healthy, focusing on eating\n vegetables, fruits, and whole grains\n● Adopt a physically active lifestyle,\n including exercise and strength\n training as tolerated\n● We strongly recommend quitting\n tobacco and limiting alcohol intake\n● Visit the dentist at least once a year\n● Use at least SPF 30 sunscreen daily\n● Notify your doctor of any family\n history of cancer", "image": "/media/10-01-04.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-05", "module": 10, "deck": "Long-Term Survivorship", "page": 5, "text": "What action steps can be taken\ntowards wellness?\n● If food intake is an issue or if there\n are feeding tube issues, notify your\n doctor\n● Always consult your doctor before\n starting an exercise program\n● Tobacco cessation counseling is\n available if you need assistance\n● If you notice any oral cavity changes,\n notify your doctor", "image": "/media/10-01-05.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-06", "module": 10, "deck": "Long-Term Survivorship", "page": 6, "text": "Surveillance", "image": "/media/10-01-06.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-07", "module": 10, "deck": "Long-Term Survivorship", "page": 7, "text": "Patients should continue to be\nmindful of\n● Follow-up visits:\n ○ Year 1: every 1-3 months\n ○ Year 2: every 2-6 months\n ○ Years 3-5: every 4-8 months\n ○ Years 6+: every 12 months\n● Imaging: a CT scan, MRI, or PET may be\n ordered 3 months post-treatment\n● Thyroid function: Evaluate function every\n 6-12 months for 6 years post-treatment\n● Vaccinations: Stay up to date with your\n inﬂuenza, shingles, and pneumococcal\n vaccines", "image": "/media/10-01-07.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-08", "module": 10, "deck": "Long-Term Survivorship", "page": 8, "text": "Screening for Secondary\n Cancers", "image": "/media/10-01-08.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-09", "module": 10, "deck": "Long-Term Survivorship", "page": 9, "text": "How are second primary cancers\ndetected?\n● Head and neck cancer survivors are at\n increased risk for new head and neck,\n lung, and esophageal cancers\n● The risk of developing these can vary\n depending on treatment variations, age,\n and genetics\n● Your doctor may decide to screen for\n lung cancer with CT scans\n● All other cancers can be screened for as\n they normally are", "image": "/media/10-01-09.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-10", "module": 10, "deck": "Long-Term Survivorship", "page": 10, "text": "Physical and Psychosocial\n Effects of Treatment", "image": "/media/10-01-10.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}, {"id": "10-01-11", "module": 10, "deck": "Long-Term Survivorship", "page": 11, "text": "Types of patients and the effects they can experience\n Any head and neck Survivors who undergo Survivors who undergo Survivors who undergo\n cancer survivor surgery radiation therapy chemotherapy\n\n ● Sleep apnea ● Decreased neck, ● Dry mouth ● Neuropathy\n ● Body and arm, shoulder ● Cervical dystonia (numbness/tingling\n self-image mobility or ● Altered or loss of in feet, legs, hands)\n concerns discomfort taste ● Hearing loss\n ● Difficulty ● Pain ● Radiation dermatitis ● Kidney issues\n swallowing and ● Dental issues\n speaking\n ● Lymphedema\n ● Intimacy issues\n ● Depression and\n anxiety\n ● Weakness", "image": "/media/10-01-11.jpg", "url": "https://docs.google.com/presentation/d/14o_qaou2fmwfP1WiS2Gk8zz2HQ8EyJThqE8TET1cIxQ/view", "draft": false}]
